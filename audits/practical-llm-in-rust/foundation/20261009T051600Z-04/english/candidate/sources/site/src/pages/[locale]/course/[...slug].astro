---
import {
  getCollection,
  render,
  type CollectionEntry,
} from 'astro:content';

import ChapterNavigation from '../../../components/ChapterNavigation.astro';
import CheatSheet from '../../../components/CheatSheet.astro';
import RustSource from '../../../components/RustSource.astro';
import {
  getLocaleDefinition,
  getMessages,
  localePath,
  type Locale,
} from '../../../i18n';
import type { ChapterNavigationTarget } from '../../../lib/chapter-navigation';
import { buildCourseChapterPaths } from '../../../lib/course-page-paths';
import { firstCourse, type CourseConfiguration } from '../../../lib/course-configuration';
import { findPublishableChapterSets } from '../../../lib/functional-course-routes';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const chapterModules = import.meta.glob(
    '../../../content/chapters/**/*.{md,mdx}',
  );
  const chapters =
    Object.keys(chapterModules).length === 0 ? [] : await getCollection('chapters');
  const cheatSheetModules = import.meta.glob(
    '../../../content/cheat-sheets/**/*.json',
  );
  const cheatSheets =
    Object.keys(cheatSheetModules).length === 0
      ? []
      : await getCollection('cheatSheets');
  return buildCourseChapterPaths(chapters,cheatSheets,findPublishableChapterSets(chapters));
}

interface Props {
  entry: CollectionEntry<'chapters'> | CollectionEntry<'practicalChapters'>;
  previous: ChapterNavigationTarget | null;
  next: ChapterNavigationTarget | null;
  equivalentLocales: readonly Locale[];
  cheatSheet: CollectionEntry<'cheatSheets'> | CollectionEntry<'practicalCheatSheets'> | null;
  course?: CourseConfiguration;
}
const { entry, previous, next, equivalentLocales, cheatSheet, course = firstCourse } = Astro.props;
const { Content } = await render(entry);
const locale = entry.data.locale;
const copy = getMessages(locale);
const backArrow = getLocaleDefinition(locale).direction === 'rtl' ? '→' : '←';
const routeSuffix = '/' + course.route + '/' + entry.data.chapter_id + '/';
---

<BaseLayout
  locale={locale}
  routeSuffix={routeSuffix}
  equivalentLocales={equivalentLocales}
  fallbackRouteSuffix={course.id === firstCourse.id ? "/course/" : "/"}
  fallbackLabelKey={course.id === firstCourse.id ? "allChaptersLabel" : "homeLabel"}
  title={entry.data.title}
  description={entry.data.description}
>
  <article
    class="lesson shell-container"
    data-chapter-root
    data-chapter-id={entry.data.chapter_id}
  >
    <header class="lesson-header">
      <a class="lesson-back" href={localePath(locale, '/' + course.route + '/')}>
        {backArrow} {copy.allChaptersLabel}
      </a>
      <p class="eyebrow">
        {String(entry.data.order).padStart(2, '0')} · {copy.contentRevisionLabel} {entry.data.content_revision}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="lesson-description">{entry.data.description}</p>
      <aside class="lesson-objective">
        <strong>{copy.chapterObjectiveLabel}</strong>
        <p>{entry.data.objective}</p>
      </aside>
      {cheatSheet && <CheatSheet sheet={cheatSheet.data} />}
    </header>

    <div class="lesson-body">
      <Content components={{ RustSource }} />
    </div>

    <ChapterNavigation locale={locale} previous={previous} next={next} course={course} />
  </article>
</BaseLayout>

<style is:global>
  article[data-chapter-root][data-chapter-id].lesson {
    max-width: 52rem;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  article[data-chapter-root][data-chapter-id] .lesson-header {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  article[data-chapter-root][data-chapter-id] .lesson-back {
    display: inline-block;
    margin-bottom: 2.5rem;
    color: var(--accent-ink);
    font-weight: 750;
    text-underline-offset: 0.2rem;
  }

  article[data-chapter-root][data-chapter-id].lesson h1 {
    max-width: 15ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.6rem, 7vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  article[data-chapter-root][data-chapter-id] .lesson-description {
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 1.2rem;
  }

  article[data-chapter-root][data-chapter-id] .lesson-objective {
    margin-top: 2rem;
    padding: 1.1rem 1.25rem;
    border-inline-start: 0.25rem solid var(--accent);
    background: var(--accent-soft);
  }

  article[data-chapter-root][data-chapter-id] .lesson-objective p {
    margin: 0.35rem 0 0;
  }

  article[data-chapter-root][data-chapter-id] .lesson-body {
    padding-top: 2rem;
  }

  article[data-chapter-root][data-chapter-id] .lesson-body h2 {
    margin: 3.5rem 0 1rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
    line-height: 1.12;
  }

  article[data-chapter-root][data-chapter-id] .lesson-body h3 {
    margin-top: 2rem;
    font-size: 1.25rem;
  }

  article[data-chapter-root][data-chapter-id] .lesson-body p,
  article[data-chapter-root][data-chapter-id] .lesson-body li {
    max-width: 70ch;
  }

  article[data-chapter-root][data-chapter-id] .lesson-body blockquote {
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    border-inline-start: 0.2rem solid var(--warm);
    color: var(--muted);
  }

  article[data-chapter-root][data-chapter-id] .lesson-body :not(pre) > code {
    direction: ltr;
    padding: 0.12rem 0.3rem;
    border-radius: 0.3rem;
    background: var(--inline-code-surface);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
    unicode-bidi: isolate;
  }

  article[data-chapter-root][data-chapter-id] .lesson-body .katex,
  article[data-chapter-root][data-chapter-id] .lesson-body .katex-display {
    direction: ltr;
    unicode-bidi: isolate;
  }

  article[data-chapter-root][data-chapter-id] .lesson-body .katex .katex-mathml {
    position: absolute;
    display: block;
    inline-size: 1px;
    block-size: 1px;
    overflow: clip;
    contain: strict;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    font-size: 0;
    line-height: 0;
    white-space: nowrap;
  }

  article[data-chapter-root][data-chapter-id] .lesson-body .katex-display {
    box-sizing: border-box;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.5rem;
  }

  @media (max-width: 44rem) {
    article[data-chapter-root][data-chapter-id] .lesson-body :not(.katex-display) > .katex {
      display: inline-block;
      max-inline-size: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      vertical-align: middle;
    }

    article[data-chapter-root][data-chapter-id] .lesson-body :not(.katex-display) > .katex > .katex-html {
      display: inline-block;
      padding-block: 0.4em;
    }

    article[data-chapter-root][data-chapter-id] .lesson-body figure[data-visualization-id] [role='region']
      :not(.katex-display)
      > .katex {
      max-inline-size: none;
      overflow-x: visible;
      overflow-y: visible;
    }
  }

  article[data-chapter-root][data-chapter-id] .lesson-body > table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  article[data-chapter-root][data-chapter-id] .lesson-body > table th,
  article[data-chapter-root][data-chapter-id] .lesson-body > table td {
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--line);
    text-align: start;
  }

  html[dir="rtl"] article[data-chapter-root][data-chapter-id].lesson h1 {
    letter-spacing: normal;
  }
</style>
