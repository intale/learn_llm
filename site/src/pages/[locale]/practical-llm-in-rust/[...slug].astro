---
import { getCollection } from 'astro:content';
import CourseChapter from '../course/[...slug].astro';
import { practicalCourse } from '../../../lib/course-configuration';
import { buildCourseChapterPaths } from '../../../lib/course-page-paths';
import { findPublishablePracticalChapterSets } from '../../../lib/course-build';
import '../../../styles/practical-course.css';

export async function getStaticPaths() {
  const chapters=await getCollection('practicalChapters');
  const sheets=await getCollection('practicalCheatSheets');
  return buildCourseChapterPaths(chapters,sheets,findPublishablePracticalChapterSets(chapters),practicalCourse);
}
---

<CourseChapter {...Astro.props} chapterLabelByLocale={{ en: 'Chapter' }}
  cheatSheetTermIdPrefix={Astro.props.entry.data.chapter_id === '04-padded-variable-batches' ? 'padded-variable-term' : Astro.props.entry.data.chapter_id === '05-packed-sequence-masks' ? 'packed-sequence-term' : Astro.props.entry.data.chapter_id === '06-depth-stable-decoder' ? 'depth-stable-term' : Astro.props.entry.data.chapter_id === '07-configurable-decoder-core' ? 'configurable-decoder-term' : Astro.props.entry.data.chapter_id === '08-dropout-semantics' ? 'dropout-semantics-term' : Astro.props.entry.data.chapter_id === '09-dependency-error-contract' ? 'dependency-error-term' : Astro.props.entry.data.chapter_id === '10-input-encoding-boundary' ? 'input-encoding-term' : Astro.props.entry.data.chapter_id === '11-accelerated-tensor-execution' ? 'accelerated-tensor-term' : Astro.props.entry.data.chapter_id === '12-mixed-precision-training' ? 'mixed-precision-term' : Astro.props.entry.data.chapter_id === '13-gradient-accumulation-recomputation' ? 'training-memory-term' : Astro.props.entry.data.chapter_id === '14-optimizer-schedules-clipping' ? 'optimizer-schedule-term' : Astro.props.entry.data.chapter_id === '15-save-load-resume-model' ? 'model-persistence-term' : Astro.props.entry.data.chapter_id === '16-language-model-evaluation' ? 'language-model-evaluation-term' : Astro.props.entry.data.chapter_id === '17-weight-quantization' ? 'weight-quantization-term' : Astro.props.entry.data.chapter_id === '18-grouped-query-attention-context' ? 'grouped-query-attention-term' : Astro.props.entry.data.chapter_id === '19-online-tiled-attention' ? 'online-tiled-attention-term' : Astro.props.entry.data.chapter_id === '20-paged-kv-layout' ? 'paged-kv-layout-term' : undefined} />
