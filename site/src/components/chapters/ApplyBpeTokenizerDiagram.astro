---
// @ts-ignore Node filesystem access is used only while generating static HTML.
import { readFileSync } from 'node:fs';

import {
  applyBpeTokenizerDiagramId,
  assertApplyBpeTokenizerDiagramLabels,
  parseApplyBpeTokenizerTrace,
  type ApplyBpeTokenizerDiagramLabels,
} from '../../lib/apply-bpe-tokenizer-diagram';
import InlineMath from '../InlineMath.astro';

interface Props {
  labels: ApplyBpeTokenizerDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'apply-bpe-tokenizer-diagram' } = Astro.props as Props;
assertApplyBpeTokenizerDiagramLabels(labels);
const fixtureUrl = new URL(
  '../../../../rust/demos/ch04-apply-bpe-tokenizer/expected.txt',
  import.meta.url,
);
const trace = parseApplyBpeTokenizerTrace(readFileSync(fixtureUrl, 'utf8'));
const titleId = `${instanceId}-title`;
const descriptionId = `${instanceId}-description`;
const caseTitles = {
  'ascii-bee': labels.caseTitles.asciiBee,
  'cyrillic-a': labels.caseTitles.cyrillicA,
} as const;
---

<figure
  class="course-diagram apply-bpe-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={applyBpeTokenizerDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
    <dl class="layout-facts course-diagram__grid">
      <div data-diagram-card data-diagram-box>
        <dt>{labels.fields.layoutVersion}</dt>
        <dd><bdi dir="ltr">{trace.layout.version}</bdi></dd>
      </div>
      <div data-diagram-card data-diagram-box>
        <dt><bdi dir="ltr">BOS</bdi></dt>
        <dd><bdi dir="ltr">{trace.layout.bos}</bdi></dd>
      </div>
      <div data-diagram-card data-diagram-box>
        <dt><bdi dir="ltr">EOS</bdi></dt>
        <dd><bdi dir="ltr">{trace.layout.eos}</bdi></dd>
      </div>
      <div data-diagram-card data-diagram-box>
        <dt>{labels.fields.contentOffset}</dt>
        <dd><bdi dir="ltr">{trace.layout.contentOffset}</bdi></dd>
      </div>
    </dl>
  </figcaption>

  <ol class="example-list course-diagram__grid">
    {
      trace.cases.map((sample, sampleIndex) => {
        const caseId = `${instanceId}-${sample.id}`;
        return (
          <li>
            <section class="example" data-diagram-card data-diagram-box data-case={sample.id} aria-labelledby={`${caseId}-title`}>
              <header class="course-diagram__card-heading">
                <p class="step-number state-symbol" data-diagram-box aria-hidden="true">{sampleIndex + 1}</p>
                <div>
                  <h4 id={`${caseId}-title`}>{caseTitles[sample.id]}</h4>
                  <p class="input-text">
                    <span>{labels.lanes.input}</span>{' '}
                    <code dir="ltr">{JSON.stringify(sample.inputText)}</code>
                  </p>
                </div>
              </header>

              <ol class="pipeline course-diagram__grid">
                <li class="course-diagram__card-stack" data-diagram-card data-diagram-box data-lane="bytes">
                  <h5 id={`${caseId}-bytes-label`}>{labels.lanes.bytes}</h5>
                  <p
                    class="token-tape course-diagram__scroll"
                    role="region"
                    tabindex="0"
                    aria-labelledby={`${caseId}-bytes-label`}
                    dir="ltr"
                    data-diagram-box
                    data-diagram-scroll>
                    {sample.inputBytesHex.map((byte) => <code data-diagram-box data-byte={byte}>{byte}</code>)}
                  </p>
                </li>
                <li class="flow-arrow" aria-hidden="true">↓</li>
                <li class="course-diagram__card-stack" data-diagram-card data-diagram-box data-lane="initial">
                  <h5 id={`${caseId}-initial-label`}>{labels.lanes.initial}</h5>
                  <p
                    class="token-tape course-diagram__scroll"
                    role="region"
                    tabindex="0"
                    aria-labelledby={`${caseId}-initial-label`}
                    dir="ltr"
                    data-diagram-box
                    data-diagram-scroll>
                    {sample.initialTokens.map((token) => <code data-diagram-box data-token-id={token}>{token}</code>)}
                  </p>
                </li>
                <li class="flow-arrow" aria-hidden="true">↓</li>
                <li class="course-diagram__card-stack" data-diagram-card data-diagram-box data-lane="grouped">
                  <h5>{labels.lanes.grouped}</h5>
                  <p class="applied-ranks">
                    {labels.fields.appliedRank}:{' '}
                    <bdi dir="ltr">{sample.appliedRanks.join(', ')}</bdi>
                  </p>
                  <ol class="piece-list course-diagram__grid">
                    {sample.pieces.map((piece) => (
                      <li class="course-diagram__card-stack" data-diagram-card data-diagram-box data-piece-index={piece.index} data-merge-rank={piece.mergeRank ?? 'byte'}>
                        <dl>
                          <div>
                            <dt>{labels.fields.tokenId}</dt>
                            <dd><code dir="ltr" data-token-id={piece.token}>{piece.token}</code></dd>
                          </div>
                          <div>
                            <dt>{labels.fields.byteExpansion}</dt>
                            <dd><code dir="ltr">{piece.bytesHex.join(' ')}</code></dd>
                          </div>
                        </dl>
                        <p class="piece-kind">
                          <span aria-hidden="true">{piece.mergeRank === null ? '◇' : '◆'}</span>{' '}
                          {piece.mergeRank === null
                            ? labels.fields.byteFallback
                            : <>{labels.fields.appliedRank}{' '}<bdi dir="ltr">{piece.mergeRank}</bdi></>}
                        </p>
                      </li>
                    ))}
                  </ol>
                </li>
                <li class="flow-arrow" aria-hidden="true">↓</li>
                <li class="course-diagram__card-stack" data-diagram-card data-diagram-box data-lane="document">
                  <h5 id={`${caseId}-document-label`}>{labels.lanes.document}</h5>
                  <p
                    class="token-tape document-tape course-diagram__scroll"
                    role="region"
                    tabindex="0"
                    aria-labelledby={`${caseId}-document-label`}
                    dir="ltr"
                    data-diagram-box
                    data-diagram-scroll>
                    {sample.documentTokens.map((token, index) => {
                      const isBos = index === 0;
                      const isEos = index === sample.documentTokens.length - 1;
                      return (
                        <code
                          data-diagram-box
                          data-token-id={token}
                          data-control={isBos ? 'bos' : isEos ? 'eos' : undefined}
                        >
                          {isBos ? `BOS:${token}` : isEos ? `EOS:${token}` : token}
                        </code>
                      );
                    })}
                  </p>
                  <p class="control-key">
                    <span><bdi dir="ltr">BOS</bdi> — {labels.fields.bos}</span>
                    <span><bdi dir="ltr">EOS</bdi> — {labels.fields.eos}</span>
                  </p>
                </li>
                <li class="flow-arrow reverse" aria-hidden="true">↓</li>
                <li class="course-diagram__card-stack" data-diagram-card data-diagram-box data-lane="decoded">
                  <h5 id={`${caseId}-decoded-label`}>{labels.lanes.decoded}</h5>
                  <p
                    class="token-tape course-diagram__scroll"
                    role="region"
                    tabindex="0"
                    aria-labelledby={`${caseId}-decoded-label`}
                    dir="ltr"
                    data-diagram-box
                    data-diagram-scroll>
                    {sample.decodedBytesHex.map((byte) => <code data-diagram-box data-byte={byte}>{byte}</code>)}
                  </p>
                  <p class="exact-cue" data-diagram-card data-diagram-box data-status="pass" data-round-trip="exact">
                    <span aria-hidden="true">✓</span> {labels.values.exactMatch}
                  </p>
                </li>
              </ol>
            </section>
          </li>
        );
      })
    }
  </ol>

  <section class="invariants" aria-labelledby={`${instanceId}-invariants`}>
    <h4 id={`${instanceId}-invariants`}>{labels.invariantsLabel}</h4>
    <ul class="course-diagram__grid">
      <li data-diagram-card data-diagram-box><span aria-hidden="true">1→</span> {labels.invariants.ranks}</li>
      <li data-diagram-card data-diagram-box><InlineMath latex="+2" /> {labels.invariants.offset}</li>
      <li data-diagram-card data-diagram-box><span aria-hidden="true">║</span> {labels.invariants.controls}</li>
      <li data-diagram-card data-diagram-box><span aria-hidden="true">✓</span> {labels.invariants.bytes}</li>
    </ul>
  </section>
</figure>

<style>
  .layout-facts {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
  }

  .layout-facts > div {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .example-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-block-start: 1.5rem;
  }

  .example {
    block-size: 100%;
  }

  .example > header {
    align-items: flex-start;
  }

  .step-number {
    margin: 0;
  }

  .input-text {
    margin-block: 0.35rem 0;
  }

  .pipeline {
    gap: 0.45rem;
    margin-block-start: 1rem;
  }

  .pipeline > li[data-lane] {
    border-inline-start-color: var(--diagram-accent-dark);
    border-inline-start-width: 0.3rem;
  }

  .flow-arrow {
    padding-inline-start: 1rem;
    font-size: 1.35rem;
    font-weight: 900;
  }

  .token-tape {
    display: flex;
    gap: 0.4rem;
    margin-block: 0.5rem 0;
    padding: 0.35rem;
    border: 1px dashed var(--diagram-line-strong);
  }

  .token-tape code {
    flex: 0 0 auto;
    padding: 0.2rem 0.4rem;
    border: 1px solid currentColor;
    border-radius: 0.35rem;
  }

  .document-tape code[data-control] {
    border-width: 2px;
    border-style: double;
    font-weight: 800;
  }

  .applied-ranks,
  .piece-kind,
  .control-key,
  .exact-cue {
    margin-block: 0.45rem 0;
  }

  .piece-list {
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.6rem;
    margin-block-start: 0.65rem;
  }

  .piece-list dl {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }

  .piece-list dl > div {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    justify-content: space-between;
  }

  .control-key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .exact-cue {
    margin-block-start: 0.45rem;
  }

  .invariants ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-block-start: 0.75rem;
  }

  .invariants li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .invariants li > span {
    flex: 0 0 auto;
    min-inline-size: 2rem;
    font-weight: 900;
  }

  @container course-diagram (max-width: 48rem) {
    .example-list,
    .invariants ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (forced-colors: active) {
    .token-tape,
    .token-tape code {
      border-color: CanvasText;
      forced-color-adjust: auto;
    }
  }
</style>
