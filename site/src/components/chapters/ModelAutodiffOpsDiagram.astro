---
// @ts-ignore Node filesystem access is build-time only.
import { readFileSync } from 'node:fs';

import InlineMath from '../InlineMath.astro';
import {
  assertModelAutodiffOpsDiagramLabels,
  modelAutodiffOpsDiagramId,
  parseModelAutodiffOpsTrace,
  type ModelAutodiffOpsDiagramLabels,
  type ModelOperation,
  type ModelPullbackEvidence,
  type TraceNumber,
  type TraceShape,
} from '../../lib/model-autodiff-ops-diagram';

interface Props {
  labels: ModelAutodiffOpsDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'default' } = Astro.props;
assertModelAutodiffOpsDiagramLabels(labels);
if (!/^[a-z][a-z0-9-]*$/.test(instanceId)) {
  throw new Error('Model-autodiff diagram instanceId must be a kebab-case identifier.');
}

const fixtureUrl = new URL(
  '../../../../rust/demos/ch16-model-autodiff-ops/diagram-trace.txt',
  import.meta.url,
);
const trace = parseModelAutodiffOpsTrace(readFileSync(fixtureUrl, 'utf8'));
const titleId = `${modelAutodiffOpsDiagramId}-${instanceId}-title`;
const descriptionId = `${modelAutodiffOpsDiagramId}-${instanceId}-description`;

const numberList = (values: readonly TraceNumber[]) =>
  values.map(({ lexeme }) => lexeme).join(', ');
const dataNumbers = (values: readonly TraceNumber[]) =>
  values.map(({ lexeme }) => lexeme).join(',');
const valuesText = (values: readonly TraceNumber[]) => `[${numberList(values)}]`;
const shapeLatex = (shape: TraceShape) =>
  shape.lexeme === 'scalar' ? '[]' : `[${shape.lexeme.replaceAll('x', ',')}]`;
const operationLabel = (operation: ModelOperation) => labels.operations[operation];
const operandLabel = (operand: ModelPullbackEvidence['operand']) =>
  operand === null ? labels.operands.unary : labels.operands[operand];
const parentLabel = (parent: ModelPullbackEvidence['parent']) => labels.parents[parent];
---

<figure
  class="course-diagram model-autodiff-ops-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={modelAutodiffOpsDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
  </figcaption>

  <dl class="summary-grid">
    <div data-diagram-box>
      <dt>{labels.summary.ids}</dt>
      <dd><code dir="ltr">[{numberList(trace.fixture.ids)}]</code></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.targets}</dt>
      <dd><code dir="ltr">[{numberList(trace.fixture.targets)}]</code></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.loss}</dt>
      <dd><bdi dir="ltr">{trace.fixture.loss.lexeme}</bdi></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.repeatedToken}</dt>
      <dd><InlineMath latex={`i=${trace.fixture.repeatedId.lexeme},\\;n=${trace.fixture.occurrences.lexeme}`} /></dd>
    </div>
  </dl>

  <section data-diagram-box class="diagram-section forward-section" aria-labelledby={`${titleId}-forward`}>
    <h4 id={`${titleId}-forward`}>{labels.sections.forward}</h4>
    <p class="forward-fork-note">{labels.rules.forwardFork}</p>
    <ol class="forward-rail course-diagram__grid">
      {trace.forward.map((step) => (
        <li
          data-diagram-card
          data-diagram-box
          class={`forward-card operation-${step.operation} course-diagram__card-stack`}
          data-forward-step={step.step.lexeme}
          data-operation={step.operation}
          data-sources={step.sources.join(',')}
          data-input-shapes={step.inputShapes.map(({ lexeme }) => lexeme).join(',')}
          data-output-shape={step.outputShape.lexeme}
          data-values={dataNumbers(step.values)}
        >
          <p class="card-state course-diagram__card-heading">
            <span class="state-symbol" aria-hidden="true">{labels.symbols.forward}</span>
            <strong>{operationLabel(step.operation)}</strong>
          </p>
          <dl>
            <div><dt>{labels.fields.step}</dt><dd><bdi dir="ltr">{step.step.lexeme}</bdi></dd></div>
            <div><dt>{labels.fields.sources}</dt><dd>{step.sources.map((source) => labels.sources[source]).join(' + ')}</dd></div>
            <div>
              <dt>{labels.fields.tensorInputShape}</dt>
              <dd class="shape-list">
                {step.inputShapes.map((shape, index) => (
                  <span><InlineMath latex={shapeLatex(shape)} />{index + 1 < step.inputShapes.length && <span aria-hidden="true"> · </span>}</span>
                ))}
              </dd>
            </div>
            <div><dt>{labels.fields.outputShape}</dt><dd><InlineMath latex={shapeLatex(step.outputShape)} /></dd></div>
            <div><dt>{labels.fields.values}</dt><dd><code dir="ltr">{valuesText(step.values)}</code></dd></div>
          </dl>
        </li>
      ))}
    </ol>
  </section>

  <section data-diagram-box class="diagram-section reverse-section" aria-labelledby={`${titleId}-reverse`}>
    <h4 id={`${titleId}-reverse`}>{labels.sections.reverse}</h4>
    <p>{labels.rules.target}</p>
    <div class="target-scroll course-diagram__scroll" role="region" tabindex="0" aria-labelledby={`${titleId}-target-table`} data-diagram-scroll>
      <table data-diagram-table class="target-table">
        <caption id={`${titleId}-target-table`}>{labels.tables.targetGradients}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.position}</th>
            <th scope="col">{labels.fields.tokenId}</th>
            <th scope="col">{labels.fields.target}</th>
            <th scope="col">{labels.fields.gradient}</th>
            <th scope="col">{labels.fields.targetSign}</th>
            <th scope="col">{labels.fields.competitorSign}</th>
            <th scope="col">{labels.fields.classSum}</th>
          </tr>
        </thead>
        <tbody>
          {trace.targets.map((target) => (
            <tr
              data-target-position={target.position.lexeme}
              data-token-id={target.tokenId.lexeme}
              data-target-class={target.target.lexeme}
              data-target-gradient={dataNumbers(target.gradient)}
              data-correct-sign={target.correctSign}
              data-competitor-sign={target.competitorSign}
              data-row-sum={target.rowSum.lexeme}
            >
              <th scope="row"><bdi dir="ltr">{target.position.lexeme}</bdi></th>
              <td><bdi dir="ltr">{target.tokenId.lexeme}</bdi></td>
              <td><bdi dir="ltr">{target.target.lexeme}</bdi></td>
              <td><code dir="ltr">{valuesText(target.gradient)}</code></td>
              <td><span class="sign-cue" aria-hidden="true">−</span> {labels.states[target.correctSign]} — {labels.states.selectedTarget}</td>
              <td><span class="sign-cue" aria-hidden="true">+</span> {labels.states[target.competitorSign]}</td>
              <td><bdi dir="ltr">{target.rowSum.lexeme}</bdi></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>{labels.rules.matmul}</p>
    <div class="pullback-grid course-diagram__grid">
      {trace.pullbacks.map((pullback) => (
        <article
          data-diagram-card
          data-diagram-box
          class="pullback-card course-diagram__card-stack"
          data-pullback-operation={pullback.operation}
          data-parent={pullback.parent}
          data-operand={pullback.operand ?? 'unary'}
          data-shape={pullback.shape.lexeme}
          data-gradient={dataNumbers(pullback.gradient)}
        >
          <p class="card-state course-diagram__card-heading">
            <span class="state-symbol" aria-hidden="true">{labels.symbols.reverse}</span>
            <strong>{operationLabel(pullback.operation)}</strong>
          </p>
          <dl>
            <div><dt>{labels.fields.operand}</dt><dd>{operandLabel(pullback.operand)}</dd></div>
            <div><dt>{labels.fields.parent}</dt><dd>{parentLabel(pullback.parent)}</dd></div>
            <div><dt>{labels.fields.gradientShape}</dt><dd><InlineMath latex={shapeLatex(pullback.shape)} /></dd></div>
            <div><dt>{labels.fields.gradient}</dt><dd><code dir="ltr">{valuesText(pullback.gradient)}</code></dd></div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section data-diagram-box class="diagram-section accumulation-section" aria-labelledby={`${titleId}-accumulation`}>
    <h4 id={`${titleId}-accumulation`}>{labels.sections.accumulation}</h4>
    <p>{labels.rules.scatter}</p>
    <div class="embedding-grid course-diagram__grid">
      {trace.embeddings.map((embedding) => {
        const rowOccurrences = trace.occurrences.filter(
          (occurrence) => occurrence.destinationRow.lexeme === embedding.row.lexeme,
        );
        const state = embedding.occurrences.value === 0
          ? labels.states.unusedRow
          : embedding.occurrences.value === 1
            ? labels.states.singleRow
            : labels.states.accumulatedRow;
        const symbol = embedding.occurrences.value === 0
          ? labels.symbols.unused
          : embedding.occurrences.value === 1
            ? labels.symbols.single
            : labels.symbols.repeated;
        const stateClass = embedding.occurrences.value === 0
          ? 'embedding-unused'
          : embedding.occurrences.value === 1
            ? 'embedding-single'
            : 'embedding-accumulated';
        return (
          <article
            data-diagram-card
            data-diagram-box
            class={`embedding-card ${stateClass} course-diagram__card-stack`}
            data-embedding-row={embedding.row.lexeme}
            data-positions={embedding.positions === 'none' ? 'none' : dataNumbers(embedding.positions)}
            data-occurrences={embedding.occurrences.lexeme}
            data-gradient={dataNumbers(embedding.gradient)}
          >
            <p class="card-state course-diagram__card-heading">
              <span class="state-symbol" aria-hidden="true">{symbol}</span>
              <strong>{state}</strong>
            </p>
            <dl>
              <div><dt>{labels.fields.destinationRow}</dt><dd><bdi dir="ltr">{embedding.row.lexeme}</bdi></dd></div>
              <div>
                <dt>{labels.fields.positions}</dt>
                <dd>{embedding.positions === 'none' ? labels.states.unusedRow : <code dir="ltr">{numberList(embedding.positions)}</code>}</dd>
              </div>
              <div><dt>{labels.fields.occurrences}</dt><dd><bdi dir="ltr">{embedding.occurrences.lexeme}</bdi></dd></div>
              <div><dt>{labels.fields.gradient}</dt><dd><code dir="ltr">{valuesText(embedding.gradient)}</code></dd></div>
            </dl>
            {rowOccurrences.length > 0 && (
              <ol class="contribution-list course-diagram__grid">
                {rowOccurrences.map((occurrence) => (
                  <li
                    data-diagram-card
                    data-diagram-box
                    class={`occurrence-card occurrence-${occurrence.repeated} course-diagram__card-stack`}
                    data-occurrence-position={occurrence.position.lexeme}
                    data-token-id={occurrence.tokenId.lexeme}
                    data-destination-row={occurrence.destinationRow.lexeme}
                    data-contribution={dataNumbers(occurrence.contribution)}
                    data-repeated={occurrence.repeated}
                  >
                    <p class="card-state course-diagram__card-heading">
                      <span class="state-symbol" aria-hidden="true">
                        {occurrence.repeated === 'yes' ? labels.symbols.repeated : labels.symbols.single}
                      </span>
                      <strong>{occurrence.repeated === 'yes' ? labels.states.repeatedOccurrence : labels.states.singleOccurrence}</strong>
                    </p>
                    <dl>
                      <div><dt>{labels.fields.position}</dt><dd><bdi dir="ltr">{occurrence.position.lexeme}</bdi></dd></div>
                      <div><dt>{labels.fields.contribution}</dt><dd><code dir="ltr">{valuesText(occurrence.contribution)}</code></dd></div>
                    </dl>
                  </li>
                ))}
              </ol>
            )}
          </article>
        );
      })}
    </div>
  </section>
</figure>

<style>
  .model-autodiff-ops-diagram {
    --diagram-summary-min: 11rem;
  }

  .forward-rail {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  .pullback-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .embedding-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .forward-card dl,
  .pullback-card dl,
  .embedding-card > dl,
  .occurrence-card dl {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .shape-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }

  .target-scroll {
    --diagram-scroll-inline-size: 100%;
  }

  .target-table {
    inline-size: 100%;
    min-inline-size: 58rem;
  }

  .contribution-list {
    margin-block-start: 0.35rem;
  }

  .occurrence-yes,
  .embedding-accumulated {
    border-style: double;
  }

  .occurrence-no,
  .pullback-card,
  .embedding-single {
    border-style: dashed;
  }

  .embedding-unused {
    border-style: dotted;
  }

  .sign-cue {
    font-weight: 900;
  }

  .model-autodiff-ops-diagram:dir(rtl)
    :is(.forward-card, .pullback-card, .embedding-single, .occurrence-no)
    > .card-state
    .state-symbol {
    transform: scaleX(-1);
  }

  @container course-diagram (max-width: 64rem) {
    .embedding-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container course-diagram (max-width: 44rem) {
    .embedding-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 64rem) {
    figure.model-autodiff-ops-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      align-items: start;
    }

    .model-autodiff-ops-diagram:fullscreen > .summary-grid,
    .model-autodiff-ops-diagram:fullscreen .forward-rail,
    .model-autodiff-ops-diagram:fullscreen .pullback-grid,
    .model-autodiff-ops-diagram:fullscreen .embedding-grid,
    .model-autodiff-ops-diagram:fullscreen .contribution-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .model-autodiff-ops-diagram:fullscreen :is(.target-scroll, .target-table) {
      inline-size: 100%;
      max-inline-size: none;
    }

    .model-autodiff-ops-diagram:fullscreen .target-table {
      table-layout: fixed;
    }

    .model-autodiff-ops-diagram:fullscreen .target-table :is(th, td):nth-child(1) {
      inline-size: 11%;
    }

    .model-autodiff-ops-diagram:fullscreen .target-table :is(th, td):nth-child(2) {
      inline-size: 8%;
    }

    .model-autodiff-ops-diagram:fullscreen .target-table :is(th, td):nth-child(3) {
      inline-size: 10%;
    }

    .model-autodiff-ops-diagram:fullscreen .target-table :is(th, td):nth-child(4) {
      inline-size: 23%;
    }

    .model-autodiff-ops-diagram:fullscreen .target-table :is(th, td):nth-child(5) {
      inline-size: 18%;
    }

    .model-autodiff-ops-diagram:fullscreen .target-table :is(th, td):nth-child(6),
    .model-autodiff-ops-diagram:fullscreen .target-table :is(th, td):nth-child(7) {
      inline-size: 15%;
    }
  }
</style>
