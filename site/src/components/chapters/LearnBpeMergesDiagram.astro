---
// @ts-ignore Node filesystem access is used only while generating static HTML.
import { readFileSync } from 'node:fs';

import {
  assertLearnBpeMergesDiagramLabels,
  learnBpeMergesDiagramId,
  parseLearnBpeMergesTrace,
  type LearnBpeMergesDiagramLabels,
} from '../../lib/learn-bpe-merges-diagram';

interface Props {
  labels: LearnBpeMergesDiagramLabels;
}

const { labels } = Astro.props as Props;
assertLearnBpeMergesDiagramLabels(labels);
const fixtureUrl = new URL(
  '../../../../rust/demos/ch03-learn-bpe-merges/expected.txt',
  import.meta.url,
);
const trace = parseLearnBpeMergesTrace(readFileSync(fixtureUrl, 'utf8'));
const instance = 'learn-bpe-merges-diagram';
const titleId = `${instance}-title`;
const descriptionId = `${instance}-description`;
---

<figure
  class="course-diagram bpe-merge-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={learnBpeMergesDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
    <p class="bpe-training-source">
      <span aria-hidden="true">◆</span>
      {labels.trainingSource}
    </p>
  </figcaption>

  <h4 class="visually-hidden">{labels.stagesLabel}</h4>
  <ol class="bpe-timeline">
    {
      trace.stages.map((stage, stageIndex) => {
        const round = trace.rounds[stageIndex];
        return (
          <li class="bpe-timeline-step" data-stage={stage.index}>
            <section
              class="bpe-stage"
              data-diagram-card
              data-diagram-box
              aria-labelledby={`${instance}-stage-${stage.index}`}
            >
              <h5 id={`${instance}-stage-${stage.index}`}>
                {labels.fields.stage}{' '}
                <bdi class="numeric" dir="ltr">{stage.index}</bdi>
              </h5>
              <ol class="bpe-documents">
                {stage.documents.map((document, documentIndex) => (
                  <li data-document={document.id}>
                    {documentIndex > 0 && (
                      <p class="bpe-boundary" aria-label={labels.documentBoundary}>
                        <span aria-hidden="true">║</span> {labels.documentBoundary}
                      </p>
                    )}
                    <dl>
                      <div>
                        <dt>{labels.fields.document}</dt>
                        <dd><code dir="ltr">{document.id}</code></dd>
                      </div>
                      <div>
                        <dt id={`${instance}-stage-${stage.index}-document-${documentIndex}-tokens`}>
                          {labels.fields.tokens}
                        </dt>
                        <dd
                          class="token-tape course-diagram__scroll"
                          role="region"
                          tabindex="0"
                          aria-labelledby={`${instance}-stage-${stage.index}-document-${documentIndex}-tokens`}
                          dir="ltr"
                         data-diagram-scroll>
                           {document.tokens.map((token) => (
                             <code class="state-symbol" data-diagram-box data-token-id={token}>{token}</code>
                          ))}
                        </dd>
                      </div>
                    </dl>
                  </li>
                ))}
              </ol>
            </section>

            {round && (
              <section
                class="bpe-round"
                data-diagram-card
                data-diagram-box
                data-round={round.rank}
                aria-labelledby={`${instance}-round-${round.rank}`}
              >
                <h5 id={`${instance}-round-${round.rank}`}>
                  {labels.fields.rank}{' '}
                  <bdi class="numeric" dir="ltr">{round.rank}</bdi>
                </h5>
                <p class="visually-hidden">{labels.roundsLabel}</p>
                <div
                  class="candidate-scroll course-diagram__scroll"
                  role="region"
                  tabindex="0"
                  aria-label={labels.fields.candidates}
                 data-diagram-scroll>
                  <table data-diagram-table>
                    <caption>{labels.fields.candidates}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{labels.fields.pair}</th>
                        <th scope="col">{labels.fields.count}</th>
                        <th scope="col">{labels.fields.selected}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {round.candidates.map((candidate) => (
                        <tr data-diagram-box data-winner={candidate.winner ? 'true' : 'false'}>
                          <th scope="row" dir="ltr">
                            <code>({candidate.left},{candidate.right})</code>
                          </th>
                          <td class="numeric" dir="ltr">{candidate.count}</td>
                          <td>
                            <span class="winner-cue" aria-hidden="true">
                              {candidate.winner ? '★' : '—'}
                            </span>{' '}
                            {candidate.winner
                              ? labels.values.winner
                              : labels.values.notWinner}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <dl class="merge-facts">
                  <div data-diagram-card data-diagram-box>
                    <dt>{labels.fields.newToken}</dt>
                    <dd class="numeric" dir="ltr">{round.merge.token}</dd>
                  </div>
                  <div data-diagram-card data-diagram-box>
                    <dt>{labels.fields.bytesHex}</dt>
                    <dd><code dir="ltr">{round.merge.bytesHex.join(' ')}</code></dd>
                  </div>
                  <div data-diagram-card data-diagram-box>
                    <dt>{labels.fields.count}</dt>
                    <dd class="numeric" dir="ltr">{round.merge.count}</dd>
                  </div>
                  <div data-diagram-card data-diagram-box>
                    <dt>{labels.fields.replacements}</dt>
                    <dd class="numeric" dir="ltr">{round.merge.replacements}</dd>
                  </div>
                </dl>
              </section>
            )}
          </li>
        );
      })
    }
  </ol>

  <section
    class="bpe-invariants"
    data-diagram-box
    aria-labelledby={`${instance}-invariants`}
  >
    <h4 id={`${instance}-invariants`}>{labels.invariantsLabel}</h4>
    <ul>
      <li><span aria-hidden="true">✓</span> {labels.invariants.overlap}</li>
      <li><span aria-hidden="true">✓</span> {labels.invariants.replacement}</li>
      <li><span aria-hidden="true">✓</span> {labels.invariants.tie}</li>
      <li><span aria-hidden="true">✓</span> {labels.invariants.barrier}</li>
    </ul>
  </section>
</figure>

<style>
  .bpe-stage h5,
  .bpe-round h5,
  .bpe-invariants h4 {
    margin: 0;
  }

  .bpe-training-source {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  .bpe-timeline,
  .bpe-documents,
  .bpe-invariants ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bpe-timeline {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .bpe-timeline-step {
    display: grid;
    inline-size: 100%;
    max-inline-size: none;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.9fr);
    gap: 1rem;
    align-items: start;
  }

  .bpe-timeline-step:last-child {
    grid-template-columns: minmax(0, 1fr);
  }

  .bpe-documents {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .bpe-documents > li {
    position: relative;
    min-width: 0;
  }

  .bpe-boundary {
    margin: 0 0 0.75rem;
    padding-block: 0.3rem;
    border-block: 1px dashed currentColor;
    text-align: center;
  }

  dl,
  dd {
    margin: 0;
  }

  .bpe-documents dl,
  .merge-facts {
    display: grid;
    gap: 0.65rem;
  }

  .bpe-documents dl > div,
  .merge-facts > div {
    display: grid;
    grid-template-columns: minmax(7rem, auto) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
  }

  .token-tape {
    display: flex;
    gap: 0.35rem;
    min-width: 0;
    unicode-bidi: isolate;
  }

  .token-tape .state-symbol {
    flex: 0 0 auto;
  }

  .candidate-scroll {
    max-width: 100%;
    margin-top: 0.75rem;
  }

  table {
    width: 100%;
  }

  .bpe-merge-diagram .candidate-scroll tbody th {
    white-space: nowrap;
  }

  caption {
    padding-bottom: 0.5rem;
    font-weight: 750;
    text-align: start;
  }

  tr[data-winner='true'] {
    border: 0.18rem double currentColor;
    font-weight: 750;
  }

  .winner-cue {
    display: inline-block;
    min-width: 1em;
  }

  .merge-facts {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 0.85rem;
  }

  .merge-facts > div {
    grid-template-columns: 1fr;
    gap: 0.15rem;
  }

  .bpe-invariants {
    margin-top: 1.25rem;
  }

  .bpe-invariants ul {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.75rem;
  }

  .bpe-invariants li {
    display: flex;
    gap: 0.5rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @container course-diagram (max-width: 48rem) {
    .bpe-timeline-step {
      grid-template-columns: minmax(0, 1fr);
    }

    .merge-facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .bpe-documents dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }

</style>
