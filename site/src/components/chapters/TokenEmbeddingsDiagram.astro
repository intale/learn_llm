---
// @ts-ignore Node filesystem access is build-time only.
import { readFileSync } from 'node:fs';

import InlineMath from '../InlineMath.astro';

import {
  parseTokenEmbeddingsTrace,
  tokenEmbeddingsDiagramId,
  validateTokenEmbeddingsLabels,
  type GradientRule,
  type LookupSharing,
  type TableRowState,
  type TokenEmbeddingsDiagramLabels,
} from '../../lib/token-embeddings-diagram';

interface Props {
  labels: TokenEmbeddingsDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'default' } = Astro.props;
validateTokenEmbeddingsLabels(labels);
if (!/^[a-z][a-z0-9-]*$/.test(instanceId)) {
  throw new Error('Token-embeddings diagram instanceId must be a kebab-case identifier.');
}

const fixtureUrl = new URL(
  '../../../../rust/demos/ch18-token-embeddings/diagram-trace.txt',
  import.meta.url,
);
const trace = parseTokenEmbeddingsTrace(readFileSync(fixtureUrl, 'utf8'));
const titleId = `${tokenEmbeddingsDiagramId}-${instanceId}-title`;
const descriptionId = `${tokenEmbeddingsDiagramId}-${instanceId}-description`;

const tableStateLabel = (state: TableRowState) =>
  ({
    unused: labels.states.unused,
    'selected-once': labels.states.selectedOnce,
    'selected-repeated': labels.states.selectedRepeated,
  })[state];
const tableStateSymbol = (state: TableRowState) =>
  ({
    unused: labels.symbols.unused,
    'selected-once': labels.symbols.selectedOnce,
    'selected-repeated': labels.symbols.selectedRepeated,
  })[state];
const sharingLabel = (sharing: LookupSharing) =>
  sharing === 'repeated-row' ? labels.states.repeatedRow : labels.states.singleRow;
const ruleLabel = (rule: GradientRule) =>
  ({
    'unused-zero': labels.states.unusedZero,
    'single-copy': labels.states.singleCopy,
    'repeated-sum': labels.states.repeatedSum,
  })[rule];
const latexVector = (values: ReadonlyArray<{ lexeme: string }>) =>
  String.raw`\left[${values.map((value) => value.lexeme).join(',')}\right]`;
const latexShape = (shape: string) => String.raw`\left[${shape.replaceAll('x', ',')}\right]`;
const latexCoordinate = (values: ReadonlyArray<{ lexeme: string }>) =>
  String.raw`\left(${values.map((value) => value.lexeme).join(',')}\right)`;
const latexPositions = (values: ReadonlyArray<{ lexeme: string }>) =>
  values.map((value) => value.lexeme).join(',');
---

<figure
  class="course-diagram token-embeddings-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={tokenEmbeddingsDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description course-diagram__description">{labels.description}</p>
  </figcaption>

  <dl class="shape-summary">
    <div data-diagram-box>
      <dt>{labels.summary.parameter}</dt>
      <dd><bdi dir="ltr">{trace.fixture.parameter}</bdi></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.vocabulary}</dt>
      <dd><InlineMath latex={trace.fixture.vocabulary.lexeme} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.width}</dt>
      <dd><InlineMath latex={trace.fixture.width.lexeme} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.tableShape}</dt>
      <dd><InlineMath latex={latexShape(trace.fixture.tableShape)} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.idShape}</dt>
      <dd><InlineMath latex={latexShape(trace.fixture.idShape)} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.outputShape}</dt>
      <dd><InlineMath latex={latexShape(trace.fixture.outputShape)} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.gradientShape}</dt>
      <dd><InlineMath latex={latexShape(trace.fixture.gradientShape)} /></dd>
    </div>
  </dl>

  <div class="stage-grid course-diagram__grid">
    <section class="diagram-stage ids-stage course-diagram__card-stack" data-diagram-card data-diagram-box aria-labelledby={`${titleId}-ids`}>
      <h4 id={`${titleId}-ids`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">1</span> {labels.stages.ids}</h4>
      <p>{labels.notes.selectors}</p>
      <div class="table-scroll course-diagram__scroll" role="region" tabindex="0" aria-label={labels.scrollers.ids} data-diagram-scroll>
        <table data-diagram-table>
          <thead>
            <tr>
              <th scope="col">{labels.fields.position}</th>
              <th scope="col">{labels.fields.tokenId}</th>
              <th scope="col">{labels.fields.state}</th>
            </tr>
          </thead>
          <tbody>
            {trace.lookups.map((lookup) => (
              <tr class:list={{ 'repeated-row': lookup.sharing === 'repeated-row' }}>
                <th scope="row"><InlineMath latex={latexCoordinate(lookup.coordinate)} /></th>
                <td><InlineMath latex={lookup.id.lexeme} /></td>
                <td>{sharingLabel(lookup.sharing)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="diagram-stage table-stage course-diagram__card-stack" data-diagram-card data-diagram-box aria-labelledby={`${titleId}-table`}>
      <h4 id={`${titleId}-table`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">2</span> {labels.stages.table}</h4>
      <div class="table-scroll course-diagram__scroll" role="region" tabindex="0" aria-label={labels.scrollers.table} data-diagram-scroll>
        <table data-diagram-table>
          <thead>
            <tr>
              <th scope="col">{labels.fields.row}</th>
              <th scope="col">{labels.fields.tableValues}</th>
              <th scope="col">{labels.fields.uses}</th>
              <th scope="col">{labels.fields.state}</th>
            </tr>
          </thead>
          <tbody>
            {trace.table.map((row) => (
              <tr class={`table-row state-${row.state}`}>
                <th scope="row">
                  <InlineMath latex={String.raw`E_{${row.row.lexeme},:}`} />
                </th>
                <td><InlineMath latex={latexVector(row.values)} /></td>
                <td><InlineMath latex={row.uses.lexeme} /></td>
                <td class="row-state">
                  <span class="state-symbol" aria-hidden="true">{tableStateSymbol(row.state)}</span>
                  {tableStateLabel(row.state)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <section class="diagram-stage lookup-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-lookup`}>
    <h4 id={`${titleId}-lookup`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">3</span> {labels.stages.lookup}</h4>
    <p>{labels.notes.oneHot}</p>
    <div class="table-scroll lookup-scroll course-diagram__scroll" role="region" tabindex="0" aria-label={labels.scrollers.lookup} data-diagram-scroll>
      <table data-diagram-table>
        <thead>
          <tr>
            <th scope="col">{labels.fields.position}</th>
            <th scope="col">{labels.fields.tokenId}</th>
            <th scope="col">{labels.fields.oneHot}</th>
            <th scope="col">{labels.fields.operation}</th>
            <th scope="col">{labels.fields.selectedRow}</th>
            <th scope="col">{labels.fields.output}</th>
            <th scope="col">{labels.fields.upstream}</th>
          </tr>
        </thead>
        <tbody>
          {trace.lookups.map((lookup) => (
            <tr class:list={{ 'repeated-row': lookup.sharing === 'repeated-row' }}>
              <th scope="row"><InlineMath latex={latexCoordinate(lookup.coordinate)} /></th>
              <td><InlineMath latex={lookup.id.lexeme} /></td>
              <td><InlineMath latex={latexVector(lookup.oneHot)} /></td>
              <td class="operation-cell">
                <InlineMath latex={String.raw`e_{${lookup.id.lexeme}}E`} />
              </td>
              <td>
                <InlineMath latex={String.raw`E_{${lookup.selectedRow.lexeme},:}`} />
              </td>
              <td><InlineMath latex={latexVector(lookup.output)} /></td>
              <td><InlineMath latex={latexVector(lookup.upstream)} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="diagram-stage gradient-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-gradients`}>
    <h4 id={`${titleId}-gradients`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">4</span> {labels.stages.gradients}</h4>
    <p>{labels.notes.accumulation}</p>
    <div class="table-scroll course-diagram__scroll" role="region" tabindex="0" aria-label={labels.scrollers.gradients} data-diagram-scroll>
      <table data-diagram-table>
        <thead>
          <tr>
            <th scope="col">{labels.fields.row}</th>
            <th scope="col">{labels.fields.positions}</th>
            <th scope="col">{labels.fields.contributions}</th>
            <th scope="col">{labels.fields.rule}</th>
            <th scope="col">{labels.fields.accumulated}</th>
          </tr>
        </thead>
        <tbody>
          {trace.gradients.map((gradient) => (
            <tr class={`gradient-row rule-${gradient.rule}`}>
              <th scope="row">
                <InlineMath latex={String.raw`\bar E_{${gradient.row.lexeme},:}`} />
              </th>
              <td>
                {gradient.flatPositions ? (
                  <InlineMath latex={latexPositions(gradient.flatPositions)} />
                ) : labels.states.none}
              </td>
              <td class="contribution-cell">
                {gradient.contributions ? (
                  gradient.contributions.map((contribution, index) => (
                    <>
                      {index > 0 && <InlineMath latex="+" />}
                      <InlineMath latex={latexVector(contribution)} />
                    </>
                  ))
                ) : labels.states.none}
              </td>
              <td>{ruleLabel(gradient.rule)}</td>
              <td><InlineMath latex={latexVector(gradient.accumulated)} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</figure>

<style>
  .token-embeddings-diagram {
    --diagram-summary-min: 9.5rem;
  }

  .stage-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    align-items: start;
  }

  .diagram-stage {
    min-inline-size: 0;
  }

  .table-scroll {
    --diagram-scroll-inline-size: 100%;
  }

  table {
    inline-size: 100%;
    min-inline-size: 28rem;
  }

  .ids-stage table {
    min-inline-size: 22rem;
  }

  .lookup-stage table {
    min-inline-size: 68rem;
  }

  .gradient-stage table {
    min-inline-size: 54rem;
  }

  .row-state {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: baseline;
  }

  .state-unused > *,
  .rule-unused-zero > * {
    border-block-end-style: dotted;
  }

  .state-selected-once > *,
  .rule-single-copy > * {
    border-block-end-style: solid;
  }

  .state-selected-repeated > *,
  .repeated-row > *,
  .rule-repeated-sum > * {
    border-block-end-style: double;
    border-block-end-width: 3px;
  }

  .contribution-cell {
    min-inline-size: 18rem;
  }

  @container course-diagram (max-width: 44rem) {
    .stage-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 64rem) and (min-height: 36rem) {
    .token-embeddings-diagram:fullscreen {
      --diagram-cell-padding-block: 0.2rem !important;
      grid-template-columns: minmax(0, 1fr) max-content;
      grid-template-areas:
        "caption actions"
        "summary summary"
        "stages stages"
        "lookup lookup"
        "gradients gradients";
      align-content: start;
      align-items: start;
    }

    figure.token-embeddings-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen {
      row-gap: 0;
    }

    .token-embeddings-diagram:fullscreen > figcaption {
      grid-area: caption;
    }

    .token-embeddings-diagram:fullscreen > :global(.diagram-full-view-actions) {
      grid-area: actions;
      align-self: start;
    }

    .token-embeddings-diagram:fullscreen > .shape-summary {
      grid-area: summary;
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .token-embeddings-diagram:fullscreen > .shape-summary > :first-child {
      grid-column: span 2;
    }

    .token-embeddings-diagram:fullscreen > .shape-summary > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) max-content;
      align-items: baseline;
      column-gap: 0.45rem;
    }

    .token-embeddings-diagram:fullscreen > .shape-summary dd {
      margin-block-start: 0;
    }

    .token-embeddings-diagram:fullscreen > .stage-grid {
      grid-area: stages;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .token-embeddings-diagram:fullscreen > .lookup-stage {
      grid-area: lookup;
    }

    .token-embeddings-diagram:fullscreen > .gradient-stage {
      grid-area: gradients;
    }

    .token-embeddings-diagram:fullscreen > :is(.lookup-stage, .gradient-stage) {
      display: grid;
      grid-template-columns: minmax(15rem, 0.25fr) minmax(0, 1.75fr);
      grid-template-rows: auto 1fr;
      align-items: start;
      column-gap: var(--diagram-gap);
    }

    .token-embeddings-diagram:fullscreen > :is(.lookup-stage, .gradient-stage) > h4 {
      grid-column: 1;
      grid-row: 1;
    }

    .token-embeddings-diagram:fullscreen > :is(.lookup-stage, .gradient-stage) > p {
      grid-column: 1;
      grid-row: 2;
    }

    .token-embeddings-diagram:fullscreen
      > :is(.lookup-stage, .gradient-stage)
      > .table-scroll {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .token-embeddings-diagram:fullscreen
      > :is(.lookup-stage, .gradient-stage)
      table {
      min-inline-size: 100%;
    }
  }
</style>
