---
import traceSource from '../../../../rust/demos/ch24-residual-connections/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  parseResidualConnectionsTrace,
  validateResidualConnectionsLabels,
  type ResidualConnectionsDiagramLabels,
} from '../../lib/residual-connections-diagram';

interface Props {
  labels: ResidualConnectionsDiagramLabels;
}

const { labels } = Astro.props;
validateResidualConnectionsLabels(labels);
const trace = parseResidualConnectionsTrace(traceSource);
const titleId = 'residual-connections-title';
const descriptionId = 'residual-connections-description';
const acceptedWhenTrue = (value: string) =>
  value === 'true' ? labels.cues.accepted : labels.cues.rejected;
const rejectedWhenTrue = (value: string) =>
  value === 'true' ? labels.cues.rejected : labels.cues.accepted;
const statusClass = (value: string, trueClass: 'accepted' | 'rejected') =>
  value === 'true' ? trueClass : trueClass === 'accepted' ? 'rejected' : 'accepted';
const zeroWeightRelation =
  trace.zeroBranch.weightGradientNonzero === 'true' ? String.raw`\ne0` : '=0';
---

<figure
  class="course-diagram residual-diagram"
  data-diagram-style="course-v1"
  data-visualization-id="residual-connections"
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description course-diagram__description">{labels.description}</p>
  </figcaption>

  <section class="flow-section course-diagram__card-stack" data-diagram-box aria-labelledby="residual-forward-title">
    <h4 id="residual-forward-title">{labels.sections.forward}</h4>
    <ul class="cue-list" aria-label={labels.sections.forward}>
      <li class="identity-cue" data-diagram-box>{labels.cues.identity}</li>
      <li class="branch-cue" data-diagram-box>{labels.cues.branch}</li>
      <li class="merge-cue" data-diagram-box>{labels.cues.merge}</li>
    </ul>
    <div
      class="flow-scroller course-diagram__scroll"
      data-flow="forward"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.forward}
      data-diagram-scroll>
      <div class="path-grid course-diagram__grid">
        <article data-diagram-card data-diagram-box class="flow-node input-node course-diagram__card-stack" data-node="forward-input">
          <strong>{labels.paths.input}</strong>
          <InlineMath latex={String.raw`x=${trace.forward.input.latex}`} />
        </article>
        <span class="flow-arrow first identity-row" aria-hidden="true">→</span>
        <article data-diagram-card data-diagram-box class="flow-node path-node identity-row course-diagram__card-stack" data-path="identity">
          <strong>{labels.paths.identity}</strong>
          <InlineMath latex={String.raw`x=${trace.forward.input.latex}`} />
        </article>
        <span class="flow-arrow second identity-row" aria-hidden="true">→</span>
        <span class="flow-arrow first branch-row" aria-hidden="true">→</span>
        <article data-diagram-card data-diagram-box class="flow-node path-node branch-row course-diagram__card-stack" data-path="branch">
          <strong>{labels.paths.branch}</strong>
          <InlineMath latex={String.raw`F(x)=${trace.forward.branch.latex}`} />
        </article>
        <span class="flow-arrow second branch-row" aria-hidden="true">→</span>
        <article data-diagram-card data-diagram-box class="flow-node merge-node course-diagram__card-stack" data-node="forward-merge">
          <strong>{labels.paths.merge}</strong>
          <InlineMath latex="+" />
        </article>
        <span class="flow-arrow final" aria-hidden="true">→</span>
        <article data-diagram-card data-diagram-box class="flow-node output-node course-diagram__card-stack" data-node="forward-output">
          <strong>{labels.paths.output}</strong>
          <InlineMath latex={String.raw`y=${trace.forward.output.latex}`} />
        </article>
      </div>
    </div>
    <p class="caption course-diagram__description">{labels.captions.forward}</p>
  </section>

  <section class="flow-section course-diagram__card-stack" data-diagram-box aria-labelledby="residual-backward-title">
    <h4 id="residual-backward-title">{labels.sections.backward}</h4>
    <ul class="cue-list" aria-label={labels.sections.backward}>
      <li class="identity-cue" data-diagram-box>{labels.cues.identity}</li>
      <li class="branch-cue" data-diagram-box>{labels.cues.branch}</li>
      <li class="merge-cue" data-diagram-box>{labels.cues.merge}</li>
    </ul>
    <div
      class="flow-scroller course-diagram__scroll"
      data-flow="backward"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.backward}
      data-diagram-scroll>
      <div class="path-grid course-diagram__grid">
        <article data-diagram-card data-diagram-box class="flow-node input-node course-diagram__card-stack" data-node="backward-upstream">
          <strong>{labels.paths.upstream}</strong>
          <InlineMath latex={String.raw`\bar y=${trace.backward.upstream.latex}`} />
        </article>
        <span class="flow-arrow first identity-row" aria-hidden="true">→</span>
        <article data-diagram-card data-diagram-box class="flow-node path-node identity-row course-diagram__card-stack" data-path="identity-gradient">
          <strong>{labels.paths.identityGradient}</strong>
          <InlineMath latex={String.raw`\bar y=${trace.backward.identity.latex}`} />
        </article>
        <span class="flow-arrow second identity-row" aria-hidden="true">→</span>
        <span class="flow-arrow first branch-row" aria-hidden="true">→</span>
        <article data-diagram-card data-diagram-box class="flow-node path-node branch-row course-diagram__card-stack" data-path="branch-gradient">
          <strong>{labels.paths.branchGradient}</strong>
          <InlineMath latex={String.raw`J_F(x)^\top\bar y=${trace.backward.branch.latex}`} />
        </article>
        <span class="flow-arrow second branch-row" aria-hidden="true">→</span>
        <article data-diagram-card data-diagram-box class="flow-node merge-node course-diagram__card-stack" data-node="backward-merge">
          <strong>{labels.paths.merge}</strong>
          <InlineMath latex="+" />
        </article>
        <span class="flow-arrow final" aria-hidden="true">→</span>
        <article data-diagram-card data-diagram-box class="flow-node output-node course-diagram__card-stack" data-node="backward-input">
          <strong>{labels.paths.inputGradient}</strong>
          <InlineMath latex={String.raw`\bar x=${trace.backward.input.latex}`} />
        </article>
      </div>
    </div>
    <p class="caption course-diagram__description">{labels.captions.backward}</p>
  </section>

  <section class="evidence-section course-diagram__card-stack" data-diagram-box aria-labelledby="residual-evidence-title">
    <h4 id="residual-evidence-title">{labels.sections.evidence}</h4>
    <div class="evidence-grid course-diagram__grid">
      <article data-diagram-card data-diagram-box class="evidence-card parameter-card course-diagram__card-stack">
        <h5>{labels.fields.parameter}</h5>
        <p><code><bdi dir="ltr">{trace.parameter.name}</bdi></code></p>
        <p><InlineMath latex={String.raw`W\in\mathbb{R}^{${trace.parameter.shapeLatex}}`} /></p>
        <p><strong>{labels.fields.parameterGradient}</strong></p>
        <p class="formula-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={labels.fields.parameterGradient} data-diagram-scroll>
          <InlineMath latex={String.raw`\bar W=${trace.parameter.gradient.latex}`} />
        </p>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card zero-card course-diagram__card-stack" data-evidence="zero-branch">
        <h5>{labels.fields.zeroBranch}</h5>
        <div class="formula-scroller course-diagram__scroll course-diagram__card-stack" tabindex="0" role="region" aria-label={labels.fields.zeroBranch} data-diagram-scroll>
          <p><InlineMath latex={String.raw`F(x)=0,\quad y=x=${trace.zeroBranch.output.latex}`} /></p>
          <p><InlineMath latex={String.raw`\bar x=\bar y=${trace.zeroBranch.inputGradient.latex}`} /></p>
          <p><InlineMath latex={String.raw`\bar W=${trace.zeroBranch.weightGradient.latex}${zeroWeightRelation}`} /></p>
        </div>
        <p class="evidence-note">{labels.fields.zeroBranchNote}</p>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card error-card course-diagram__card-stack" data-evidence="shape-error">
        <h5>{labels.fields.shapeError}</h5>
        <p><strong>{labels.fields.shapeInvariant}</strong></p>
        <p><InlineMath latex={String.raw`${trace.shapeError.identity}\ne${trace.shapeError.branch}`} /></p>
        <dl>
          <div>
            <dt>{labels.fields.genericAdd}</dt>
            <dd>
              <span data-diagram-box class={`state-symbol status ${statusClass(trace.shapeError.broadcastable, 'accepted')}`}>
                {acceptedWhenTrue(trace.shapeError.broadcastable)}
              </span>{' '}<code><bdi dir="ltr">broadcastable={trace.shapeError.broadcastable}</bdi></code>
            </dd>
          </div>
          <div>
            <dt>{labels.fields.residualMerge}</dt>
            <dd>
              <span data-diagram-box class={`state-symbol status ${statusClass(trace.shapeError.rejected, 'rejected')}`}>
                {rejectedWhenTrue(trace.shapeError.rejected)}
              </span>{' '}<code><bdi dir="ltr">rejected={trace.shapeError.rejected}</bdi></code>
            </dd>
          </div>
        </dl>
      </article>
    </div>

    <div class="proof-row course-diagram__grid">
      <article data-diagram-card data-diagram-box class="course-diagram__card-stack">
        <h5>{labels.fields.numericCheck}</h5>
        <p class="formula-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={labels.fields.numericCheck} data-diagram-scroll>
          <InlineMath latex={String.raw`n_x=${trace.gradcheck.inputChecks}`} />
          <span aria-hidden="true"> · </span>
          <InlineMath latex={String.raw`n_W=${trace.gradcheck.weightChecks}`} />
          <span aria-hidden="true"> · </span>
          <InlineMath latex={String.raw`\tau=${trace.gradcheck.toleranceLatex}`} />
        </p>
        <p>
          <span data-diagram-box class={`state-symbol status ${statusClass(trace.gradcheck.passed, 'accepted')}`}>
            {acceptedWhenTrue(trace.gradcheck.passed)}
          </span>{' '}<code><bdi dir="ltr">passed={trace.gradcheck.passed}</bdi></code>
        </p>
      </article>
      <article data-diagram-card data-diagram-box class="course-diagram__card-stack">
        <h5>{labels.fields.proof}</h5>
        <p><strong>{labels.fields.fixture}</strong>{' '}<code><bdi dir="ltr">{trace.config.name}</bdi></code></p>
        <p><InlineMath latex={String.raw`\operatorname{shape}(x)=[${trace.config.shapeLatex}]`} /></p>
        <p><strong>{labels.fields.parameter}</strong>{' '}<code><bdi dir="ltr">{trace.config.branchParameter}</bdi></code></p>
        <p><code><bdi dir="ltr">identity={trace.proof.identity}</bdi></code></p>
        <p><code><bdi dir="ltr">gradient={trace.proof.gradient}</bdi></code></p>
        <p><code><bdi dir="ltr">parameters={trace.proof.parameters}</bdi></code></p>
        <p><code><bdi dir="ltr">broadcast={trace.proof.broadcast}</bdi></code></p>
      </article>
    </div>
  </section>

  <section class="stack-section course-diagram__card-stack" data-diagram-box aria-labelledby="residual-stack-title">
    <h4 id="residual-stack-title">{labels.sections.stack}</h4>
    <div class="table-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={labels.scrollers.stack} data-diagram-scroll>
      <table data-diagram-table>
        <caption>{labels.captions.stack}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.depth}</th>
            <th scope="col">{labels.fields.plain}</th>
            <th scope="col">{labels.fields.residual}</th>
          </tr>
        </thead>
        <tbody>
          {trace.stack.map((row) => (
            <tr>
              <th scope="row"><InlineMath latex={row.depth} /></th>
              <td><InlineMath latex={row.plain.latex} /></td>
              <td><InlineMath latex={row.residual.latex} /></td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">{labels.fields.inputGradient}</th>
            <td><InlineMath latex={trace.stackGradient.plain.latex} /></td>
            <td><InlineMath latex={trace.stackGradient.residual.latex} /></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <ul class="parameter-list course-diagram__grid" aria-label={labels.fields.parameter}>
      {trace.stackGradient.parameters.map((parameter) => <li data-diagram-card data-diagram-box><code><bdi dir="ltr">{parameter}</bdi></code></li>)}
    </ul>
  </section>
</figure>

<style>
  .flow-section,
  .evidence-section,
  .stack-section {
    min-inline-size: 0;
  }

  .branch-cue {
    border-style: dashed;
  }

  .merge-cue {
    border-style: double;
    border-width: 3px;
  }

  .path-grid {
    grid-template-columns:
      minmax(15rem, max-content) 2rem minmax(18rem, max-content) 2rem
      minmax(5rem, max-content) 2rem minmax(15rem, max-content);
    grid-template-rows: auto auto;
    gap: 0.7rem;
    align-items: start;
    inline-size: max-content;
    min-inline-size: 100%;
  }

  .flow-node {
    min-inline-size: 0;
    text-align: center;
  }

  .flow-node :global([data-inline-math]) {
    max-inline-size: none;
  }

  .input-node {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: center;
  }

  .path-node {
    grid-column: 3;
  }

  .identity-row {
    grid-row: 1;
  }

  .path-node.identity-row {
    border-style: solid;
  }

  .branch-row {
    grid-row: 2;
  }

  .path-node.branch-row {
    border-style: dashed;
  }

  .merge-node {
    grid-column: 5;
    grid-row: 1 / 3;
    align-self: center;
    border-style: double;
    border-width: 3px;
  }

  .output-node {
    grid-column: 7;
    grid-row: 1 / 3;
    align-self: center;
  }

  .flow-arrow {
    align-self: center;
    font-size: 1.25rem;
    font-weight: 800;
    text-align: center;
  }

  .flow-arrow.first {
    grid-column: 2;
  }

  .flow-arrow.second {
    grid-column: 4;
  }

  .flow-arrow.final {
    grid-column: 6;
    grid-row: 1 / 3;
  }

  .evidence-grid,
  .proof-row {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: start;
  }

  .proof-row {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .zero-card {
    border-style: dashed;
  }

  .error-card {
    border-style: double;
    border-width: 3px;
  }

  .error-card dl,
  .error-card dl div {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }

  .error-card dl {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
  }

  .status.rejected {
    --diagram-state-symbol-border-style: dashed;
  }

  table {
    inline-size: 100%;
    min-inline-size: 38rem;
  }

  .parameter-list {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  :global([dir='rtl']) .flow-arrow {
    transform: scaleX(-1);
  }

  @container course-diagram (max-width: 48rem) {
    .error-card dl {
      grid-template-columns: 1fr;
    }
  }
</style>
