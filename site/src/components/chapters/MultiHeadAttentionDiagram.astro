---
import traceSource from '../../../../rust/demos/ch30-multi-head-attention/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  parseMultiHeadAttentionTrace,
  validateMultiHeadAttentionDiagramLabels,
  type MultiHeadAttentionDiagramLabels,
} from '../../lib/multi-head-attention-diagram';

interface Props {
  labels: MultiHeadAttentionDiagramLabels;
}

const { labels } = Astro.props;
validateMultiHeadAttentionDiagramLabels(labels);
const trace = parseMultiHeadAttentionTrace(traceSource);
const shapeStageLabels: Record<string, string> = {
  input: labels.shapeStages.input,
  split: labels.shapeStages.split,
  rotated: labels.shapeStages.rotated,
  weights: labels.shapeStages.weights,
  'head-output': labels.shapeStages.headOutput,
  merged: labels.shapeStages.merged,
  'output-weight': labels.shapeStages.outputWeight,
  output: labels.shapeStages.output,
};
const shapeStages = Object.entries(trace.shapes);
const titleId = 'multi-head-attention-diagram-title';
const descriptionId = 'multi-head-attention-diagram-description';
const keyPositions = ['0', '1', '2'];
const heads = [
  {
    partition: trace.partitions[0],
    weights: trace.weights.slice(0, 3),
    outputs: trace.headOutputs.slice(0, 3),
    cue: labels.cues.headZero,
    className: 'head-zero',
  },
  {
    partition: trace.partitions[1],
    weights: trace.weights.slice(3, 6),
    outputs: trace.headOutputs.slice(3, 6),
    cue: labels.cues.headOne,
    className: 'head-one',
  },
];
const proofStatus = (value: string) =>
  value === 'changed' ? labels.cues.changed : labels.cues.unchanged;
const headRowPairs = (values: readonly string[]) => {
  if (values.length !== 6) {
    throw new Error('a Chapter 30 head partition must contain three rows of width two');
  }
  return [0, 2, 4].map(
    (offset, index) => `[${values[offset]},${values[offset + 1]}]${index < 2 ? ',' : ''}`,
  );
};
const expectedProof = {
  position_0: 'bitwise-unchanged',
  position_1: 'bitwise-unchanged',
  position_2: 'changed',
  split_merge: 'bitwise',
  head_isolation: 'before-output',
  future_probabilities: 'exact-zero',
  common_offset: 'preserved',
  parameters: '64',
  gradchecks: '76',
};
for (const [key, expected] of Object.entries(expectedProof)) {
  if (trace.proof[key] !== expected) {
    throw new Error(`unexpected multi-head proof value for ${key}`);
  }
}
const proofChecks = [
  { key: 'split-merge', label: labels.proofChecks.splitMerge, result: labels.proofChecks.splitMergeResult, value: trace.proof.split_merge },
  { key: 'head-isolation', label: labels.proofChecks.headIsolation, result: labels.proofChecks.headIsolationResult, value: trace.proof.head_isolation },
  { key: 'future-probabilities', label: labels.proofChecks.futureProbabilities, result: labels.proofChecks.futureProbabilitiesResult, value: trace.proof.future_probabilities },
  { key: 'common-offset', label: labels.proofChecks.commonOffset, result: labels.proofChecks.commonOffsetResult, value: trace.proof.common_offset },
];
---

<figure
  class="course-diagram multi-head-diagram"
  data-diagram-style="course-v1"
  data-visualization-id="multi-head-attention-flow"
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
    <ul class="cue-list" aria-label={labels.captions.heads}>
      <li data-diagram-box class="head-zero-cue">{labels.cues.headZeroCue}</li>
      <li data-diagram-box class="head-one-cue">{labels.cues.headOneCue}</li>
      <li data-diagram-box class="allowed-cue">{labels.cues.allowedCue}</li>
      <li data-diagram-box class="blocked-cue">{labels.cues.blockedCue}</li>
      <li data-diagram-box class="diagonal-cue">{labels.cues.diagonalCue}</li>
    </ul>
  </figcaption>

  <section class="diagram-section split-section course-diagram__card-stack" data-diagram-box data-stage="split" aria-labelledby="multi-head-split-title">
    <h4 id="multi-head-split-title">{labels.sections.split}</h4>
    <p>{labels.captions.split}</p>
    <div
      class="formula-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.splitFormula}
     data-diagram-scroll>
      <p class="formula-line technical">
        <InlineMath latex={String.raw`[B,T,d_{\mathrm{model}}]\to[B,h,T,d_h]`} />
      </p>
    </div>
    <dl class="shape-flow course-diagram__grid" aria-label={labels.fields.shape}>
      {shapeStages.map(([stage, shape]) => (
        <div data-diagram-card data-diagram-box data-shape-stage={stage}>
          <dt>{shapeStageLabels[stage]}</dt>
          <dd><InlineMath latex={shape} /></dd>
        </div>
      ))}
    </dl>
    <div
      class="table-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.partitions}
     data-diagram-scroll>
      <table data-diagram-table class="evidence-table partition-table">
        <caption>{labels.captions.split}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.features}</th>
            {heads.map((head) => (
              <th
                scope="col"
                class={head.className}
                data-head-partition={head.partition.head}
              >
                <span>{head.cue}</span>
                <InlineMath latex={head.partition.features.join(',')} />
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{labels.stages.projected} <InlineMath latex="Q" /></th>
            {heads.map((head) => (
              <td class={head.className}>
                <span class="head-rows">
                  {headRowPairs(head.partition.projectedQuery.values).map((row) => <InlineMath latex={row} />)}
                </span>
              </td>
            ))}
          </tr>
          <tr>
            <th scope="row">{labels.stages.projected} <InlineMath latex="K" /></th>
            {heads.map((head) => (
              <td class={head.className}>
                <span class="head-rows">
                  {headRowPairs(head.partition.projectedKey.values).map((row) => <InlineMath latex={row} />)}
                </span>
              </td>
            ))}
          </tr>
          <tr>
            <th scope="row">{labels.stages.projected} <InlineMath latex="V" /></th>
            {heads.map((head) => (
              <td class={head.className}>
                <span class="head-rows">
                  {headRowPairs(head.partition.projectedValue.values).map((row) => <InlineMath latex={row} />)}
                </span>
              </td>
            ))}
          </tr>
          <tr>
            <th scope="row">{labels.stages.rotary} <InlineMath latex="Q" /></th>
            {heads.map((head) => (
              <td class={head.className}>
                <span class="head-rows">
                  {headRowPairs(head.partition.rotatedQuery.values).map((row) => <InlineMath latex={row} />)}
                </span>
              </td>
            ))}
          </tr>
          <tr>
            <th scope="row">{labels.stages.rotary} <InlineMath latex="K" /></th>
            {heads.map((head) => (
              <td class={head.className}>
                <span class="head-rows">
                  {headRowPairs(head.partition.rotatedKey.values).map((row) => <InlineMath latex={row} />)}
                </span>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="diagram-section heads-section course-diagram__card-stack" data-diagram-box data-stage="heads" aria-labelledby="multi-head-weights-title">
    <h4 id="multi-head-weights-title">{labels.sections.heads}</h4>
    <p>{labels.captions.heads}</p>
    <div
      class="formula-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.headFormula}
     data-diagram-scroll>
      <p class="formula-line technical">
        <InlineMath latex={String.raw`A_i=\operatorname{softmax}_{j}\!\left(\widetilde Q_i\widetilde K_i^\top/\sqrt{d_h}+M\right)`} />
        <InlineMath latex={String.raw`H_i=A_iV_i`} />
      </p>
    </div>
    <div class="head-grid course-diagram__grid">
      {heads.map((head) => (
        <article data-diagram-card data-diagram-box class:list={['head-card', 'course-diagram__card-stack', head.className]} data-attention-head={head.partition.head}>
          <h5>{head.cue}</h5>
          <div
            class="table-scroller course-diagram__scroll"
            tabindex="0"
            role="region"
            aria-label={`${labels.scrollers.heads}: ${head.cue}`}
           data-diagram-scroll>
            <table data-diagram-table class="evidence-table attention-table">
              <caption>{labels.stages.causalWeights}: {head.cue}</caption>
              <colgroup>
                <col class="query-column" />
                <col class="probability-column" span={keyPositions.length} />
                <col class="sum-column" />
                <col class="output-column" />
              </colgroup>
              <thead>
                <tr>
                  <th scope="col">{labels.fields.queryPosition}</th>
                  {keyPositions.map((key) => (
                    <th scope="col" aria-label={`${labels.fields.keyPosition} ${key}`}>
                      <InlineMath latex={'k=' + key} />
                    </th>
                  ))}
                  <th scope="col">{labels.fields.rowSum}</th>
                  <th scope="col">{labels.stages.headOutputs}: {labels.fields.headOutput}</th>
                </tr>
              </thead>
              <tbody>
                {head.weights.map((row, rowIndex) => (
                  <tr
                    data-attention-row
                    data-head={row.head}
                    data-query={row.query}
                    data-probabilities={row.values.latex}
                  >
                    <th scope="row"><InlineMath latex={'q=' + row.query} /></th>
                    {row.values.values.map((probability, keyIndex) => {
                      const visibility = row.visibility[keyIndex];
                      const isDiagonal = keyPositions[keyIndex] === row.query;
                      return (
                        <td
                          class:list={[visibility, { diagonal: isDiagonal }]}
                          data-visibility={visibility}
                          data-diagonal={String(isDiagonal)}
                          aria-label={`${labels.fields.probability} ${probability}; ${labels.fields.visibility}: ${visibility === 'allowed' ? labels.cues.allowed : labels.cues.blocked}${isDiagonal ? `; ${labels.cues.diagonal}` : ''}`}
                        >
                          <InlineMath latex={probability} />
                          <small>
                            {visibility === 'allowed' ? labels.cues.allowed : labels.cues.blocked}
                            {isDiagonal ? ` · ${labels.cues.diagonal}` : ''}
                          </small>
                        </td>
                      );
                    })}
                    <td><InlineMath latex={row.rowSum} /></td>
                    <td data-head-output={head.outputs[rowIndex].token}>
                      <InlineMath latex={head.outputs[rowIndex].values.latex} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="diagram-section merge-section course-diagram__card-stack" data-diagram-box data-stage="merge" aria-labelledby="multi-head-merge-title">
    <h4 id="multi-head-merge-title">{labels.sections.merge}</h4>
    <p>{labels.captions.merge}</p>
    <div
      class="formula-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.mergeFormula}
     data-diagram-scroll>
      <p class="formula-line technical">
        <InlineMath latex={String.raw`\operatorname{MHA}(X)=\operatorname{Concat}(H_1,\ldots,H_h)W_O`} />
      </p>
    </div>
    <div
      class="table-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.concatenation}
     data-diagram-scroll>
      <table data-diagram-table class="evidence-table merge-table">
        <caption>{labels.stages.concatenation}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.tokenPosition}</th>
            <th scope="col">{labels.cues.headZero}</th>
            <th scope="col">{labels.cues.headOne}</th>
            <th scope="col">{labels.fields.mergedRow}</th>
          </tr>
        </thead>
        <tbody>
          {trace.merged.map((row) => (
            <tr data-merged-row={row.token} data-merged-values={row.values.latex}>
              <th scope="row"><InlineMath latex={'t=' + row.token} /></th>
              <td class="head-zero"><InlineMath latex={row.headZero.latex} /></td>
              <td class="head-one"><InlineMath latex={row.headOne.latex} /></td>
              <td class="concatenated"><InlineMath latex={row.values.latex} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="projection-grid course-diagram__grid">
      <div
        class="table-scroller course-diagram__scroll"
        tabindex="0"
        role="region"
        aria-label={labels.scrollers.outputMap}
       data-diagram-scroll>
        <table data-diagram-table class="evidence-table output-map-table">
          <caption>{labels.fields.outputWeight}</caption>
          <thead>
            <tr>
              <th scope="col">{labels.fields.outputWeight}</th>
              <th scope="col"><InlineMath latex="W_O" /></th>
            </tr>
          </thead>
          <tbody>
            {trace.outputMap.map((row) => (
              <tr data-output-map-row={row.row} data-output-map-values={row.values.latex}>
                <th scope="row"><InlineMath latex={'r=' + row.row} /></th>
                <td><InlineMath latex={row.values.latex} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div
        class="table-scroller course-diagram__scroll"
        tabindex="0"
        role="region"
        aria-label={labels.scrollers.finalOutput}
       data-diagram-scroll>
        <table data-diagram-table class="evidence-table final-output-table">
          <caption>{labels.stages.outputProjection}</caption>
          <thead>
            <tr>
              <th scope="col">{labels.fields.tokenPosition}</th>
              <th scope="col">{labels.cues.concatenated}</th>
              <th scope="col">{labels.cues.projected}</th>
            </tr>
          </thead>
          <tbody>
            {trace.outputs.map((row) => (
              <tr
                data-final-output-row={row.token}
                data-merged-values={row.merged.latex}
                data-projected-values={row.projected.latex}
              >
                <th scope="row"><InlineMath latex={'t=' + row.token} /></th>
                <td><InlineMath latex={row.merged.latex} /></td>
                <td><InlineMath latex={row.projected.latex} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="diagram-section proof-section course-diagram__card-stack" data-diagram-box data-stage="proof" aria-labelledby="multi-head-proof-title">
    <h4 id="multi-head-proof-title">{labels.sections.proof}</h4>
    <p>{labels.captions.proof}</p>
    <dl class="proof-grid course-diagram__grid" data-prefix-proof>
      <div data-diagram-card data-diagram-box data-status="pass" data-prefix-position="0" data-prefix-status={trace.proof.position_0}>
        <dt><InlineMath latex="t=0" /></dt>
        <dd>{proofStatus(trace.proof.position_0)} · {labels.cues.verified}</dd>
      </div>
      <div data-diagram-card data-diagram-box data-status="pass" data-prefix-position="1" data-prefix-status={trace.proof.position_1}>
        <dt><InlineMath latex="t=1" /></dt>
        <dd>{proofStatus(trace.proof.position_1)} · {labels.cues.verified}</dd>
      </div>
      <div data-diagram-card data-diagram-box data-status="pass" data-prefix-position="2" data-prefix-status={trace.proof.position_2}>
        <dt><InlineMath latex="t=2" /></dt>
        <dd>{proofStatus(trace.proof.position_2)} · {labels.cues.verified}</dd>
      </div>
    </dl>
    <ul class="invariant-grid course-diagram__grid">
      {proofChecks.map((check) => (
        <li data-diagram-card data-diagram-box data-status="pass" data-proof-check={check.key} data-proof-value={check.value}>
          <span>{check.label}</span>
          <strong>{check.result}</strong>
        </li>
      ))}
      <li data-diagram-card data-diagram-box data-status="pass" data-proof-check="parameters" data-proof-value={trace.proof.parameters}>
        <span>{labels.proofChecks.parameters}</span>
        <InlineMath latex={trace.proof.parameters} />
      </li>
      <li data-diagram-card data-diagram-box data-status="pass" data-proof-check="gradients" data-proof-value={trace.proof.gradchecks}>
        <span>{labels.proofChecks.gradients}</span>
        <InlineMath latex={trace.proof.gradchecks} />
      </li>
    </ul>
    <p class="trace-proof">
      <span>{labels.fields.prefixProof}</span>
      <InlineMath latex={String.raw`\varepsilon=${trace.proof.tolerance}`} />
    </p>
  </section>
</figure>

<style>
  .head-one-cue,
  .head-one,
  .head-card.head-one {
    border-style: dashed;
  }

  .allowed-cue,
  td.allowed {
    border-block-end: 2px solid currentColor;
  }

  .blocked-cue,
  td.blocked {
    border-block-end: 2px dashed currentColor;
  }

  .diagonal-cue,
  td.diagonal {
    border-style: double;
    border-width: 3px;
  }

  .formula-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    max-inline-size: 100%;
  }

  .head-rows {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.5rem;
  }

  .technical,
  .evidence-table,
  .formula-line {
    direction: ltr;
    unicode-bidi: isolate;
  }

  .head-grid,
  .projection-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .proof-grid,
  .invariant-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .partition-table,
  .attention-table {
    inline-size: 100%;
    table-layout: fixed;
  }

  .partition-table {
    min-inline-size: 76rem;
  }

  .partition-table th:first-child {
    inline-size: 12rem;
  }

  .attention-table {
    min-inline-size: 64rem;
  }

  .attention-table .query-column { inline-size: 9rem; }
  .attention-table .sum-column { inline-size: 7rem; }
  .attention-table .output-column { inline-size: 12.5rem; }

  .trace-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .shape-flow {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @container course-diagram (max-width: 48rem) {
    .head-grid,
    .projection-grid,
    .proof-grid,
    .invariant-grid,
    .shape-flow {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .multi-head-diagram:fullscreen {
    grid-template-columns: repeat(24, minmax(0, 1fr));
    align-content: start;
  }

  .multi-head-diagram:fullscreen > :not(section) {
    grid-column: 1 / -1;
  }

  .multi-head-diagram:fullscreen .split-section {
    grid-column: span 10;
  }

  .multi-head-diagram:fullscreen .heads-section {
    grid-column: span 14;
  }

  .multi-head-diagram:fullscreen .merge-section {
    grid-column: span 16;
  }

  .multi-head-diagram:fullscreen .proof-section {
    grid-column: span 8;
  }

  .multi-head-diagram:fullscreen .head-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .multi-head-diagram:fullscreen .shape-flow {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .multi-head-diagram:fullscreen .projection-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .multi-head-diagram:fullscreen:lang(ru) .projection-grid {
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
  }

  .multi-head-diagram:fullscreen .partition-table {
    min-inline-size: 48.5rem;
  }

  .multi-head-diagram:fullscreen .partition-table th:first-child {
    inline-size: 8rem;
  }

  .multi-head-diagram:fullscreen .attention-table {
    min-inline-size: 38rem;
  }

  .multi-head-diagram:fullscreen .attention-table .query-column { inline-size: 5.5rem; }
  .multi-head-diagram:fullscreen .attention-table .sum-column { inline-size: 5rem; }
  .multi-head-diagram:fullscreen .attention-table .output-column { inline-size: 12rem; }

  .multi-head-diagram:dir(rtl) .evidence-table :is(caption, th, small) {
    direction: rtl;
    unicode-bidi: plaintext;
  }
</style>
