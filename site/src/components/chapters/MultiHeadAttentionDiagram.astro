---
import traceSource from '../../../../rust/demos/ch30-multi-head-attention/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  parseMultiHeadAttentionTrace,
  validateMultiHeadAttentionDiagramLabels,
  type MultiHeadAttentionDiagramLabels,
} from '../../lib/multi-head-attention-diagram';

interface Props {
  labels: MultiHeadAttentionDiagramLabels;
}

const { labels } = Astro.props;
validateMultiHeadAttentionDiagramLabels(labels);
const trace = parseMultiHeadAttentionTrace(traceSource);
const shapeStages = Object.entries(trace.shapes);
const titleId = 'multi-head-attention-diagram-title';
const descriptionId = 'multi-head-attention-diagram-description';
const keyPositions = ['0', '1', '2'];
const heads = [
  {
    partition: trace.partitions[0],
    weights: trace.weights.slice(0, 3),
    outputs: trace.headOutputs.slice(0, 3),
    cue: labels.cues.headZero,
    className: 'head-zero',
  },
  {
    partition: trace.partitions[1],
    weights: trace.weights.slice(3, 6),
    outputs: trace.headOutputs.slice(3, 6),
    cue: labels.cues.headOne,
    className: 'head-one',
  },
];
const proofStatus = (value: string) =>
  value === 'changed' ? labels.cues.changed : labels.cues.unchanged;
---

<figure
  class="multi-head-diagram"
  data-visualization-id="multi-head-attention-flow"
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption>
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId}>{labels.description}</p>
    <ul class="cue-list" aria-label={labels.captions.heads}>
      <li class="head-zero-cue">{labels.cues.headZero}</li>
      <li class="head-one-cue">{labels.cues.headOne}</li>
      <li class="allowed-cue">{labels.cues.allowed}</li>
      <li class="blocked-cue">{labels.cues.blocked}</li>
    </ul>
  </figcaption>

  <section class="diagram-section split-section" data-stage="split" aria-labelledby="multi-head-split-title">
    <h4 id="multi-head-split-title">{labels.sections.split}</h4>
    <p>{labels.captions.split}</p>
    <div
      class="formula-scroller"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.formula}
    >
      <p class="formula-line technical">
        <InlineMath latex={String.raw`[B,T,d_{\mathrm{model}}]\to[B,h,T,d_h]`} />
      </p>
    </div>
    <dl class="shape-flow" aria-label={labels.fields.shape}>
      {shapeStages.map(([stage, shape]) => (
        <div data-shape-stage={stage}>
          <dt class="technical">{stage}</dt>
          <dd><InlineMath latex={shape} /></dd>
        </div>
      ))}
    </dl>
    <div
      class="table-scroller"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.partitions}
    >
      <table class="evidence-table partition-table">
        <caption>{labels.captions.split}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.features}</th>
            {heads.map((head) => (
              <th
                scope="col"
                class={head.className}
                data-head-partition={head.partition.head}
              >
                <span>{head.cue}</span>
                <InlineMath latex={head.partition.features.join(',')} />
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{labels.stages.projected} <InlineMath latex="Q" /></th>
            {heads.map((head) => (
              <td class={head.className}>
                <InlineMath latex={head.partition.projectedQuery.latex} />
              </td>
            ))}
          </tr>
          <tr>
            <th scope="row">{labels.stages.projected} <InlineMath latex="K" /></th>
            {heads.map((head) => (
              <td class={head.className}>
                <InlineMath latex={head.partition.projectedKey.latex} />
              </td>
            ))}
          </tr>
          <tr>
            <th scope="row">{labels.stages.projected} <InlineMath latex="V" /></th>
            {heads.map((head) => (
              <td class={head.className}>
                <InlineMath latex={head.partition.projectedValue.latex} />
              </td>
            ))}
          </tr>
          <tr>
            <th scope="row">{labels.stages.rotary} <InlineMath latex="Q" /></th>
            {heads.map((head) => (
              <td class={head.className}>
                <InlineMath latex={head.partition.rotatedQuery.latex} />
              </td>
            ))}
          </tr>
          <tr>
            <th scope="row">{labels.stages.rotary} <InlineMath latex="K" /></th>
            {heads.map((head) => (
              <td class={head.className}>
                <InlineMath latex={head.partition.rotatedKey.latex} />
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="diagram-section heads-section" data-stage="heads" aria-labelledby="multi-head-weights-title">
    <h4 id="multi-head-weights-title">{labels.sections.heads}</h4>
    <p>{labels.captions.heads}</p>
    <div
      class="formula-scroller"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.formula}
    >
      <p class="formula-line technical">
        <InlineMath latex={String.raw`A_i=\operatorname{softmax}_{\mathrm{keys}}\!\left(\widetilde Q_i\widetilde K_i^\top/\sqrt{d_h}+M\right)`} />
        <InlineMath latex={String.raw`H_i=A_iV_i`} />
      </p>
    </div>
    <div class="head-grid">
      {heads.map((head) => (
        <article class:list={['head-card', head.className]} data-attention-head={head.partition.head}>
          <h5>{head.cue}</h5>
          <div
            class="table-scroller"
            tabindex="0"
            role="region"
            aria-label={`${labels.scrollers.heads}: ${head.cue}`}
          >
            <table class="evidence-table attention-table">
              <caption>{labels.stages.causalWeights}: {head.cue}</caption>
              <thead>
                <tr>
                  <th scope="col">{labels.fields.queryPosition}</th>
                  {keyPositions.map((key) => (
                    <th scope="col">
                      <span class="visually-hidden">{labels.fields.keyPosition}: </span>
                      <InlineMath latex={'k=' + key} />
                    </th>
                  ))}
                  <th scope="col">{labels.fields.rowSum}</th>
                  <th scope="col">{labels.stages.headOutputs}: {labels.fields.headOutput}</th>
                </tr>
              </thead>
              <tbody>
                {head.weights.map((row, rowIndex) => (
                  <tr
                    data-attention-row
                    data-head={row.head}
                    data-query={row.query}
                    data-probabilities={row.values.latex}
                  >
                    <th scope="row"><InlineMath latex={'q=' + row.query} /></th>
                    {row.values.values.map((probability, keyIndex) => {
                      const visibility = row.visibility[keyIndex];
                      const isDiagonal = keyPositions[keyIndex] === row.query;
                      return (
                        <td
                          class:list={[visibility, { diagonal: isDiagonal }]}
                          data-visibility={visibility}
                          data-diagonal={String(isDiagonal)}
                        >
                          <span class="visually-hidden">{labels.fields.probability}: </span>
                          <InlineMath latex={probability} />
                          <small>
                            <span class="visually-hidden">{labels.fields.visibility}: </span>
                            {visibility === 'allowed' ? labels.cues.allowed : labels.cues.blocked}
                            {isDiagonal ? ` · ${labels.cues.diagonal}` : ''}
                          </small>
                        </td>
                      );
                    })}
                    <td><InlineMath latex={row.rowSum} /></td>
                    <td data-head-output={head.outputs[rowIndex].token}>
                      <InlineMath latex={head.outputs[rowIndex].values.latex} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="diagram-section merge-section" data-stage="merge" aria-labelledby="multi-head-merge-title">
    <h4 id="multi-head-merge-title">{labels.sections.merge}</h4>
    <p>{labels.captions.merge}</p>
    <div
      class="formula-scroller"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.formula}
    >
      <p class="formula-line technical">
        <InlineMath latex={String.raw`\operatorname{MHA}(X)=\operatorname{Concat}(H_1,\ldots,H_h)W_O`} />
      </p>
    </div>
    <div
      class="table-scroller"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.concatenation}
    >
      <table class="evidence-table merge-table">
        <caption>{labels.stages.concatenation}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.tokenPosition}</th>
            <th scope="col">{labels.cues.headZero}</th>
            <th scope="col">{labels.cues.headOne}</th>
            <th scope="col">{labels.fields.mergedRow}</th>
          </tr>
        </thead>
        <tbody>
          {trace.merged.map((row) => (
            <tr data-merged-row={row.token} data-merged-values={row.values.latex}>
              <th scope="row"><InlineMath latex={'t=' + row.token} /></th>
              <td class="head-zero"><InlineMath latex={row.headZero.latex} /></td>
              <td class="head-one"><InlineMath latex={row.headOne.latex} /></td>
              <td class="concatenated"><InlineMath latex={row.values.latex} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="projection-grid">
      <div
        class="table-scroller"
        tabindex="0"
        role="region"
        aria-label={labels.scrollers.projection}
      >
        <table class="evidence-table output-map-table">
          <caption>{labels.fields.outputWeight}</caption>
          <thead>
            <tr>
              <th scope="col">{labels.fields.outputWeight}</th>
              <th scope="col"><InlineMath latex="W_O" /></th>
            </tr>
          </thead>
          <tbody>
            {trace.outputMap.map((row) => (
              <tr data-output-map-row={row.row} data-output-map-values={row.values.latex}>
                <th scope="row"><InlineMath latex={'r=' + row.row} /></th>
                <td><InlineMath latex={row.values.latex} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div
        class="table-scroller"
        tabindex="0"
        role="region"
        aria-label={`${labels.scrollers.projection}: ${labels.fields.finalOutput}`}
      >
        <table class="evidence-table final-output-table">
          <caption>{labels.stages.outputProjection}</caption>
          <thead>
            <tr>
              <th scope="col">{labels.fields.tokenPosition}</th>
              <th scope="col">{labels.cues.concatenated}</th>
              <th scope="col">{labels.cues.projected}</th>
            </tr>
          </thead>
          <tbody>
            {trace.outputs.map((row) => (
              <tr
                data-final-output-row={row.token}
                data-merged-values={row.merged.latex}
                data-projected-values={row.projected.latex}
              >
                <th scope="row"><InlineMath latex={'t=' + row.token} /></th>
                <td><InlineMath latex={row.merged.latex} /></td>
                <td><InlineMath latex={row.projected.latex} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="diagram-section proof-section" data-stage="proof" aria-labelledby="multi-head-proof-title">
    <h4 id="multi-head-proof-title">{labels.sections.proof}</h4>
    <p>{labels.captions.proof}</p>
    <dl class="proof-grid" data-prefix-proof>
      <div data-prefix-position="0" data-prefix-status={trace.proof.position_0}>
        <dt><InlineMath latex="t=0" /></dt>
        <dd>{proofStatus(trace.proof.position_0)} · {labels.cues.verified}</dd>
      </div>
      <div data-prefix-position="1" data-prefix-status={trace.proof.position_1}>
        <dt><InlineMath latex="t=1" /></dt>
        <dd>{proofStatus(trace.proof.position_1)} · {labels.cues.verified}</dd>
      </div>
      <div data-prefix-position="2" data-prefix-status={trace.proof.position_2}>
        <dt><InlineMath latex="t=2" /></dt>
        <dd>{proofStatus(trace.proof.position_2)} · {labels.cues.verified}</dd>
      </div>
    </dl>
    <p class="trace-proof">
      <span>{labels.fields.prefixProof}</span>
      <InlineMath latex={String.raw`\varepsilon=${trace.proof.tolerance}`} />
      <span class="technical trace-token">{trace.proof.trace}</span>
    </p>
  </section>
</figure>

<style>
  .multi-head-diagram {
    display: grid;
    gap: 1.25rem;
    min-inline-size: 0;
    margin-block: 1.5rem;
    padding: clamp(0.9rem, 2vw, 1.4rem);
    border: 2px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
  }

  figcaption,
  .diagram-section,
  .head-card,
  .projection-grid > * {
    min-inline-size: 0;
  }

  figcaption h3,
  .diagram-section h4,
  .head-card h5 {
    margin-block-start: 0;
  }

  .cue-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    padding-inline-start: 1.2rem;
  }

  .cue-list li,
  .head-card,
  .proof-grid > div {
    border-inline-start: 0.35rem solid currentColor;
    padding-inline-start: 0.65rem;
  }

  .head-one-cue,
  .head-one,
  .head-card.head-one {
    border-inline-start-style: dashed;
  }

  .allowed-cue,
  td.allowed {
    border-block-end: 2px solid currentColor;
  }

  .blocked-cue,
  td.blocked {
    border-block-end: 2px dashed currentColor;
  }

  td.diagonal {
    border: 3px double currentColor;
  }

  .diagram-section {
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--line);
  }

  .formula-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    max-inline-size: 100%;
  }

  .technical {
    direction: ltr;
    unicode-bidi: isolate;
  }

  .table-scroller,
  .formula-scroller {
    max-inline-size: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding-block-end: 0.25rem;
  }

  .table-scroller:focus-visible,
  .formula-scroller:focus-visible,
  .multi-head-diagram:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .evidence-table {
    inline-size: max-content;
    min-inline-size: 100%;
    border-collapse: collapse;
  }

  caption {
    padding-block-end: 0.6rem;
    text-align: start;
    font-weight: 700;
  }

  th,
  td {
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
    vertical-align: top;
    text-align: start;
  }

  th small,
  td small {
    display: block;
    margin-block-start: 0.25rem;
    font-size: 0.75rem;
  }

  .head-grid,
  .projection-grid,
  .proof-grid {
    display: grid;
    align-items: start;
    gap: 1rem;
  }

  .head-grid,
  .projection-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .head-card {
    padding: 0.8rem;
    border-block: 1px solid var(--line);
    border-inline-end: 1px solid var(--line);
    border-radius: 0.6rem;
  }

  .proof-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }

  .partition-table,
  .attention-table {
    inline-size: 100%;
    table-layout: fixed;
  }

  .partition-table {
    min-inline-size: 76rem;
  }

  .partition-table th:first-child {
    inline-size: 12rem;
  }

  .attention-table {
    min-inline-size: 64rem;
  }

  .proof-grid > div {
    padding-block: 0.45rem;
  }

  .proof-grid dt {
    font-weight: 700;
  }

  .proof-grid dd {
    margin-inline-start: 0;
  }

  .trace-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .shape-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    margin-block: 0.75rem 1rem;
  }

  .shape-flow > div {
    min-inline-size: 0;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
  }

  .shape-flow dt {
    font-weight: 700;
  }

  .shape-flow dd {
    margin-inline-start: 0;
  }

  .visually-hidden {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 48rem) {
    .head-grid,
    .projection-grid,
    .proof-grid,
    .shape-flow {
      grid-template-columns: minmax(0, 1fr);
    }

    .multi-head-diagram {
      padding-inline: 0.65rem;
    }
  }

  @media (forced-colors: active) {
    .multi-head-diagram,
    .head-card,
    th,
    td {
      border-color: CanvasText;
    }

    .head-zero-cue,
    .head-zero,
    .head-card.head-zero {
      border-inline-start: 4px solid CanvasText;
    }

    .head-one-cue,
    .head-one,
    .head-card.head-one {
      border-inline-start: 4px dashed CanvasText;
    }

    td.allowed {
      border-block-end: 3px solid CanvasText;
    }

    td.blocked {
      border-block-end: 3px dashed CanvasText;
    }

    td.diagonal {
      border: 4px double CanvasText;
    }
  }
</style>
