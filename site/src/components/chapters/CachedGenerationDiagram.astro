---
import traceSource from '../../../../rust/demos/ch38-cached-generation/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  cachedGenerationDiagramId,
  parseCachedGenerationTrace,
  validateCachedGenerationDiagramLabels,
  type CachedGenerationDiagramLabels,
} from '../../lib/cached-generation-diagram';

interface Props {
  labels: CachedGenerationDiagramLabels;
}

const { labels } = Astro.props;
validateCachedGenerationDiagramLabels(labels);
const trace = parseCachedGenerationTrace(traceSource);
const titleId = 'cached-generation-diagram-title';
const descriptionId = 'cached-generation-diagram-description';
---

<figure
  class="course-diagram cached-generation-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={cachedGenerationDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
    <ul class="cue-list" aria-label={labels.sections.timeline}>
      <li><span aria-hidden="true">|</span> {labels.cues.prefill}</li>
      <li><span aria-hidden="true">||</span> {labels.cues.decode}</li>
      <li><span aria-hidden="true">=</span> {labels.cues.match}</li>
    </ul>
  </figcaption>

  <section aria-labelledby="cached-generation-timeline-title">
    <h4 id="cached-generation-timeline-title">{labels.sections.timeline}</h4>
    <p>{labels.captions.timeline}</p>
    <div class="phase-grid">
      <article
        class="phase-card"
        data-diagram-card
        data-diagram-box
        data-phase="prefill"
        data-cache-before={trace.prefill.cacheBefore}
        data-cache-after={trace.prefill.cacheAfter}
        data-cache-shape={trace.prefill.cacheShape.join(',')}
        data-status="match"
      >
        <header class="phase-header">
          <h5>{labels.cues.prefill}</h5>
          <span class="state-symbol" aria-hidden="true">|</span>
        </header>
        <p>
          <strong>{labels.fields.prompt}:</strong>
          <code><bdi dir="ltr">[{trace.prefill.prompt.join(',')}]</bdi></code>
        </p>
        <p class="value-list">
          <strong>{labels.fields.position}:</strong>
          {trace.prefill.positions.map((position) => (
            <InlineMath latex={`p=${position}`} />
          ))}
        </p>
        <p>
          <strong>{labels.fields.cache}:</strong>
          <InlineMath latex={`${trace.prefill.cacheBefore}\\to${trace.prefill.cacheAfter}`} />
        </p>
        <p>
          <strong>{labels.fields.shape}:</strong>
          <code><bdi dir="ltr">[{trace.prefill.cacheShape.join(',')}]</bdi></code>
        </p>
        <ol class="layer-list">
          {trace.prefill.layers.map((layer) => (
            <li
              class="layer-row"
              data-diagram-box
              data-layer={layer.layer}
              data-layer-phase={layer.phase}
              data-storage={layer.storage}
            >
              <strong>{labels.fields.layer} <InlineMath latex={`\\ell=${layer.layer}`} /></strong>
              <span>{labels.fields.cache} <InlineMath latex={`t=${layer.cacheLen}`} /></span>
              <code><bdi dir="ltr">[{layer.shape.join(',')}]</bdi></code>
              <span>{labels.cues.distinct}</span>
            </li>
          ))}
        </ol>
        <div class="logit-proof" data-match-phase="prefill">
          <p>
            <strong>{labels.fields.cached}:</strong>
            <span class="value-list">
              {trace.prefill.match.cached.map((value, index) => (
                <InlineMath latex={`g^{\\mathrm{cache}}_{${index}}=${value}`} />
              ))}
            </span>
          </p>
          <p>
            <strong>{labels.fields.completePrefix}:</strong>
            <span class="value-list">
              {trace.prefill.match.completePrefix.map((value, index) => (
                <InlineMath latex={`g^{\\mathrm{full}}_{${index}}=${value}`} />
              ))}
            </span>
          </p>
          <p class="match-cue">
            <span aria-hidden="true">=</span>
            {labels.cues.match}
            <strong>{labels.fields.difference}:</strong>
            <InlineMath latex={`\\Delta_{\\mathrm{max}}=${trace.prefill.match.maxAbsDiff}`} />
          </p>
        </div>
      </article>

      <article
        class="phase-card"
        data-diagram-card
        data-diagram-box
        data-phase="decode"
        data-cache-before={trace.decode.cacheBefore}
        data-cache-after={trace.decode.cacheAfter}
        data-cache-shape={trace.decode.cacheShape.join(',')}
        data-status="match"
      >
        <header class="phase-header">
          <h5>{labels.cues.decode}</h5>
          <span class="state-symbol" aria-hidden="true">||</span>
        </header>
        <p>
          <strong>{labels.fields.token}:</strong>
          <InlineMath latex={`z=${trace.decode.token}`} />
        </p>
        <p>
          <strong>{labels.fields.position}:</strong>
          <InlineMath latex={`p=${trace.decode.position}`} />
        </p>
        <p>
          <strong>{labels.fields.cache}:</strong>
          <InlineMath latex={`${trace.decode.cacheBefore}\\to${trace.decode.cacheAfter}`} />
        </p>
        <p>
          <strong>{labels.fields.shape}:</strong>
          <code><bdi dir="ltr">[{trace.decode.cacheShape.join(',')}]</bdi></code>
        </p>
        <ol class="layer-list">
          {trace.decode.layers.map((layer) => (
            <li
              class="layer-row"
              data-diagram-box
              data-layer={layer.layer}
              data-layer-phase={layer.phase}
              data-storage={layer.storage}
            >
              <strong>{labels.fields.layer} <InlineMath latex={`\\ell=${layer.layer}`} /></strong>
              <span>{labels.fields.cache} <InlineMath latex={`t=${layer.cacheLen}`} /></span>
              <code><bdi dir="ltr">[{layer.shape.join(',')}]</bdi></code>
              <span>{labels.cues.distinct}</span>
            </li>
          ))}
        </ol>
        <div class="logit-proof" data-match-phase="decode">
          <p>
            <strong>{labels.fields.cached}:</strong>
            <span class="value-list">
              {trace.decode.match.cached.map((value, index) => (
                <InlineMath latex={`g^{\\mathrm{cache}}_{${index}}=${value}`} />
              ))}
            </span>
          </p>
          <p>
            <strong>{labels.fields.completePrefix}:</strong>
            <span class="value-list">
              {trace.decode.match.completePrefix.map((value, index) => (
                <InlineMath latex={`g^{\\mathrm{full}}_{${index}}=${value}`} />
              ))}
            </span>
          </p>
          <p class="match-cue">
            <span aria-hidden="true">=</span>
            {labels.cues.match}
            <strong>{labels.fields.difference}:</strong>
            <InlineMath latex={`\\Delta_{\\mathrm{max}}=${trace.decode.match.maxAbsDiff}`} />
          </p>
        </div>
      </article>
    </div>
  </section>

  <section aria-labelledby="cached-generation-work-title">
    <h4 id="cached-generation-work-title">{labels.sections.work}</h4>
    <p>{labels.captions.work}</p>
    <div class="proof-grid">
      <article data-diagram-card data-diagram-box data-proof="cache">
        <h5>{labels.fields.cached}</h5>
        <InlineMath latex={`4\\times(1+2+3)=${trace.work.cachedScores}`} />
        <p>{labels.proofs.cache}</p>
        <code><bdi dir="ltr">cache_appends={trace.work.cacheAppends}</bdi></code>
        <code><bdi dir="ltr">qkv_rows={trace.work.qkvRows}</bdi></code>
      </article>
      <article data-diagram-card data-diagram-box data-proof="reference">
        <h5>{labels.fields.completePrefix}</h5>
        <InlineMath latex={`4\\times(2^2+3^2)=${trace.work.completePrefixScores}`} />
        <p>{labels.proofs.reference}</p>
        <code><bdi dir="ltr">layer_caches={trace.work.layerCaches}</bdi></code>
      </article>
    </div>
  </section>

  <section aria-labelledby="cached-generation-driver-title">
    <h4 id="cached-generation-driver-title">{labels.sections.generation}</h4>
    <p>{labels.captions.generation}</p>
    <div class="proof-grid">
      <article data-diagram-card data-diagram-box data-generation="loaded" data-status="match">
        <h5>{labels.proofs.loaded}</h5>
        <p>
          <strong>{labels.fields.prompt}:</strong>
          <code><bdi dir="ltr">[{trace.loaded.prompt.join(',')}]</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.generated}:</strong>
          <code><bdi dir="ltr">[{trace.loaded.generated.join(',')}] -&gt; {trace.loaded.text}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.stop}:</strong>
          <code><bdi dir="ltr">{trace.loaded.stop}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.cache}:</strong>
          <InlineMath latex={`t=${trace.loaded.finalCache}`} />
        </p>
        <p class="value-list">
          <strong>{labels.fields.scoreCells}:</strong>
          <InlineMath latex={`N_{\\mathrm{cache}}=${trace.loaded.cachedScores}`} />
          <InlineMath latex={`N_{\\mathrm{full}}=${trace.loaded.completePrefixScores}`} />
        </p>
        <code><bdi dir="ltr">tokens_match={trace.loaded.tokensMatch}</bdi></code>
        <code><bdi dir="ltr">rng_match={trace.loaded.rngMatch}</bdi></code>
      </article>
      <article data-diagram-card data-diagram-box data-generation="eos" data-status="match">
        <h5>{labels.proofs.eos}</h5>
        <p>
          <strong>{labels.fields.token}:</strong>
          <InlineMath latex={`z_{\\mathrm{EOS}}=${trace.eos.token}`} />
        </p>
        <p>
          <strong>{labels.fields.generated}:</strong>
          <code><bdi dir="ltr">[{trace.eos.generated.join(',')}]</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.stop}:</strong>
          <code><bdi dir="ltr">{trace.eos.stop}</bdi></code>
        </p>
        <p class="value-list">
          <strong>{labels.fields.cache}:</strong>
          <InlineMath latex={`t=${trace.eos.finalCache}`} />
          <InlineMath latex={`n_{\\mathrm{decode}}=${trace.eos.decodeTokens}`} />
        </p>
        <code><bdi dir="ltr">tokens_match={trace.eos.tokensMatch}</bdi></code>
        <code><bdi dir="ltr">rng_match={trace.eos.rngMatch}</bdi></code>
      </article>
    </div>
  </section>

  <section aria-labelledby="cached-generation-reset-title">
    <h4 id="cached-generation-reset-title">{labels.sections.reset}</h4>
    <p>{labels.captions.reset}</p>
    <div class="proof-grid">
      <article data-diagram-card data-diagram-box data-proof="reset" data-status="pass">
        <h5>{labels.cues.reset}</h5>
        <p><InlineMath latex={`${trace.reset.before}\\to${trace.reset.after}`} /></p>
        <code><bdi dir="ltr">allocation_reused={trace.reset.allocation_reused}</bdi></code>
        <code><bdi dir="ltr">storage_unchanged={trace.reset.storage_unchanged}</bdi></code>
        <code><bdi dir="ltr">work_zeroed={trace.reset.work_zeroed}</bdi></code>
        <code><bdi dir="ltr">replay_identical={trace.reset.replay_identical}</bdi></code>
      </article>
      <article data-diagram-card data-diagram-box data-proof="errors" data-status="pass">
        <h5>{labels.cues.unchanged}</h5>
        <code><bdi dir="ltr">decode_before_prefill={trace.errors.decode_before_prefill}</bdi></code>
        <code><bdi dir="ltr">prefill_nonempty={trace.errors.prefill_nonempty}</bdi></code>
        <code><bdi dir="ltr">overflow={trace.errors.overflow}</bdi></code>
        <code><bdi dir="ltr">rebuilt_model={trace.errors.rebuilt_model}</bdi></code>
        <code><bdi dir="ltr">changed_config={trace.errors.changed_config}</bdi></code>
        <code><bdi dir="ltr">unchanged={trace.errors.unchanged}</bdi></code>
      </article>
    </div>
  </section>
</figure>

<style>
  .cached-generation-diagram,
  .cached-generation-diagram > *,
  .phase-card,
  .layer-list,
  .layer-row,
  .logit-proof,
  [data-diagram-card] {
    min-inline-size: 0;
  }

  .phase-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .phase-card,
  .logit-proof,
  [data-diagram-card] {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }

  .phase-card > *,
  .logit-proof > *,
  [data-diagram-card] > * {
    margin: 0;
  }

  .phase-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 0.7rem;
  }

  .phase-header > * {
    margin: 0;
  }

  .layer-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .layer-row {
    display: grid;
    gap: 0.25rem;
    padding: 0.5rem;
    border: 0.12rem solid currentColor;
  }

  .layer-row[data-layer-phase='decode'] {
    border-style: double;
    border-width: 0.28rem;
  }

  .value-list,
  .match-cue {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.7rem;
  }

  @container course-diagram (max-width: 54rem) {
    .phase-grid,
    .layer-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
