---
// @ts-ignore Node filesystem access is used only while generating static HTML.
import { readFileSync } from 'node:fs';

import {
  assertBroadcastingReductionsDiagramLabels,
  broadcastingReductionsDiagramId,
  parseBroadcastingReductionsTrace,
  type BroadcastingReductionsDiagramLabels,
  type TraceNumber,
} from '../../lib/broadcasting-reductions-diagram';
import InlineMath from '../InlineMath.astro';

interface Props {
  labels: BroadcastingReductionsDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'broadcasting-reductions-diagram' } = Astro.props as Props;
assertBroadcastingReductionsDiagramLabels(labels);
const fixtureUrl = new URL(
  '../../../../rust/demos/ch10-broadcasting-reductions/diagram-trace.txt',
  import.meta.url,
);
const trace = parseBroadcastingReductionsTrace(readFileSync(fixtureUrl, 'utf8'));
const titleId = `${instanceId}-title`;
const descriptionId = `${instanceId}-description`;
const tuple = (values: readonly TraceNumber[]) =>
  `[${values.map(({ lexeme }) => lexeme).join(',')}]`;
const emptyErrors = [trace.errors[1], trace.errors[2]] as const;
---

<figure
  class="course-diagram broadcasting-reductions-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={broadcastingReductionsDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
  </figcaption>

  <section class="broadcast-panel" data-diagram-box aria-labelledby={`${instanceId}-broadcast-title`}>
    <h4 id={`${instanceId}-broadcast-title`}>{labels.sections.broadcasting}</h4>
    <p>{labels.notes.broadcasting}</p>
    <ul class="alignment-facts">
      <li data-alignment-id="tokens">
        <span class="visually-hidden">{labels.fields.tensor}: </span>
        <strong>{labels.summary.tokens}</strong>
        <span>{labels.fields.originalShape}</span>
        <code dir="ltr">{tuple(trace.plan.leftShape)}</code>
        <span aria-hidden="true">→</span>
        <span>{labels.fields.alignedShape}</span>
        <code dir="ltr">{tuple(trace.plan.alignedLeft)}</code>
      </li>
      <li data-alignment-id="bias">
        <span class="state-symbol" aria-hidden="true">↻</span>
        <span class="visually-hidden">{labels.symbols.reused}: </span>
        <strong>{labels.summary.bias}</strong>
        <span>{labels.fields.originalShape}</span>
        <code dir="ltr">{tuple(trace.plan.rightShape)}</code>
        <span aria-hidden="true">→</span>
        <span>{labels.fields.alignedShape}</span>
        <code dir="ltr">{tuple(trace.plan.alignedRight)}</code>
      </li>
      <li data-alignment-id="output">
        <strong>{labels.summary.output}</strong>
        <code dir="ltr">{tuple(trace.plan.outputShape)}</code>
      </li>
    </ul>
    <div
      class="mapping-scroll course-diagram__scroll"
      role="region"
      tabindex="0"
      aria-label={labels.sections.broadcasting}
      data-diagram-scroll
    >
      <table data-diagram-table class="mapping-table">
        <thead>
          <tr>
            <th scope="col">{labels.fields.outputCoordinate}</th>
            <th scope="col">{labels.fields.tokenCoordinate}</th>
            <th scope="col">{labels.fields.biasCoordinate}</th>
            <th scope="col">{labels.fields.result}</th>
          </tr>
        </thead>
        <tbody>
          {trace.maps.map((mapping) => (
            <tr
              data-output-coordinate={mapping.output.map(({ lexeme }) => lexeme).join(',')}
              data-left-coordinate={mapping.left.map(({ lexeme }) => lexeme).join(',')}
              data-right-coordinate={mapping.right.map(({ lexeme }) => lexeme).join(',')}
              data-result-value={mapping.value.lexeme}
            >
              <th scope="row"><code dir="ltr">{tuple(mapping.output)}</code></th>
              <td><code dir="ltr">{tuple(mapping.left)}</code></td>
              <td>
                <span class="state-cue reused-value">
                  <span class="state-symbol" aria-hidden="true">↻</span>
                  <span class="visually-hidden">{labels.symbols.reused}: </span>
                  <code dir="ltr">{tuple(mapping.right)}</code>
                </span>
              </td>
              <td><bdi dir="ltr">{mapping.value.lexeme}</bdi></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <article
      class="broadcast-error error-card course-diagram__card-stack"
      data-diagram-card
      data-diagram-box
      data-status="fail"
      data-error-kind={trace.errors[0].kind}
    >
      <div class="course-diagram__card-heading">
        <span class="state-symbol" aria-hidden="true">×</span>
        <span class="visually-hidden">{labels.symbols.rejected}: </span>
        <h5><code dir="ltr">{trace.errors[0].operation}</code></h5>
      </div>
      <dl class="rejection-summary">
        <div data-rejection-field="request">
          <dt data-rejection-label>{labels.fields.request}:</dt>
          <dd data-rejection-value>
            <span dir="ltr">
              <code dir="ltr">{tuple(trace.errors[0].leftShape)}</code>{' / '}
              <code dir="ltr">{tuple(trace.errors[0].rightShape)}</code>
            </span>
          </dd>
        </div>
        <div data-rejection-field="evidence">
          <dt data-rejection-label>{labels.fields.evidence}:</dt>
          <dd data-rejection-value>
            {labels.fields.axis} <bdi dir="ltr">{trace.errors[0].axis.lexeme}</bdi>,{' '}
            <InlineMath latex={String.raw`${trace.errors[0].leftSize.lexeme}\ne${trace.errors[0].rightSize.lexeme}`} />
          </dd>
        </div>
        <div data-rejection-field="reason">
          <dt data-rejection-label>{labels.fields.reason}:</dt>
          <dd data-rejection-value>{labels.reasons.incompatible}</dd>
        </div>
      </dl>
    </article>
  </section>

  <section class="reductions-panel" data-diagram-box aria-labelledby={`${instanceId}-reductions-title`}>
    <h4 id={`${instanceId}-reductions-title`}>{labels.sections.reductions}</h4>
    <p>{labels.notes.reductions}</p>
    <div
      class="reductions-scroll course-diagram__scroll"
      role="region"
      tabindex="0"
      aria-label={labels.sections.reductions}
      data-diagram-scroll
    >
      <table data-diagram-table class="reductions-table">
        <thead>
          <tr>
            <th scope="col">{labels.fields.operation}</th>
            <th scope="col">{labels.fields.axis}</th>
            <th scope="col">{labels.fields.keepDimension}</th>
            <th scope="col">{labels.fields.outputShape}</th>
            <th scope="col">{labels.fields.group} / {labels.fields.values}</th>
          </tr>
        </thead>
        <tbody>
          {trace.reductions.map((reduction) => (
            <tr
              data-reduction-operation={reduction.operation}
              data-reduction-axis={reduction.axis.lexeme}
              data-keep-dim={reduction.keepDim}
              data-output-shape={reduction.outputShape.map(({ lexeme }) => lexeme).join(',')}
              data-reduction-values={reduction.values.map(({ lexeme }) => lexeme).join(',')}
            >
              <th scope="row">
                <span class="state-cue">
                  <span class="state-symbol" aria-hidden="true">↓</span>
                  <span class="visually-hidden">{labels.symbols.reduced}: </span>
                  <code dir="ltr">{reduction.operation}</code>
                </span>
              </th>
              <td><bdi dir="ltr">{reduction.axis.lexeme}</bdi></td>
              <td>{reduction.keepDim === 'yes' ? labels.symbols.yes : labels.symbols.no}</td>
              <td><code dir="ltr">{tuple(reduction.outputShape)}</code></td>
              <td>
                <div class="group-records course-diagram__card-stack">
                  {reduction.groups.map((group, groupIndex) => (
                    <div data-group-indices={group.map(({ lexeme }) => lexeme).join(',')}>
                      <span>{labels.fields.group} <bdi dir="ltr">{groupIndex}</bdi>:</span>
                      <code dir="ltr">{tuple(group.map(({ value }) => trace.output.values[value]!))}</code>
                      <span aria-hidden="true">→</span>
                      <span class="visually-hidden">{labels.fields.result}: </span>
                      <bdi dir="ltr">{reduction.values[groupIndex]!.lexeme}</bdi>
                    </div>
                  ))}
                </div>
              </td>
            </tr>
          ))}
          {emptyErrors.map((error) => (
            <tr data-error-kind={error.kind}>
              <th scope="row">
                <span class="state-cue">
                  <span class="state-symbol" aria-hidden="true">×</span>
                  <span class="visually-hidden">{labels.symbols.rejected}: </span>
                  <code dir="ltr">{error.operation}</code>
                </span>
              </th>
              <td><bdi dir="ltr">{error.axis.lexeme}</bdi></td>
              <td>{labels.symbols.notApplicable}</td>
              <td>{labels.symbols.rejected}</td>
              <td>
                <div class="rejection-record">
                  <span>
                    <strong>{labels.fields.request}:</strong>{' '}
                    <code dir="ltr">{tuple(error.inputShape)}</code>
                  </span>
                  <span>
                    <strong>{labels.fields.reason}:</strong>{' '}
                    {error.operation === 'mean' ? labels.reasons.emptyMean : labels.reasons.emptyMax}
                  </span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</figure>

<style>
  .broadcasting-reductions-diagram { align-content: start; }

  .alignment-facts {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }

  .alignment-facts > li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.4rem;
  }

  .mapping-table {
    inline-size: 100%;
    min-inline-size: 38rem;
    table-layout: fixed;
  }

  .reductions-table {
    inline-size: 100%;
    min-inline-size: 38rem;
    table-layout: fixed;
  }

  .reductions-table th:first-child { inline-size: 15%; }
  .reductions-table th:nth-child(2) { inline-size: 9%; }
  .reductions-table th:nth-child(3) { inline-size: 17%; }
  .reductions-table th:nth-child(4) { inline-size: 17%; }
  .reductions-table th:nth-child(5) { inline-size: 42%; }

  .state-cue {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .group-records > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.4rem;
  }

  .rejection-record {
    display: grid;
    gap: 0.25rem;
  }

  .rejection-summary,
  .rejection-summary > div {
    display: grid;
    align-content: start;
    min-inline-size: 0;
  }

  .rejection-summary {
    gap: 0.5rem;
    margin: 0;
  }

  .broadcast-error { margin-block-start: 0.75rem; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .broadcasting-reductions-diagram:fullscreen {
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-content: start;
  }

  .broadcasting-reductions-diagram:fullscreen > figcaption {
    grid-column: 1 / -1;
  }

  .broadcasting-reductions-diagram:fullscreen :is(.mapping-table, .reductions-table) {
    min-inline-size: 100%;
  }

  .broadcasting-reductions-diagram:fullscreen > .broadcast-panel {
    display: grid;
    grid-template-columns: minmax(18rem, 1fr) minmax(0, 1fr);
    align-content: start;
    column-gap: var(--diagram-gap);
  }

  .broadcasting-reductions-diagram:fullscreen > .broadcast-panel > :is(h4, p, .alignment-facts, .broadcast-error) {
    grid-column: 1;
  }

  .broadcasting-reductions-diagram:fullscreen > .broadcast-panel > .mapping-scroll {
    grid-column: 2;
    grid-row: 1 / span 3;
  }

  .broadcasting-reductions-diagram:fullscreen > .broadcast-panel > .broadcast-error {
    grid-column: 1 / -1;
    grid-row: 4;
    margin-block-start: 0.25rem;
  }

  .broadcasting-reductions-diagram:fullscreen .rejection-summary {
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 0.9fr) minmax(0, 1.6fr);
    column-gap: 0.75rem;
  }

</style>
