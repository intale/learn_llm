---
// @ts-ignore Node filesystem access is used only while generating static HTML.
import { readFileSync } from 'node:fs';

import {
  assertAutoregressiveExamplesDiagramLabels,
  autoregressiveExamplesDiagramId,
  parseAutoregressiveExamplesTrace,
  type AutoregressiveExamplesDiagramLabels,
} from '../../lib/autoregressive-examples-diagram';

interface Props {
  labels: AutoregressiveExamplesDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'autoregressive-examples-diagram' } = Astro.props as Props;
assertAutoregressiveExamplesDiagramLabels(labels);
const fixtureUrl = new URL(
  '../../../../rust/demos/ch05-autoregressive-examples/diagram-trace.txt',
  import.meta.url,
);
const trace = parseAutoregressiveExamplesTrace(readFileSync(fixtureUrl, 'utf8'));
const titleId = `${instanceId}-title`;
const descriptionId = `${instanceId}-description`;
const rulesTitleId = `${instanceId}-rules-title`;
const inputLabelId = `${instanceId}-input-label`;
const shiftRuleId = `${instanceId}-shift-rule`;
const targetLabelId = `${instanceId}-target-label`;
const bosDefinitionId = `${instanceId}-bos-definition`;
const eosDefinitionId = `${instanceId}-eos-definition`;
const completeRuleId = `${instanceId}-complete-rule`;
const boundaryRuleId = `${instanceId}-boundary-rule`;
const tailPolicyId = `${instanceId}-tail-policy`;
---

<figure
  class="course-diagram autoregressive-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={autoregressiveExamplesDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
    <dl class="config-facts course-diagram__grid">
      <div data-diagram-card data-diagram-box>
        <dt>{labels.fields.contextLength}</dt>
        <dd><bdi dir="ltr">{trace.config.contextLength}</bdi></dd>
      </div>
      <div data-diagram-card data-diagram-box>
        <dt>{labels.fields.stride}</dt>
        <dd><bdi dir="ltr">{trace.config.stride}</bdi></dd>
      </div>
      <div data-diagram-card data-diagram-box>
        <dt>{labels.fields.requiredSourceTokens}</dt>
        <dd><bdi dir="ltr">{trace.config.requiredSourceTokens}</bdi></dd>
      </div>
    </dl>
  </figcaption>

  <section
    class="consolidated-rule-key course-diagram__card-stack"
    data-diagram-card
    data-diagram-box
    data-consolidated-rule-key
    aria-labelledby={rulesTitleId}
  >
    <h4 id={rulesTitleId} class="visually-hidden">{labels.invariantsLabel}</h4>
    <div class="global-window-legend" data-global-window-legend>
      <strong id={inputLabelId}>{labels.lanes.input}</strong>
      <span aria-hidden="true">→</span>
      <span id={shiftRuleId}>{labels.shiftLabel}</span>
      <span aria-hidden="true">→</span>
      <strong id={targetLabelId}>{labels.lanes.target}</strong>
    </div>
    <span class="rule-separator" aria-hidden="true"> · </span>
    <p id={completeRuleId} class="complete-rule"><span aria-hidden="true">✓</span> {labels.invariants.complete}</p>
    <span class="rule-separator" aria-hidden="true"> · </span>
    <p id={boundaryRuleId} class="boundary-note"><span aria-hidden="true">║</span> {labels.boundaryNote}</p>
    <span class="rule-separator" aria-hidden="true"> · </span>
    <p id={tailPolicyId} class="tail-policy">{labels.tailNote}</p>
    <span class="rule-separator" aria-hidden="true"> · </span>
    <p class="control-key">
      <span id={bosDefinitionId}><bdi dir="ltr">BOS</bdi> — {labels.fields.bos}</span>
      <span class="rule-separator" aria-hidden="true"> · </span>
      <span id={eosDefinitionId}><bdi dir="ltr">EOS</bdi> — {labels.fields.eos}</span>
    </p>
  </section>

  {
    trace.partitions.map((partition) => {
        const partitionId = `${instanceId}-${partition.name}`;
        return (
          <section
            class="partition course-diagram__card-stack"
            data-diagram-card
            data-diagram-box
            data-partition={partition.name}
            aria-labelledby={`${partitionId}-title`}
          >
              <header class="partition-header">
                <span class="boundary-symbol" aria-hidden="true">║</span>
                <div>
                  <p class="boundary-label">{labels.boundaryLabel}</p>
                  <h4 id={`${partitionId}-title`}>{labels.partitionTitles[partition.name]}</h4>
                </div>
              </header>

              <ol class="document-list course-diagram__grid">
                {partition.documents.map((document) => {
                  const documentId = `${partitionId}-${document.id}`;
                  const incompleteTail = document.incompleteTail;
                  return (
                    <li>
                      <article data-diagram-card data-diagram-box
                        class="document"
                        data-document={document.id}
                        data-partition={partition.name}
                        aria-labelledby={`${documentId}-title`}
                      >
                        <header class="document-header">
                          <h5 id={`${documentId}-title`}>
                            {labels.fields.document}{' '}
                            <code dir="ltr">{document.id}</code>
                          </h5>
                          <span class="document-boundary" aria-hidden="true">║ … ║</span>
                        </header>

                        <section class="source-lane" aria-labelledby={`${documentId}-source`}>
                          <h6 id={`${documentId}-source`}>{labels.lanes.source}</h6>
                          <span id={`${documentId}-source-sequence`} class="visually-hidden">
                            {document.tokens.map((token, position) =>
                              position === 0
                                ? `BOS:${token}`
                                : position === document.tokens.length - 1
                                  ? `EOS:${token}`
                                  : token,
                            ).join(', ')}
                          </span>
                          <p
                            class="token-tape course-diagram__scroll"
                            role="region"
                            tabindex="0"
                            dir="ltr"
                            style={`--token-count: ${document.tokens.length}`}
                            aria-labelledby={`${documentId}-source ${documentId}-source-sequence`}
                            aria-describedby={`${bosDefinitionId} ${eosDefinitionId}`}
                            data-diagram-scroll>
                            {document.tokens.map((token, position) => {
                              const isBos = position === 0;
                              const isEos = position === document.tokens.length - 1;
                              return (
                                <code
                                  data-position={position}
                                  data-token-id={token}
                                  data-control={isBos ? 'bos' : isEos ? 'eos' : undefined}
                                  aria-hidden="true"
                                  data-diagram-box
                                >
                                  {isBos ? `BOS:${token}` : isEos ? `EOS:${token}` : token}
                                </code>
                              );
                            })}
                          </p>
                        </section>

                        <ol class="window-list course-diagram__grid">
                          {document.windows.map((window) => (
                            <li
                              class="window course-diagram__card-stack"
                              data-window-index={window.index}
                              data-window-start={window.start}
                              data-status="emitted"
                            >
                              <header>
                                <strong id={`${documentId}-window-${window.index}-title`}>
                                  {labels.values.emitted}{' '}
                                  <bdi dir="ltr">#{window.index}</bdi>
                                </strong>
                                <span id={`${documentId}-window-${window.index}-start`}>
                                  {labels.fields.start}: <bdi dir="ltr">{window.start}</bdi>
                                </span>
                              </header>
                              <div
                                class="aligned-window"
                                style={`--token-count: ${document.tokens.length}`}
                              >
                                <span
                                  id={`${documentId}-window-${window.index}-input-sequence`}
                                  class="visually-hidden"
                                >
                                  {window.input.join(', ')}
                                </span>
                                <p
                                  class="aligned-tape course-diagram__scroll"
                                  role="region"
                                  tabindex="0"
                                  dir="ltr"
                                  aria-labelledby={`${documentId}-window-${window.index}-title ${documentId}-window-${window.index}-start ${inputLabelId} ${documentId}-window-${window.index}-input-sequence`}
                                  data-diagram-scroll>
                                  {document.tokens.map((_, position) => {
                                    const offset = position - window.start;
                                    const token = window.input[offset];
                                    return token === undefined ? (
                                      <span class="empty-cell" data-diagram-box aria-hidden="true">·</span>
                                    ) : (
                                      <code
                                        data-input-position={offset}
                                        data-token-id={token}
                                        aria-hidden="true"
                                        data-diagram-box
                                      >
                                        {token}
                                      </code>
                                    );
                                  })}
                                </p>
                                <span
                                  id={`${documentId}-window-${window.index}-target-sequence`}
                                  class="visually-hidden"
                                >
                                  {window.target.join(', ')}
                                </span>
                                <p
                                  class="aligned-tape target course-diagram__scroll"
                                  role="region"
                                  tabindex="0"
                                  dir="ltr"
                                  aria-labelledby={`${documentId}-window-${window.index}-title ${documentId}-window-${window.index}-start ${targetLabelId} ${documentId}-window-${window.index}-target-sequence`}
                                  aria-describedby={shiftRuleId}
                                  data-diagram-scroll>
                                  {document.tokens.map((_, position) => {
                                    const offset = position - window.start - 1;
                                    const token = window.target[offset];
                                    return token === undefined ? (
                                      <span class="empty-cell" data-diagram-box aria-hidden="true">·</span>
                                    ) : (
                                      <code
                                        data-target-position={offset}
                                        data-token-id={token}
                                        aria-hidden="true"
                                        data-diagram-box
                                      >
                                        {token}
                                      </code>
                                    );
                                  })}
                                </p>
                              </div>
                            </li>
                          ))}
                        </ol>

                        {incompleteTail && (
                          <section
                            class="incomplete-tail course-diagram__card-stack"
                            data-diagram-card
                            data-diagram-box
                            data-tail-start={incompleteTail.start}
                            data-status="not-emitted"
                            aria-labelledby={`${documentId}-tail ${documentId}-tail-status`}
                          >
                            <header>
                              <h6 id={`${documentId}-tail`}>{labels.lanes.incompleteTail}</h6>
                              <span id={`${documentId}-tail-status`} class="not-emitted">
                                <span aria-hidden="true">×</span> {labels.values.notEmitted}
                              </span>
                            </header>
                            <p id={`${documentId}-tail-facts`}>
                              {labels.fields.start}:{' '}
                              <bdi dir="ltr">{incompleteTail.start}</bdi>
                              {' · '}{labels.fields.requiredSourceTokens}:{' '}
                              <bdi dir="ltr">{incompleteTail.requiredSourceTokens}</bdi>
                            </p>
                            <span id={`${documentId}-tail-sequence`} class="visually-hidden">
                              {incompleteTail.tokens.join(', ')}
                            </span>
                            <p
                              class="tail-tape course-diagram__scroll"
                              role="region"
                              tabindex="0"
                              dir="ltr"
                              style={`--token-count: ${document.tokens.length}`}
                              aria-labelledby={`${documentId}-tail ${documentId}-tail-status ${documentId}-tail-facts ${documentId}-tail-sequence`}
                              aria-describedby={tailPolicyId}
                              data-diagram-scroll>
                              {document.tokens.map((_, position) => {
                                const offset = position - incompleteTail.start;
                                const token = incompleteTail.tokens[offset];
                                return token === undefined ? (
                                  <span class="empty-cell" data-diagram-box aria-hidden="true">·</span>
                                ) : (
                                  <code
                                    data-tail-position={offset}
                                    data-token-id={token}
                                    aria-hidden="true"
                                    data-diagram-box
                                  >
                                    {token}
                                  </code>
                                );
                              })}
                            </p>
                          </section>
                        )}
                      </article>
                    </li>
                  );
                })}
              </ol>
          </section>
        );
    })
  }

</figure>

<style>
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    border: 0;
    white-space: nowrap;
  }

  .global-window-legend,
  .control-key {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin: 0;
  }

  .config-facts > div {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .config-facts dt,
  .config-facts dd {
    margin: 0;
  }

  .document-list > li,
  .window-list > li {
    min-inline-size: 0;
    max-inline-size: none;
  }

  .partition {
    inline-size: 100%;
    min-inline-size: 0;
    border-inline-start-width: 0.55rem;
  }

  .partition-header,
  .document-header,
  .window > header,
  .incomplete-tail > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .partition-header h4,
  .partition-header p,
  .document-header h5,
  .window > header,
  .incomplete-tail h6 {
    margin: 0;
  }

  .boundary-symbol,
  .document-boundary {
    font-size: 1.35rem;
    font-weight: 800;
  }

  .document-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block-start: 0.9rem;
  }

  .document {
    inline-size: 100%;
    min-inline-size: 0;
    border-style: dashed;
    border-inline: 0.3rem double var(--line);
  }

  .source-lane h6,
  .source-lane p {
    margin-block: 0.55rem;
  }

  .token-tape,
  .aligned-tape,
  .tail-tape {
    --token-track-min: calc(5ch + 0.7rem + 6px);
    display: grid;
    grid-template-columns: repeat(var(--token-count), minmax(var(--token-track-min), 1fr));
    gap: 0.3rem;
    white-space: nowrap;
  }

  /*
   * The tail card keeps shared padding and borders. Extend its scroll region
   * back to the source tape's token-column origin.
   */
  .autoregressive-diagram .incomplete-tail > .tail-tape {
    --diagram-scroll-inline-size: calc(
      100% + var(--diagram-card-padding) + var(--diagram-card-padding) + 2px
    );
    margin-inline: calc(0px - var(--diagram-card-padding) - 1px);
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .incomplete-tail
    > .tail-tape.course-diagram__scroll {
    max-inline-size: var(--diagram-scroll-inline-size);
  }

  code[data-token-id],
  .empty-cell {
    display: inline-grid;
    min-inline-size: 2.25rem;
    min-block-size: 2rem;
    place-items: center;
    padding-inline: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 0.4rem;
  }

  code[data-control] {
    border-style: double;
    border-width: 3px;
  }

  .window-list {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.7rem;
    margin-block: 0.8rem;
  }

  .window {
    inline-size: 100%;
    min-inline-size: 0;
  }

  .window > header {
    margin-block-end: 0.55rem;
  }

  .aligned-window {
    min-inline-size: 0;
  }

  .aligned-tape {
    margin-block: 0.25rem;
  }

  .empty-cell {
    border-style: dotted;
    background: transparent;
    color: var(--muted);
  }

  .target code {
    border-block-end-width: 3px;
  }

  .incomplete-tail {
    border-style: dotted;
  }

  .consolidated-rule-key {
    margin-block-start: 1rem;
  }

  .consolidated-rule-key > :is(p, h4) {
    margin: 0;
  }

  .rule-separator {
    display: none;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen {
    grid-template-columns: minmax(0, 5.72fr) minmax(0, 3fr) minmax(0, 3.58fr);
    grid-template-rows: auto auto auto;
    align-content: start;
    align-items: start;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    > .consolidated-rule-key {
    display: block;
    grid-column: 1 / 3;
    grid-row: 1;
    align-self: start;
    min-inline-size: 0;
    margin: 0;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    > :global(.diagram-full-view-actions) {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    > .partition {
    grid-row: 2 / span 2;
    align-self: start;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    > .partition[data-partition='train'] {
    grid-column: 1;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    > .partition[data-partition='validation'] {
    grid-column: 2;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    > .partition[data-partition='test'] {
    grid-column: 3;
    grid-row: 3;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    > figcaption {
    grid-column: 3;
    grid-row: 2;
    align-self: start;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    > .partition[data-partition='train']
    .document-list {
    grid-template-columns: minmax(0, 2.99fr) minmax(0, 2.12fr);
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    > .partition:is([data-partition='validation'], [data-partition='test'])
    .document-list {
    grid-template-columns: minmax(0, 1fr);
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .consolidated-rule-key
    > :not(.visually-hidden),
  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .global-window-legend,
  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .global-window-legend
    > *,
  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .control-key,
  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .control-key
    > span,
  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .complete-rule,
  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .boundary-note,
  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .tail-policy,
  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .rule-separator {
    display: inline;
    min-inline-size: 0;
    max-inline-size: none;
    margin: 0;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .document {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    align-items: start;
    gap: 0.35rem;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .document
    > :is(.document-header, .source-lane, .window-list, .incomplete-tail) {
    grid-column: 1;
    min-inline-size: 0;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .document
    > .source-lane {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.2rem;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .document
    > .source-lane
    > :is(h6, .token-tape) {
    margin-block: 0;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .document
    > .window-list {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    margin-block: 0;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .window {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto;
    row-gap: 0.25rem;
    min-inline-size: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .window
    + .window {
    padding-block-start: 0.35rem;
    border-block-start: 1px dashed var(--line);
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .window
    > header {
    grid-column: 1;
    grid-row: 1;
    flex-flow: row wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.15rem 0.5rem;
    margin: 0;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .window
    > .aligned-window {
    display: contents;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .window
    .aligned-tape:not(.target) {
    grid-column: 1;
    grid-row: 2;
    --diagram-scroll-inline-size: 100%;
    margin: 0;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .window
    .aligned-tape.target {
    grid-column: 1;
    grid-row: 3;
    --diagram-scroll-inline-size: 100%;
    margin: 0;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .incomplete-tail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto auto;
    row-gap: 0.25rem;
    min-inline-size: 0;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .incomplete-tail
    > header {
    grid-column: 1;
    grid-row: 1;
    flex-flow: row wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.15rem 0.5rem;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .incomplete-tail
    > header
    + p {
    grid-column: 1;
    grid-row: 2;
    margin: 0;
  }

  figure.autoregressive-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen
    .document
    > .incomplete-tail
    > .tail-tape.course-diagram__scroll {
    grid-column: 1;
    grid-row: 3;
    margin-block: 0;
  }

  @container course-diagram (max-width: 48rem) {
    .document-list {
      grid-template-columns: minmax(0, 1fr);
    }

    .partition-header,
    .document-header,
    .window > header,
    .incomplete-tail > header {
      align-items: flex-start;
      flex-direction: column;
    }
