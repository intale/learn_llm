---
import traceSource from '../../../../rust/demos/ch21-mini-batches/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  assertMiniBatchesDiagramLabels,
  miniBatchesDiagramId,
  parseMiniBatchesTrace,
  type MiniBatchesDiagramLabels,
} from '../../lib/mini-batches-diagram';

interface Props {
  labels: MiniBatchesDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'default' } = Astro.props;
assertMiniBatchesDiagramLabels(labels);
if (!/^[a-z][a-z0-9-]*$/.test(instanceId)) {
  throw new Error('Mini-batches diagram instanceId must be a kebab-case identifier.');
}
const trace = parseMiniBatchesTrace(traceSource);
const titleId = `${miniBatchesDiagramId}-${instanceId}-title`;
const descriptionId = `${miniBatchesDiagramId}-${instanceId}-description`;
const tokenPosition = ['1', '2'] as const;
const latexVector = (items: readonly string[]) =>
  String.raw`\left[${items.join(',')}\right]`;
const compactDecimal = (value: string) =>
  value.includes('.') ? value.replace(/0+$/, '').replace(/\.$/, '') : value;
---

<figure
  class="course-diagram mini-batches-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={miniBatchesDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description course-diagram__description">{labels.description}</p>
  </figcaption>

  <dl class="shape-summary" aria-label={labels.stages.shuffle}>
    <div data-diagram-box>
      <dt>{labels.summary.contextLength}</dt>
      <dd><InlineMath latex={String.raw`T=${trace.meta.context}`} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.requestedCapacity}</dt>
      <dd><InlineMath latex={String.raw`|B|_{\mathrm{max}}=${trace.meta.capacity}`} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.shuffleSeed}</dt>
      <dd><bdi dir="ltr"><code>{trace.meta.seed}</code></bdi></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.completeWindows}</dt>
      <dd><InlineMath latex={trace.meta.windows} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.batchCount}</dt>
      <dd><InlineMath latex={trace.meta.batches} /></dd>
    </div>
  </dl>

  <section class="shuffle-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-shuffle`}>
    <h4 id={`${titleId}-shuffle`} class="course-diagram__card-heading">
      <span class="state-symbol" aria-hidden="true">1</span>
      {labels.stages.shuffle}
    </h4>
    <p>{labels.notes.shuffle}</p>
    <ol class="shuffle-list course-diagram__grid">
      {trace.windows.map((window) => (
        <li data-slot={window.slot} data-batch={window.batch}>
          <span class="ordinal" aria-label={`${labels.fields.slot} ${window.slot}`}>#{window.slot}</span>
          <strong><bdi dir="ltr">{window.document}@{window.start}</bdi></strong>
          <span aria-label={`${labels.symbols.batch} B ${window.batch}`}>
            <InlineMath latex={String.raw`B_{${window.batch}}`} />
          </span>
        </li>
      ))}
    </ol>
  </section>

  <section class="batches-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-batches`}>
    <h4 id={`${titleId}-batches`} class="course-diagram__card-heading">
      <span class="state-symbol" aria-hidden="true">2</span>
      {labels.stages.batches}
    </h4>
    <p>{labels.notes.tokenMean}</p>

    <div class="batch-grid course-diagram__grid">
      {trace.batches.map((batch) => (
        <article
          data-diagram-card
          data-diagram-box
          class:list={['batch-card', 'course-diagram__card-stack', batch.index === '1' && 'final-card']}
          data-batch={batch.index}
          aria-labelledby={`${titleId}-batch-${batch.index}`}
        >
          <div
            class="batch-scroll course-diagram__scroll"
            role="region"
            tabindex="0"
            aria-label={`${labels.scrollers.batchRows} ${batch.index}`}
           data-diagram-scroll>
            <table data-diagram-table class="batch-table" data-batch-table={batch.index}>
              <caption id={`${titleId}-batch-${batch.index}`}>
                {labels.captions.batchRows}: {labels.symbols.batch}{' '}
                <InlineMath latex={String.raw`B_{${batch.index}}`} />
                <span aria-hidden="true"> · </span>
                <InlineMath latex={String.raw`|B_${batch.index}|=${batch.width}`} />
              </caption>
              <thead>
                <tr>
                  <th scope="col">{labels.fields.origin}</th>
                  <th scope="col">{labels.fields.input}</th>
                  <th scope="col">{labels.fields.target}</th>
                  <th scope="col">{labels.fields.tokenLosses}</th>
                </tr>
              </thead>
              <tbody>
                {batch.windows.map((window) => (
                  <tr data-slot={window.slot}>
                    <th scope="row">
                      <span>{labels.symbols.window} {window.slot}</span>
                      <bdi dir="ltr"><code>{window.document}@{window.start}</code></bdi>
                    </th>
                    <td data-evidence-cell="input"><bdi dir="ltr"><code>{window.input.lexeme}</code></bdi></td>
                    <td data-evidence-cell="target"><bdi dir="ltr"><code>{window.target.lexeme}</code></bdi></td>
                    <td data-evidence-cell="losses">
                      <span class="loss-pair">
                        {window.losses.items.map((loss, index) => (
                          <InlineMath
                            latex={String.raw`\mathcal{L}_{${window.slot},${tokenPosition[index]}}=${loss}`}
                          />
                        ))}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {batch.index === '1' && (
            <div data-diagram-card data-diagram-box class="unused-slot">
              <span>{labels.fields.capacitySlot}</span>
              <strong>{labels.symbols.unused}</strong>
            </div>
          )}
        </article>
      ))}
    </div>

    <dl class="batch-comparison course-diagram__grid" aria-label={labels.stages.batches}>
      <div data-evidence-metric="shape">
        <dt>{labels.fields.shape}</dt>
        {trace.batches.map((batch) => (
          <dd data-batch={batch.index}>
            <InlineMath latex={String.raw`\operatorname{shape}(B_{${batch.index}})=${latexVector(batch.shape.items)}`} />
          </dd>
        ))}
      </div>
      <div data-evidence-metric="target-count">
        <dt>{labels.fields.targetTokens}</dt>
        {trace.batches.map((batch) => (
          <dd data-batch={batch.index}><InlineMath latex={String.raw`N_{B_{${batch.index}}}=${batch.tokens}`} /></dd>
        ))}
      </div>
      <div data-evidence-metric="loss-sum">
        <dt>{labels.fields.lossSum}</dt>
        {trace.batches.map((batch) => (
          <dd data-batch={batch.index}>
            <InlineMath latex={String.raw`B_{${batch.index}}:\;${compactDecimal(batch.lossSum)}`} />
          </dd>
        ))}
      </div>
      <div data-evidence-metric="denominator">
        <dt>{labels.fields.denominator}</dt>
        {trace.batches.map((batch) => (
          <dd data-batch={batch.index}><InlineMath latex={String.raw`|B_{${batch.index}}|T=${batch.tokens}`} /></dd>
        ))}
      </div>
      <div data-evidence-metric="mean-loss">
        <dt>{labels.fields.meanLoss}</dt>
        {trace.batches.map((batch) => (
          <dd data-batch={batch.index}>
            <InlineMath latex={String.raw`\mathcal{L}_{B_{${batch.index}}}=\frac{${compactDecimal(batch.lossSum)}}{${batch.tokens}}=${compactDecimal(batch.meanLoss)}`} />
          </dd>
        ))}
      </div>
      <div data-evidence-metric="mean-gradient">
        <dt>{labels.fields.meanGradient}</dt>
        {trace.batches.map((batch) => (
          <dd data-batch={batch.index}>
            <InlineMath latex={String.raw`\bar g_{B_{${batch.index}}}=${latexVector(batch.meanGradient.items)}`} />
          </dd>
        ))}
      </div>
      <div data-evidence-metric="accumulation">
        <dt>{labels.fields.rawAccumulation}</dt>
        {trace.batches.map((batch) => (
          <dd data-batch={batch.index}>
            <InlineMath latex={String.raw`B_{${batch.index}}:\;=`} /> {labels.symbols.equal}
          </dd>
        ))}
      </div>
    </dl>
  </section>

  <section class="final-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-final`}>
    <h4 id={`${titleId}-final`} class="course-diagram__card-heading">
      <span class="state-symbol" aria-hidden="true">3</span>
      {labels.stages.finalBatch}
    </h4>
    <p>{labels.notes.finalBatch}</p>
    <div class="denominator-contrast course-diagram__grid">
      <article data-diagram-card data-diagram-box class="capacity-denominator course-diagram__card-stack">
        <p>{labels.summary.requestedCapacity}</p>
        <InlineMath
          latex={String.raw`${trace.meta.capacity}\times${trace.meta.context}=${trace.final.capacityTokens}`}
        />
        <strong>{labels.symbols.unused}</strong>
      </article>
      <span class="contrast-arrow" aria-hidden="true">→</span>
      <article data-diagram-card data-diagram-box class="actual-denominator course-diagram__card-stack">
        <p>{labels.fields.actualWidth}</p>
        <InlineMath
          latex={String.raw`${trace.final.width}\times${trace.meta.context}=${trace.final.actualDenominator}`}
        />
        <strong>{labels.fields.denominator}</strong>
      </article>
    </div>
  </section>

  <section class="proof-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-proof`}>
    <h4 id={`${titleId}-proof`} class="course-diagram__card-heading">
      <span class="state-symbol" aria-hidden="true">4</span>
      {labels.stages.proof}
    </h4>
    <p>{labels.notes.proof}</p>
    <dl class="proof-grid course-diagram__grid" aria-label={labels.captions.proof}>
      <div>
        <dt>{labels.summary.completeWindows}</dt>
        <dd><InlineMath latex={trace.proof.coverage} /></dd>
      </div>
      <div>
        <dt>{labels.fields.duplicates}</dt>
        <dd><InlineMath latex={trace.proof.duplicates} /></dd>
      </div>
      <div>
        <dt>{labels.fields.padding}</dt>
        <dd><InlineMath latex={trace.proof.padding} /></dd>
      </div>
      <div>
        <dt>{labels.fields.crossPartition}</dt>
        <dd><InlineMath latex={trace.proof.crossPartition} /></dd>
      </div>
      <div>
        <dt>{labels.fields.sameSeed}</dt>
        <dd>{labels.symbols.same}</dd>
      </div>
      <div>
        <dt>{labels.fields.differentSeed}</dt>
        <dd>{labels.symbols.changed}</dd>
      </div>
      <div>
        <dt>{labels.fields.rawAccumulation}</dt>
        <dd>{labels.symbols.equal}</dd>
      </div>
    </dl>
  </section>
</figure>

<style>
  .shape-summary {
    --diagram-summary-min: 8.5rem;
  }

  .shuffle-list {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 7.5rem), 1fr));
    align-items: stretch;
  }

  .shuffle-list > li {
    display: grid;
    align-content: start;
    gap: 0.2rem;
  }

  .batch-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 35rem), 1fr));
    align-items: start;
  }

  .batch-card {
    min-inline-size: 0;
  }

  .batch-card.final-card {
    border-style: double !important;
    border-width: 3px !important;
  }

  .batch-table {
    inline-size: 100%;
    min-inline-size: 34rem;
    table-layout: fixed;
  }

  .batch-table th:first-child {
    inline-size: 7rem;
  }

  .batch-table :is(th, td):is(:nth-child(2), :nth-child(3)) {
    inline-size: 6rem;
  }

  .batch-table tbody th > :is(span, bdi) {
    display: block;
  }

  .loss-pair {
    display: grid;
    gap: 0.15rem;
  }

  .batch-comparison {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas:
      'shape target'
      'sum sum'
      'denominator accumulation'
      'mean mean'
      'gradient gradient';
  }

  .batch-comparison > [data-evidence-metric='shape'] {
    grid-area: shape;
  }

  .batch-comparison > [data-evidence-metric='target-count'] {
    grid-area: target;
  }

  .batch-comparison > [data-evidence-metric='loss-sum'] {
    grid-area: sum;
  }

  .batch-comparison > [data-evidence-metric='denominator'] {
    grid-area: denominator;
  }

  .batch-comparison > [data-evidence-metric='mean-loss'] {
    grid-area: mean;
  }

  .batch-comparison > [data-evidence-metric='mean-gradient'] {
    grid-area: gradient;
  }

  .batch-comparison > [data-evidence-metric='accumulation'] {
    grid-area: accumulation;
  }

  .unused-slot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-style: dashed !important;
    border-width: 2px !important;
  }

  .denominator-contrast {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: 0.75rem;
  }

  .capacity-denominator {
    border-style: dashed !important;
    border-width: 2px !important;
  }

  .actual-denominator {
    border-style: double !important;
    border-width: 3px !important;
  }

  .contrast-arrow {
    align-self: center;
  }

  .proof-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
  }

  @container course-diagram (max-width: 36rem) {
    .shuffle-list,
    .batch-grid,
    .batch-comparison,
    .proof-grid,
    .denominator-contrast {
      grid-template-columns: minmax(0, 1fr);
    }

    .batch-comparison {
      grid-template-areas:
        'shape'
        'target'
        'sum'
        'denominator'
        'mean'
        'gradient'
        'accumulation';
    }

    .unused-slot {
      align-items: start;
      flex-direction: column;
    }

    .contrast-arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
  }

  @media (min-width: 64rem) and (min-height: 36rem) {
    .mini-batches-diagram:fullscreen {
      grid-template-columns: minmax(17rem, 0.7fr) minmax(21rem, 1.05fr) minmax(20rem, 1.25fr);
      grid-template-areas:
        'caption caption caption'
        'summary summary summary'
        'batches batches batches'
        'shuffle final proof';
      align-items: start;
    }

    figure.mini-batches-diagram.mini-batches-diagram:fullscreen {
      row-gap: 0.25rem;
    }

    .mini-batches-diagram:fullscreen > figcaption {
      grid-area: caption;
    }

    .mini-batches-diagram:fullscreen > .shape-summary {
      grid-area: summary;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .mini-batches-diagram:fullscreen > .shape-summary > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.5rem;
    }

    .mini-batches-diagram:fullscreen > .shape-summary > div > dd {
      margin: 0;
    }

    .mini-batches-diagram:fullscreen > :global(.diagram-full-view-actions) {
      grid-column: 3;
      grid-row: 1;
      align-self: start;
      justify-self: end;
    }

    .mini-batches-diagram:fullscreen > .shuffle-stage {
      grid-area: shuffle;
    }

    .mini-batches-diagram:fullscreen > .batches-stage {
      grid-area: batches;
    }

    .mini-batches-diagram:fullscreen > .final-stage {
      grid-area: final;
    }

    .mini-batches-diagram:fullscreen > .proof-stage {
      grid-area: proof;
      gap: 0.25rem;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'heading'
        'note'
        'evidence';
      align-items: start;
    }

    .mini-batches-diagram:fullscreen > .proof-stage > h4 {
      grid-area: heading;
    }

    .mini-batches-diagram:fullscreen > .proof-stage > p {
      grid-area: note;
    }

    .mini-batches-diagram:fullscreen > .proof-stage > .proof-grid {
      grid-area: evidence;
    }

    .mini-batches-diagram:fullscreen .batch-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mini-batches-diagram:fullscreen > .batches-stage {
      grid-template-columns: minmax(32rem, 0.7fr) minmax(0, 1fr);
      grid-template-areas:
        'heading note'
        'grid grid'
        'comparison comparison';
    }

    .mini-batches-diagram:fullscreen > .batches-stage > h4 {
      grid-area: heading;
    }

    .mini-batches-diagram:fullscreen > .batches-stage > p {
      grid-area: note;
    }

    .mini-batches-diagram:fullscreen > .batches-stage > .batch-grid {
      grid-area: grid;
    }

    .mini-batches-diagram:fullscreen > .batches-stage > .batch-comparison {
      grid-area: comparison;
    }

    .mini-batches-diagram:fullscreen .batch-table {
      min-inline-size: 0;
    }

    .mini-batches-diagram:fullscreen .loss-pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mini-batches-diagram:fullscreen .batch-comparison {
      grid-template-columns: repeat(11, minmax(0, 1fr));
      grid-template-areas:
        'shape shape target sum denominator mean mean gradient gradient accumulation accumulation';
      gap: 0.25rem var(--diagram-gap);
    }

    .mini-batches-diagram:fullscreen .batch-comparison > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: 0.2rem 0.5rem;
    }

    .mini-batches-diagram:fullscreen .batch-comparison > div > dt {
      grid-column: 1 / -1;
    }

    .mini-batches-diagram:fullscreen .proof-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .mini-batches-diagram:fullscreen .proof-grid > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 0.25rem;
    }

    .mini-batches-diagram:fullscreen .denominator-contrast article {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }

    .mini-batches-diagram:fullscreen .denominator-contrast article > p {
      grid-column: 1 / -1;
    }

    .mini-batches-diagram:fullscreen .shuffle-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .mini-batches-diagram:fullscreen .shuffle-list > li {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
    }

    .mini-batches-diagram:fullscreen .shuffle-list > li > .ordinal {
      grid-column: auto;
    }
  }
</style>
