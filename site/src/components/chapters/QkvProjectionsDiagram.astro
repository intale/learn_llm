---
import traceSource from '../../../../rust/demos/ch26-qkv-projections/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  parseQkvProjectionsTrace,
  validateQkvProjectionsLabels,
  type QkvProjectionsDiagramLabels,
  type QkvRole,
} from '../../lib/qkv-projections-diagram';

interface Props {
  labels: QkvProjectionsDiagramLabels;
}

const { labels } = Astro.props;
validateQkvProjectionsLabels(labels);
const trace = parseQkvProjectionsTrace(traceSource);
const titleId = 'qkv-projections-diagram-title';
const descriptionId = 'qkv-projections-diagram-description';
const roleLabels: Record<QkvRole, string> = labels.roles;
const roleSymbols: Record<QkvRole, { weight: string; output: string }> = {
  query: { weight: 'W_Q', output: 'Q' },
  key: { weight: 'W_K', output: 'K' },
  value: { weight: 'W_V', output: 'V' },
};
const cueLabels: Record<QkvRole, string> = {
  query: labels.cues.query,
  key: labels.cues.key,
  value: labels.cues.value,
};
const localizedErrorReasons: Record<string, string> = {
  'rank-two': labels.errorReasons.rankTwo,
  'input-width': labels.errorReasons.inputWidth,
  'branch-mismatch': labels.errorReasons.branchMismatch,
};
const changedStatus = (value: string) => value === 'true' ? labels.cues.changed : labels.cues.unchanged;
const unchangedStatus = (value: string) => value === 'bitwise-unchanged' ? labels.cues.unchanged : labels.cues.changed;
const inputGradientRows = [
  trace.backward.inputGradient.values.slice(0, 3),
  trace.backward.inputGradient.values.slice(3, 6),
];
const inputGradientMatrix = String.raw`\begin{bmatrix}${inputGradientRows
  .map((row) => row.join('&'))
  .join(String.raw`\\`)}\end{bmatrix}`;
---

<figure
  class="course-diagram qkv-diagram"
  data-diagram-style="course-v1"
  data-visualization-id="qkv-projections"
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description course-diagram__description">{labels.description}</p>
    <ul class="cue-list" aria-label={labels.captions.projections}>
      <li data-diagram-box class="shared-cue">{labels.cues.shared}</li>
      <li data-diagram-box class="query-cue">{labels.cues.query}</li>
      <li data-diagram-box class="key-cue">{labels.cues.key}</li>
      <li data-diagram-box class="value-cue">{labels.cues.value}</li>
    </ul>
  </figcaption>

  <section class="diagram-section projection-section course-diagram__card-stack" data-diagram-box aria-labelledby="qkv-projection-title">
    <h4 id="qkv-projection-title">{labels.sections.projections}</h4>
    <article data-diagram-card data-diagram-box class="source-card course-diagram__card-stack" data-stage="input">
      <h5>{labels.stages.input}</h5>
      <div
        class="source-values math-row input-values-scroller course-diagram__scroll"
        tabindex="0"
        role="region"
        aria-label={labels.stages.input}
        data-diagram-scroll>
        <InlineMath latex={String.raw`X=${trace.input.latex}`} />
      </div>
      <dl>
        <div>
          <dt>{labels.fields.shape}</dt>
          <dd><InlineMath latex={String.raw`\operatorname{shape}(X)=${trace.meta.inputShape}`} /></dd>
        </div>
        <div>
          <dt>{labels.fields.biasPolicy}</dt>
          <dd><code><bdi dir="ltr">bias={trace.meta.bias}</bdi></code></dd>
        </div>
      </dl>
    </article>

    <div class="split-marker" aria-hidden="true">&darr;</div>

    <div
      class="branches-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.branches}
      data-diagram-scroll>
      <ol class="branch-grid course-diagram__grid">
        {trace.projections.map((projection) => (
          <li>
            <article data-diagram-card data-diagram-box
              class:list={['branch-card', 'course-diagram__card-stack', `${projection.role}-branch`]}
              data-qkv-role={projection.role}
            >
              <header>
                <span data-diagram-box class:list={['branch-cue', 'state-symbol', `${projection.role}-cue`]}>
                  {cueLabels[projection.role]}
                </span>
                <h5>{labels.stages[projection.role]}</h5>
                <p class="course-diagram__description">{roleLabels[projection.role]}</p>
                <p class="branch-formula">
                  <InlineMath
                    latex={String.raw`${roleSymbols[projection.role].output}=X${roleSymbols[projection.role].weight}`}
                  />
                </p>
              </header>

              <dl class="branch-facts">
                <div>
                  <dt>{labels.fields.parameter}</dt>
                  <dd><code><bdi dir="ltr">{projection.parameter}</bdi></code></dd>
                </div>
                <div>
                  <dt>{labels.fields.weight}</dt>
                  <dd>
                    <InlineMath
                      latex={String.raw`\operatorname{shape}(${roleSymbols[projection.role].weight})=${projection.weightShape}`}
                    />
                  </dd>
                </div>
                <div>
                  <dt>{labels.fields.output}</dt>
                  <dd>
                    <InlineMath
                      latex={String.raw`\operatorname{shape}(${roleSymbols[projection.role].output})=${projection.outputShape}`}
                    />
                  </dd>
                </div>
              </dl>

              <table data-diagram-table class="coordinate-table weight-table">
                <caption><InlineMath latex={roleSymbols[projection.role].weight} /></caption>
                <thead>
                  <tr>
                    <th scope="col"></th>
                    <th scope="col"><InlineMath latex="0" /></th>
                    <th scope="col"><InlineMath latex="1" /></th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row"><InlineMath latex="0" /></th>
                    <td><InlineMath latex={projection.weights.values[0]} /></td>
                    <td><InlineMath latex={projection.weights.values[1]} /></td>
                  </tr>
                  <tr>
                    <th scope="row"><InlineMath latex="1" /></th>
                    <td><InlineMath latex={projection.weights.values[2]} /></td>
                    <td><InlineMath latex={projection.weights.values[3]} /></td>
                  </tr>
                  <tr>
                    <th scope="row"><InlineMath latex="2" /></th>
                    <td><InlineMath latex={projection.weights.values[4]} /></td>
                    <td><InlineMath latex={projection.weights.values[5]} /></td>
                  </tr>
                </tbody>
              </table>

              <table data-diagram-table class="coordinate-table output-table">
                <caption>{labels.fields.output}</caption>
                <thead>
                  <tr>
                    <th scope="col"></th>
                    <th scope="col"><InlineMath latex="0" /></th>
                    <th scope="col"><InlineMath latex="1" /></th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row"><InlineMath latex="t_0" /></th>
                    <td><InlineMath latex={projection.output.values[0]} /></td>
                    <td><InlineMath latex={projection.output.values[1]} /></td>
                  </tr>
                  <tr>
                    <th scope="row"><InlineMath latex="t_1" /></th>
                    <td><InlineMath latex={projection.output.values[2]} /></td>
                    <td><InlineMath latex={projection.output.values[3]} /></td>
                  </tr>
                </tbody>
              </table>
            </article>
          </li>
        ))}
      </ol>
    </div>
    <p class="section-caption course-diagram__description">{labels.captions.projections}</p>
  </section>

  <section class="diagram-section history-section course-diagram__card-stack" data-diagram-box aria-labelledby="qkv-history-title">
    <h4 id="qkv-history-title">{labels.sections.history}</h4>
    <div
      class="history-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.history}
      data-diagram-scroll>
      <table data-diagram-table class="history-table">
        <caption>{labels.captions.history}</caption>
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col">{labels.fields.decoderState}</th>
            <th scope="col">{labels.fields.encoderAnnotations}</th>
            <th scope="col">{labels.fields.oneSequence}</th>
          </tr>
        </thead>
        <tbody>
          <tr data-history-kind="earlier-attention">
            <th scope="row">{labels.fields.earlierAttention}</th>
            <td><code><bdi dir="ltr">{trace.history.earlierLeft}</bdi></code></td>
            <td><code><bdi dir="ltr">{trace.history.earlierRight}</bdi></code></td>
            <td aria-label={labels.cues.notUsed}>&mdash;</td>
          </tr>
          <tr data-history-kind="self-attention">
            <th scope="row">{labels.fields.selfAttention}</th>
            <td aria-label={labels.cues.notUsed}>&mdash;</td>
            <td aria-label={labels.cues.notUsed}>&mdash;</td>
            <td><code><bdi dir="ltr">{trace.history.transformerSource}</bdi></code></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="course-diagram__description">{labels.captions.history}</p>
  </section>

  <section class="diagram-section evidence-section course-diagram__card-stack" data-diagram-box aria-labelledby="qkv-evidence-title">
    <h4 id="qkv-evidence-title">{labels.sections.evidence}</h4>
    <div class="evidence-grid course-diagram__grid">
      <article data-diagram-card data-diagram-box class="evidence-card input-gradient-card course-diagram__card-stack">
        <h5>{labels.fields.inputGradient}</h5>
        <p
          class="math-row input-gradient-scroller course-diagram__scroll"
          tabindex="0"
          role="region"
          aria-label={labels.fields.inputGradient}
          data-diagram-scroll>
          <span class="input-gradient-matrix">
            <InlineMath latex={String.raw`\bar X=${inputGradientMatrix}`} />
          </span>
        </p>
        <p><InlineMath latex={String.raw`\operatorname{shape}(\bar X)=${trace.backward.inputGradientShape}`} /></p>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card gradient-card course-diagram__card-stack">
        <h5>{labels.fields.weightGradient}</h5>
        <div
          class="gradients-scroller course-diagram__scroll"
          tabindex="0"
          role="region"
          aria-label={labels.scrollers.gradients}
          data-diagram-scroll>
          <table data-diagram-table class="gradient-table">
            <tbody>
              {trace.weightGradients.map((gradient) => (
                <tr data-gradient-role={gradient.role}>
                  <th scope="row">{roleLabels[gradient.role]}</th>
                  <td>
                    <InlineMath
                      latex={String.raw`\bar ${roleSymbols[gradient.role].weight}=${gradient.values.latex}`}
                    />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card independence-card course-diagram__card-stack">
        <h5>{labels.fields.independence}</h5>
        <dl>
          <div>
            <dt>{labels.roles.query}</dt>
            <dd><span data-diagram-box class:list={['state-symbol', trace.independence.queryChanged === 'true' ? 'accepted' : 'rejected']}>{changedStatus(trace.independence.queryChanged)}</span></dd>
          </div>
          <div>
            <dt>{labels.roles.key}</dt>
            <dd><span data-diagram-box class:list={['state-symbol', trace.independence.keyOutput === 'bitwise-unchanged' ? 'accepted' : 'rejected']}>{unchangedStatus(trace.independence.keyOutput)}</span></dd>
          </div>
          <div>
            <dt>{labels.roles.value}</dt>
            <dd><span data-diagram-box class:list={['state-symbol', trace.independence.valueOutput === 'bitwise-unchanged' ? 'accepted' : 'rejected']}>{unchangedStatus(trace.independence.valueOutput)}</span></dd>
          </div>
        </dl>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card empty-card course-diagram__card-stack">
        <h5>{labels.fields.emptyBatch}</h5>
        <p><InlineMath latex={String.raw`${trace.emptyShapes.batchInput}\to ${trace.emptyShapes.batchQuery},${trace.emptyShapes.batchKey},${trace.emptyShapes.batchValue}`} /></p>
        <h5>{labels.fields.emptyTokens}</h5>
        <p><InlineMath latex={String.raw`${trace.emptyShapes.tokenInput}\to ${trace.emptyShapes.tokenQuery},${trace.emptyShapes.tokenKey},${trace.emptyShapes.tokenValue}`} /></p>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card errors-card course-diagram__card-stack">
        <h5>{labels.fields.errors}</h5>
        <ul>
          {trace.errors.map((error) => (
            <li data-error-case={error.case}>
              <span data-diagram-box class="state-symbol rejected">{labels.cues.rejected}</span>
              <code><bdi dir="ltr">{error.case}</bdi></code>
              <span>{localizedErrorReasons[error.case]}</span>
            </li>
          ))}
        </ul>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card proof-card course-diagram__card-stack">
        <h5>{labels.fields.proof}</h5>
        <p><InlineMath latex={String.raw`n_X=${trace.proof.inputChecks}, n_Q=${trace.proof.queryWeightChecks}, n_K=${trace.proof.keyWeightChecks}, n_V=${trace.proof.valueWeightChecks}`} /></p>
        <p><InlineMath latex={String.raw`\tau=${trace.proof.tolerance}`} /></p>
        <p>
          <code><bdi dir="ltr">gradcheck={trace.proof.gradcheck}</bdi></code>
          <code><bdi dir="ltr">replay={trace.proof.replay}</bdi></code>
          <code><bdi dir="ltr">names={trace.proof.names}</bdi></code>
          <code><bdi dir="ltr">initialization={trace.proof.initialization}</bdi></code>
        </p>
      </article>
    </div>
    <p class="section-caption course-diagram__description">{labels.captions.evidence}</p>
  </section>
</figure>

<style>
  .key-cue {
    border-style: dashed;
  }

  .value-cue {
    border-style: double;
    border-width: 4px;
  }

  .source-card {
    border-block-start-width: 4px;
  }

  .source-card dl,
  .branch-facts,
  .independence-card dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.65rem;
    margin: 0;
  }

  .source-card dl div,
  .branch-facts div,
  .independence-card dl div {
    min-inline-size: 0;
  }

  .split-marker {
    color: var(--diagram-accent-dark);
    text-align: center;
    font-size: 1.5rem;
    font-weight: 800;
  }

  .input-values-scroller {
    direction: ltr;
  }

  .branch-grid {
    grid-template-columns: repeat(3, minmax(18.5rem, 1fr));
    align-items: start;
    min-inline-size: 57rem;
  }

  .branch-grid > li {
    min-inline-size: 0;
  }

  .branch-card {
    border-block-start-width: 4px;
  }

  .query-branch {
    border-style: solid;
  }

  .key-branch {
    border-style: dashed;
  }

  .value-branch {
    border-style: double;
    border-width: 4px;
  }

  .branch-card header {
    display: grid;
    align-items: start;
    gap: 0.45rem;
  }

  .branch-cue {
    justify-self: start;
    font-size: 0.82rem;
  }

  .branch-formula,
  .math-row {
    min-inline-size: 0;
    margin: 0;
  }

  .coordinate-table {
    direction: ltr;
    inline-size: 100%;
    margin-block-start: 0.25rem;
  }

  .coordinate-table caption,
  .history-table caption {
    padding-block-end: 0.45rem;
    text-align: start;
    font-weight: 700;
  }

  .history-table {
    inline-size: 100%;
    min-inline-size: 48rem;
  }

  .history-table tbody tr:last-child {
    border-block-style: double;
    border-block-width: 4px;
  }

  .evidence-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: start;
  }

  .input-gradient-card,
  .gradient-card,
  .errors-card,
  .proof-card {
    grid-column: 1 / -1;
  }

  .input-gradient-matrix {
    display: inline-block;
    min-inline-size: 32rem;
  }

  .gradient-table {
    min-inline-size: 44rem;
  }

  .independence-card dl {
    grid-template-columns: 1fr;
  }

  .errors-card ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .errors-card li {
    display: grid;
    grid-template-columns: auto minmax(7rem, 0.35fr) minmax(14rem, 1fr);
    align-items: start;
    gap: 0.6rem;
    min-inline-size: 0;
  }

  .proof-card p:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .rejected {
    --diagram-state-symbol-border-style: double;
  }

  :global([data-inline-math]) {
    direction: ltr;
    unicode-bidi: isolate;
  }

  @container course-diagram (max-width: 42rem) {
    .errors-card li {
      grid-template-columns: 1fr;
    }
  }
</style>
