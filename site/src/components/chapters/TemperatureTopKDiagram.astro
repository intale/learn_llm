---
import traceSource from '../../../../rust/demos/ch36-temperature-top-k/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  parseTemperatureTopKTrace,
  validateTemperatureTopKDiagramLabels,
  type TemperatureTopKDiagramLabels,
} from '../../lib/temperature-top-k-diagram';

interface Props {
  labels: TemperatureTopKDiagramLabels;
}

const { labels } = Astro.props;
validateTemperatureTopKDiagramLabels(labels);
const trace = parseTemperatureTopKTrace(traceSource);
const titleId = 'temperature-top-k-diagram-title';
const descriptionId = 'temperature-top-k-diagram-description';
const temperatureLabels = [
  labels.temperatures.cold,
  labels.temperatures.neutral,
  labels.temperatures.warm,
] as const;
const supportProbabilities = trace.support.probabilities.slice(1, -1).split(',');
const supportRetainedIds = trace.support.retained.slice(1, -1).split(',');
const positiveSupportIds = trace.support.positive_support.slice(1, -1).split(',');
if (
  supportProbabilities.length !== 3 ||
  supportRetainedIds.length !== 3 ||
  positiveSupportIds.length !== 2
) {
  throw new Error('Chapter 36 support evidence has an unexpected cardinality');
}
const supportTokens = supportProbabilities.map((probability, index) => {
  const id = String(index);
  return {
    id,
    probability,
    retained: supportRetainedIds.includes(id),
    inPositiveSupport: positiveSupportIds.includes(id),
  };
});
const zeroProbability = supportProbabilities[2] as string;
---

<figure
  class="course-diagram temperature-top-k-diagram"
  data-diagram-style="course-v1"
  data-visualization-id="temperature-top-k"
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
    <ul class="cue-list" aria-label={labels.cues.legend}>
      <li><span aria-hidden="true">✓</span> {labels.cues.retained}</li>
      <li><span aria-hidden="true">×</span> {labels.cues.removed}</li>
      <li><span aria-hidden="true">→</span> {labels.cues.selected}</li>
    </ul>
  </figcaption>

  <section aria-labelledby="temperature-comparison-title">
    <h4 id="temperature-comparison-title">{labels.sections.temperature}</h4>
    <p
      class="fixture-label"
      data-fixture="synthetic"
      data-vocabulary={trace.input.vocabulary}
    >
      <strong>{labels.fixtures.synthetic}</strong>
      <InlineMath latex={`V=${trace.input.vocabulary}`} />
    </p>
    <p>{labels.captions.temperature}</p>
    <div class="temperature-grid">
      {trace.temperatures.map((scenario, scenarioIndex) => (
        <article
          class="temperature-card"
          data-diagram-card
          data-diagram-box
          data-temperature={scenario.tau}
        >
          <h5>{temperatureLabels[scenarioIndex]}</h5>
          <p><InlineMath latex={`\\tau=${scenario.tau}`} /></p>
          <ol class="probability-list">
            {scenario.tokens.map((token) => (
              <li data-token-id={token.id} data-probability={token.probability}>
                <span class="probability-label">
                  <InlineMath latex={`i=${token.id}`} />
                  <InlineMath latex={`\\widehat q_i=${token.probability}`} />
                </span>
                <span
                  class="probability-track"
                  data-probability-track
                  aria-hidden="true"
                >
                  <span
                    class="probability-fill"
                    data-probability-fill
                    data-probability-percent={token.percent}
                    style={`--probability-percent: ${token.percent}%`}
                  ></span>
                </span>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="top-k-boundary-title">
    <h4 id="top-k-boundary-title">{labels.sections.topK}</h4>
    <p>{labels.captions.topK}</p>
    <div
      class="top-k-region course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.topK}
      data-diagram-scroll
    >
      <table class="top-k-table" data-diagram-table>
        <caption>{labels.scrollers.topK}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.token}</th>
            <th scope="col">{labels.fields.logit}</th>
            <th scope="col">{labels.fields.rank}</th>
            <th scope="col">{labels.fields.status}</th>
            <th scope="col">{labels.fields.probability}</th>
          </tr>
        </thead>
        <tbody>
          {trace.topK.tokens.map((token) => (
            <tr
              data-top-k-token={token.id}
              data-retained={token.retained}
              data-state={token.retained === 'true' ? 'retained' : 'removed'}
            >
              <th scope="row"><InlineMath latex={`i=${token.id}`} /></th>
              <td><InlineMath latex={`\\ell_i=${token.logit}`} /></td>
              <td><InlineMath latex={`r_i=${token.rank}`} /></td>
              <td>
                <span class="state-symbol" aria-hidden="true">
                  {token.retained === 'true' ? '✓' : '×'}
                </span>
                {token.retained === 'true' ? labels.cues.retained : labels.cues.removed}
              </td>
              <td><InlineMath latex={`\\widehat q_i=${token.probability}`} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="positive-support-title">
    <h4 id="positive-support-title">{labels.sections.support}</h4>
    <p>
      {labels.captions.supportLead}{' '}
      <InlineMath latex={String.raw`[\ell_0,\ell_1,\ell_2]=[2,2,1]`} />{', '}
      {labels.captions.supportMiddle}{' '}
      <InlineMath latex="k=3" />{', '}
      {labels.captions.supportTail}
    </p>
    <article
      class="support-card"
      data-diagram-card
      data-diagram-box
      data-support-evidence
      data-top-k={trace.support.top_k}
      data-retained={trace.support.retained}
      data-positive-support={trace.support.positive_support}
    >
      <h5>{labels.fixtures.underflow}</h5>
      <code><bdi dir="ltr">tau={trace.support.tau}</bdi></code>
      <p>
        <strong>{labels.fields.retainedSet}</strong>
        <InlineMath
          latex={String.raw`K_${trace.support.top_k}=\{${trace.support.retained.slice(1, -1)}\}`}
        />
      </p>
      <p>
        <strong>{labels.fields.positiveSupport}</strong>
        <InlineMath
          latex={`S_{\\tau,${trace.support.top_k}}^{(\\mathrm{f64})}=\\{${trace.support.positive_support.slice(1, -1)}\\}`}
        />
      </p>
      <ol class="support-list">
        {supportTokens.map((token) => (
          <li
            data-support-token={token.id}
            data-retained={String(token.retained)}
            data-positive-support={String(token.inPositiveSupport)}
            data-probability={token.probability}
          >
            <span class="support-fact">
              <strong>{labels.fields.token}</strong>
              <InlineMath latex={`i=${token.id}`} />
            </span>
            <span class="support-fact">
              <strong>{labels.fields.retainedSet}</strong>
              <span aria-hidden="true">✓</span> {labels.cues.rankRetained}
            </span>
            <span class="support-fact">
              <strong>{labels.fields.probability}</strong>
              <InlineMath
                latex={`\\widehat q_${token.id}^{(\\tau,${trace.support.top_k})}=${token.probability}`}
              />
            </span>
            <span class="support-fact">
              <strong>{labels.fields.positiveSupport}</strong>
              {token.inPositiveSupport
                ? labels.cues.inSupport
                : labels.cues.outsideSupport}
            </span>
          </li>
        ))}
      </ol>
      <p>
        <InlineMath
          latex={`\\widehat q_2^{(\\tau,${trace.support.top_k})}=${zeroProbability}`}
        />
        — {labels.cues.retainedZero}
      </p>
    </article>
  </section>

  <section aria-labelledby="seeded-draws-title">
    <h4 id="seeded-draws-title">{labels.sections.draws}</h4>
    <p>{labels.captions.draws}</p>
    <div
      class="draw-policy"
      data-draw-policy
      data-fixture="synthetic"
      data-vocabulary={trace.drawPolicy.vocabulary}
      data-top-k={trace.drawPolicy.top_k}
      data-seed={trace.drawPolicy.seed}
    >
      <strong>{labels.fixtures.synthetic}</strong>
      <InlineMath
        latex={`\\tau=${trace.drawPolicy.tau},\\ k=${trace.drawPolicy.top_k},\\ V=${trace.drawPolicy.vocabulary}`}
      />
      <code><bdi dir="ltr">seed={trace.drawPolicy.seed}</bdi></code>
      <code><bdi dir="ltr">retained={trace.drawPolicy.retained}</bdi></code>
      <code><bdi dir="ltr">sum={trace.drawPolicy.sum}</bdi></code>
    </div>
    <ol class="draw-list">
      {trace.draws.map((draw) => (
        <li data-draw-index={draw.index} data-selected-token={draw.token}>
          <strong>{labels.fields.draw} {Number(draw.index) + 1}</strong>
          <InlineMath latex={`u=${draw.unit}`} />
          <span aria-hidden="true">→</span>
          <span>{labels.fields.interval}</span>
          <InlineMath
            latex={String.raw`[${draw.interval_start},${draw.interval_end})`}
          />
          <span>{labels.fields.selectedToken}</span>
          <InlineMath latex={`i=${draw.token}`} />
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="generation-proof-title">
    <h4 id="generation-proof-title">{labels.sections.generation}</h4>
    <p>{labels.captions.generation}</p>
    <p
      class="fixture-label"
      data-fixture="checkpoint"
      data-vocabulary={trace.loaded.vocabulary}
    >
      <strong>{labels.fixtures.checkpoint}</strong>
      <InlineMath latex={`V=${trace.loaded.vocabulary}`} />
      <span>
        <strong>{labels.fields.contextCapacity}</strong>
        <code><bdi dir="ltr">context={trace.loaded.context}</bdi></code>
      </span>
    </p>
    <div class="proof-grid">
      <article class="proof-card" data-diagram-card data-diagram-box data-status="pass" data-proof="greedy">
        <h5>{labels.proofs.greedy}</h5>
        <p><InlineMath latex={`i=${trace.greedy.token}`} /> — {labels.cues.greedy}</p>
        <code><bdi dir="ltr">draw={trace.greedy.draw}</bdi></code>
        <p>{labels.cues.noDraw}</p>
      </article>
      <article class="proof-card" data-diagram-card data-diagram-box data-status="pass" data-proof="loaded" data-eos-policy={trace.loaded.eos}>
        <h5>{labels.proofs.loaded}</h5>
        <p class="loaded-sequence" data-loaded-sequence>
          <span class="sequence-value" data-sequence-role="prompt">
            <strong>{labels.fields.prompt}</strong>
            <InlineMath latex={`[${trace.loaded.prompt.slice(1, -1)}]`} />
          </span>
          <span class="sequence-arrow" aria-hidden="true">→</span>
          <span class="sequence-value" data-sequence-role="generated">
            <strong>{labels.fields.generated}</strong>
            <InlineMath latex={`[${trace.loaded.generated.slice(1, -1)}]`} />
          </span>
        </p>
        <p>
          <strong>{labels.fields.eosToken}</strong>
          <code><bdi dir="ltr">eos={trace.loaded.eos}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.maxNewTokens}</strong>
          <code><bdi dir="ltr">max_new_tokens={trace.loaded.max_new_tokens}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.prefixLengths}</strong>
          <code><bdi dir="ltr">prefixes={trace.loaded.prefixes}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.fullPrefixCalls}</strong>
          <code><bdi dir="ltr">calls={trace.loaded.calls}</bdi></code>
        </p>
        <p>{labels.cues.contextStop}; {labels.cues.replayed}</p>
      </article>
      <article class="proof-card" data-diagram-card data-diagram-box data-status="pass" data-proof="eos" data-eos-policy={trace.eos.eos}>
        <h5>{labels.proofs.eos}</h5>
        <p><InlineMath latex={`i_{\\mathrm{EOS}}=${trace.eos.eos}`} /></p>
        <p>
          <strong>{labels.fields.eosToken}</strong>
          <code><bdi dir="ltr">eos={trace.eos.eos}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.maxNewTokens}</strong>
          <code><bdi dir="ltr">max_new_tokens={trace.eos.max_new_tokens}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.generated}</strong>
          <code><bdi dir="ltr">generated={trace.eos.generated}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.fullPrefixCalls}</strong>
          <code><bdi dir="ltr">calls={trace.eos.calls}</bdi></code>
        </p>
        <p>{labels.cues.eosStop}</p>
      </article>
      <article class="proof-card" data-diagram-card data-diagram-box data-status="pass" data-proof="errors">
        <h5>{labels.proofs.errors}</h5>
        <code><bdi dir="ltr">temperature_zero={trace.errors.temperature_zero}</bdi></code>
        <code><bdi dir="ltr">top_k_zero={trace.errors.top_k_zero}</bdi></code>
        <code><bdi dir="ltr">nonfinite_logit={trace.errors.nonfinite_logit}</bdi></code>
        <code><bdi dir="ltr">rng_unchanged={trace.errors.rng_unchanged}</bdi></code>
        <p>{labels.cues.validErrors}</p>
      </article>
    </div>
  </section>
</figure>

<style>
  .temperature-top-k-diagram,
  .temperature-top-k-diagram > *,
  .temperature-card,
  .probability-list,
  .probability-list > li,
  .top-k-region,
  .support-card,
  .support-list,
  .support-list > li,
  .support-fact,
  .loaded-sequence,
  .sequence-value,
  .draw-list,
  .draw-list > li,
  .proof-card {
    min-inline-size: 0;
  }

  .temperature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .temperature-card,
  .support-card,
  .proof-card {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }

  .temperature-card h5,
  .temperature-card p,
  .support-card h5,
  .support-card p,
  .proof-card h5,
  .proof-card p {
    margin: 0;
  }

  .fixture-label,
  .draw-policy {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.65rem;
  }

  .probability-list {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .probability-list > li {
    display: grid;
    gap: 0.2rem;
  }

  .probability-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 0.65rem;
  }

  .probability-track {
    display: block;
    block-size: 0.55rem;
    border-block-end: 0.2rem solid currentColor;
  }

  .probability-fill {
    display: block;
    inline-size: var(--probability-percent);
    block-size: 100%;
    border-block-end: 0.5rem double currentColor;
    color: var(--diagram-accent-dark);
  }

  .top-k-table {
    inline-size: max(100%, 36rem);
  }

  .top-k-table tr[data-retained='true'] > :first-child {
    border-inline-start-style: double;
    border-inline-start-width: 0.35rem;
  }

  .top-k-table tr[data-retained='false'] > :first-child {
    border-inline-start-style: dashed;
    border-inline-start-width: 0.2rem;
  }

  .support-list {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .support-list > li {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 0.8rem;
  }

  .support-fact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.4rem;
  }

  .loaded-sequence,
  .sequence-value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
  }

  .loaded-sequence {
    gap: 0.2rem 0.5rem;
  }

  .sequence-value {
    gap: 0.2rem 0.35rem;
  }

  .draw-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 1rem;
    margin: 0;
    padding-inline-start: 1.35rem;
  }

  .draw-list > li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.45rem;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.65rem;
  }

  @container course-diagram (max-width: 46rem) {
    .temperature-grid,
    .draw-list,
    .support-list > li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
