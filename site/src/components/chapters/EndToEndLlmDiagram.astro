---
import traceSource from '../../../../rust/demos/ch39-end-to-end-llm/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  endToEndLlmDiagramId,
  parseEndToEndLlmTrace,
  validateEndToEndLlmDiagramLabels,
  type EndToEndLlmDiagramLabels,
} from '../../lib/end-to-end-llm-diagram';

interface Props {
  labels: EndToEndLlmDiagramLabels;
}

const { labels } = Astro.props;
validateEndToEndLlmDiagramLabels(labels);
const trace = parseEndToEndLlmTrace(traceSource);
const titleId = 'end-to-end-llm-diagram-title';
const descriptionId = 'end-to-end-llm-diagram-description';
const [initial, selected] = trace.selection;
const visibleGeneratedText = trace.generation.text.replaceAll(' ', '␠');
---

<figure
  class="course-diagram end-to-end-llm-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={endToEndLlmDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
  </figcaption>

  <section aria-labelledby="end-to-end-pipeline-title">
    <h4 id="end-to-end-pipeline-title">{labels.sections.pipeline}</h4>
    <div class="course-diagram__card-stack">
      <p class="course-diagram__description">{labels.captions.pipeline}</p>
      <ol class="pipeline course-diagram__grid">
      <li
        class="stage-card course-diagram__card-stack"
        data-diagram-card
        data-diagram-box
        data-stage="data"
        data-stage-index="1"
      >
        <header class="course-diagram__card-heading"><strong aria-hidden="true">1</strong><h5>{labels.stages.data}</h5></header>
        <p>
          <strong>{labels.fields.documents}:</strong>
          <code><bdi dir="ltr">{trace.data.train}/{trace.data.validation}/{trace.data.test}</bdi></code>
        </p>
        <p class="technical">
          <code><bdi dir="ltr">{trace.data.checksum}</bdi></code>
        </p>
      </li>

      <li
        class="stage-card course-diagram__card-stack"
        data-diagram-card
        data-diagram-box
        data-stage="tokenizer"
        data-stage-index="2"
        data-state="trusted"
      >
        <header class="course-diagram__card-heading"><strong aria-hidden="true">2</strong><h5>{labels.stages.tokenizer}</h5></header>
        <p class="cue">= {labels.cues.trainingOnly}</p>
        <p>
          <strong>{labels.fields.vocabulary}:</strong>
          <code><bdi dir="ltr">{trace.tokenizer.vocabulary}</bdi></code>
        </p>
        <dl class="stage-facts course-diagram__grid">
          <div data-evidence="encoded-token-counts">
            <dt>{labels.fields.encodedTokens}</dt>
            <dd><code><bdi dir="ltr">[{trace.tokenizer.encoded.join(',')}]</bdi></code></dd>
          </div>
        </dl>
      </li>

      <li
        class="stage-card course-diagram__card-stack"
        data-diagram-card
        data-diagram-box
        data-stage="batches"
        data-stage-index="3"
      >
        <header class="course-diagram__card-heading"><strong aria-hidden="true">3</strong><h5>{labels.stages.batches}</h5></header>
        <p>
          <strong>{labels.fields.context}:</strong>
          <InlineMath latex={'C=' + trace.batches.context} />
        </p>
        <p>
          <strong>{labels.fields.updateBatchSize} / {labels.fields.evaluationBatchSize}:</strong>
          <code><bdi dir="ltr">{trace.batches.update_batch_size}/{trace.batches.evaluation_batch_size}</bdi></code>
        </p>
        <dl class="stage-facts course-diagram__grid">
          <div data-evidence="window-counts">
            <dt>{labels.fields.windows}</dt>
            <dd><code><bdi dir="ltr">[{trace.batches.windows.join(',')}]</bdi></code></dd>
          </div>
          <div data-evidence="evaluation-batch-counts">
            <dt>{labels.fields.evaluationBatches}</dt>
            <dd><code><bdi dir="ltr">[{trace.batches.evaluation_batches.join(',')}]</bdi></code></dd>
          </div>
        </dl>
      </li>

      <li
        class="stage-card course-diagram__card-stack"
        data-diagram-card
        data-diagram-box
        data-stage="model"
        data-stage-index="4"
      >
        <header class="course-diagram__card-heading"><strong aria-hidden="true">4</strong><h5>{labels.stages.model}</h5></header>
        <p>
          <strong>{labels.fields.parameters}:</strong>
          <code><bdi dir="ltr">{trace.model.parameters}</bdi></code>
        </p>
        <p class="technical">
          <InlineMath latex={'L=' + trace.model.layers + ',\\ H=' + trace.model.heads + ',\\ D=' + trace.model.width} />
        </p>
      </li>

      <li
        class="stage-card selection-card course-diagram__card-stack"
        data-diagram-card
        data-diagram-box
        data-stage="selection"
        data-stage-index="5"
        data-state="trusted"
      >
        <header class="course-diagram__card-heading"><strong aria-hidden="true">5</strong><h5>{labels.stages.selection}</h5></header>
        <dl class="course-diagram__grid">
          <div class="course-diagram__card-stack">
            <dt>{labels.cues.candidate} <InlineMath latex={'s=' + initial.step} /></dt>
            <dd>
              <span>{labels.fields.trainLoss} <InlineMath latex={initial.train} /></span>
              <span>{labels.fields.validationLoss} <InlineMath latex={initial.validation} /></span>
            </dd>
          </div>
          <div class="selected-row course-diagram__card-stack">
            <dt>{labels.cues.selected} <InlineMath latex={'s=' + selected.step} /></dt>
            <dd>
              <span>{labels.fields.trainLoss} <InlineMath latex={selected.train} /></span>
              <span>{labels.fields.validationLoss} <InlineMath latex={selected.validation} /></span>
            </dd>
          </div>
        </dl>
      </li>

      <li
        class="stage-card course-diagram__card-stack"
        data-diagram-card
        data-diagram-box
        data-stage="test"
        data-stage-index="6"
        data-state="trusted"
      >
        <header class="course-diagram__card-heading"><strong aria-hidden="true">6</strong><h5>{labels.stages.test}</h5></header>
        <p class="cue">|| {labels.cues.oneTime}</p>
        <p>
          <strong>{labels.fields.targets}:</strong>
          <code><bdi dir="ltr">{trace.test.targets}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.decoderLoss}:</strong>
          <InlineMath latex={trace.test.decoder} />
        </p>
        <p>
          <strong>{labels.fields.bigramLoss}:</strong>
          <InlineMath latex={trace.test.bigram} />
        </p>
        <p class="cue">
          <span aria-hidden="true">✓</span>
          <InlineMath latex={trace.test.decoder + '<' + trace.test.bigram} />;
          {labels.fields.gap} <InlineMath latex={trace.test.gap} />
        </p>
      </li>

      <li
        class="stage-card course-diagram__card-stack"
        data-diagram-card
        data-diagram-box
        data-stage="checkpoint"
        data-stage-index="7"
        data-state="trusted"
      >
        <header class="course-diagram__card-heading"><strong aria-hidden="true">7</strong><h5>{labels.stages.checkpoint}</h5></header>
        <p class="cue">= {labels.cues.exact}</p>
        <p>
          <strong>{labels.fields.bytes}:</strong>
          <code><bdi dir="ltr">{trace.checkpoint.bytes}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.records}:</strong>
          <code><bdi dir="ltr">{trace.checkpoint.records}</bdi></code>
        </p>
        <dl class="stage-facts course-diagram__grid">
          <div data-evidence="reload-probe-text">
            <dt>{labels.fields.logitProbeText}</dt>
            <dd><code><bdi dir="ltr">{trace.checkpoint.logit_probe}</bdi></code></dd>
          </div>
          <div data-evidence="reload-probe-token-ids">
            <dt>{labels.fields.logitProbeTokenIds} <code><bdi dir="ltr">{trace.checkpoint.logit_probe}</bdi></code></dt>
            <dd><code><bdi dir="ltr">[{trace.checkpoint.logit_probe_ids.join(',')}]</bdi></code></dd>
          </div>
        </dl>
      </li>

      <li
        class="stage-card course-diagram__card-stack"
        data-diagram-card
        data-diagram-box
        data-stage="generation"
        data-stage-index="8"
        data-state="trusted"
      >
        <header class="course-diagram__card-heading"><strong aria-hidden="true">8</strong><h5>{labels.stages.generation}</h5></header>
        <p class="cue">= {labels.cues.cachedMatch}</p>
        <p>
          <strong>{labels.fields.prompt}:</strong>
          <code><bdi dir="ltr">{trace.generation.prompt} [{trace.generation.prompt_ids.join(',')}]</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.sampling}:</strong>
          <InlineMath latex={'\\tau=' + trace.generation.temperature + ',\\ k=' + trace.generation.top_k} />
          <code><bdi dir="ltr">seed={trace.generation.seed}</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.generated}:</strong>
          <code><bdi dir="ltr">[{trace.generation.generated.join(',')}]</bdi></code>
        </p>
        <p>
          <strong>{labels.fields.decoded}:</strong>
          <q aria-label={labels.cues.decodedText}><bdi dir="auto">{visibleGeneratedText}</bdi></q>
          <small>{labels.cues.spaceMarker}</small>
        </p>
        <dl class="stage-facts generation-facts course-diagram__grid">
          <div data-evidence="retained-prefix-lengths">
            <dt>{labels.fields.retainedPrefixLengths}</dt>
            <dd><code><bdi dir="ltr">[{trace.generation.prefixes.join(',')}]</bdi></code></dd>
          </div>
          <div data-evidence="cache-prefill-prompt-tokens">
            <dt>{labels.fields.cachePrefillPromptTokens}</dt>
            <dd><code><bdi dir="ltr">{trace.generation.prefill}</bdi></code></dd>
          </div>
          <div data-evidence="one-token-decode-input-tokens">
            <dt>{labels.fields.oneTokenDecodeInputTokens}</dt>
            <dd><code><bdi dir="ltr">{trace.generation.decode}</bdi></code></dd>
          </div>
          <div data-evidence="cached-attention-score-cells">
            <dt>{labels.fields.cachedAttentionScoreCells}</dt>
            <dd><InlineMath latex={`1+2+3=${trace.generation.cached_scores}`} /></dd>
          </div>
          <div data-evidence="complete-prefix-attention-score-cells">
            <dt>{labels.fields.completePrefixAttentionScoreCells}</dt>
            <dd><InlineMath latex={`1^2+2^2+3^2=${trace.generation.calculated_complete_prefix_scores}`} /></dd>
          </div>
        </dl>
      </li>
      </ol>
    </div>
  </section>

</figure>

<style>
  .pipeline {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stage-card header > strong {
    display: inline-grid;
    flex: 0 0 2rem;
    inline-size: 2rem;
    block-size: 2rem;
    place-items: center;
  }

  .stage-facts {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
  }

  .stage-facts > div {
    min-inline-size: 0;
  }

  .generation-facts {
    grid-column: 1 / -1;
  }

  .generation-facts
    > :is(
      [data-evidence='retained-prefix-lengths'],
      [data-evidence='cache-prefill-prompt-tokens'],
      [data-evidence='one-token-decode-input-tokens']
    ) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--diagram-gap);
  }

  .generation-facts
    > :is(
      [data-evidence='retained-prefix-lengths'],
      [data-evidence='cache-prefill-prompt-tokens'],
      [data-evidence='one-token-decode-input-tokens']
    )
    > dd {
    margin: 0;
  }

  .selection-card dd {
    display: grid;
    gap: 0.2rem;
    min-inline-size: 0;
    margin: 0;
  }

  .selected-row {
    border-inline-start: 0.28rem double currentColor;
    padding-inline-start: 0.55rem;
  }

  @container course-diagram (min-width: 68rem) {
    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']:fullscreen
      > figcaption {
      grid-template-columns: minmax(14rem, 0.45fr) minmax(0, 1fr);
      align-items: start;
    }

    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']:fullscreen
      > section {
      display: grid;
      grid-template-columns: minmax(14rem, 0.35fr) minmax(0, 1fr);
      gap: var(--diagram-gap);
    }

    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']:fullscreen
      > section > h4 {
      grid-column: 1;
      grid-row: 1;
    }

    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']:fullscreen
      > section > .course-diagram__card-stack {
      display: contents;
    }

    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']:fullscreen
      > section > .course-diagram__card-stack > p {
      grid-column: 2;
      grid-row: 1;
    }

    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']:fullscreen
      > section > .course-diagram__card-stack > .pipeline {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']
      .pipeline.course-diagram__grid {
      display: flex;
      flex-wrap: wrap;
    }

    .stage-card[data-stage='data'],
    .stage-card[data-stage='model'] {
      flex: 1 0 16%;
    }

    .stage-card[data-stage='tokenizer'] {
      flex: 1 0 19%;
    }

    .stage-card[data-stage='batches'] {
      flex: 1 0 23%;
    }

    .stage-card[data-stage='selection'] {
      flex: 1 0 20%;
    }

    .stage-card[data-stage='test'] {
      flex: 1 0 28%;
    }

    .stage-card[data-stage='checkpoint'] {
      flex: 1 0 22%;
    }

    .stage-card[data-stage='generation'] {
      flex: 1 0 45%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']:fullscreen
      :is([data-stage='batches'], [data-stage='checkpoint'])
      .stage-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']:fullscreen
      .generation-facts {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']:fullscreen
      .generation-facts
      > :is(
        [data-evidence='retained-prefix-lengths'],
        [data-evidence='cache-prefill-prompt-tokens'],
        [data-evidence='one-token-decode-input-tokens']
      ) {
      grid-column: span 2;
    }

    figure.course-diagram.end-to-end-llm-diagram[data-diagram-style='course-v1']:fullscreen
      .generation-facts
      > :is(
        [data-evidence='cached-attention-score-cells'],
        [data-evidence='complete-prefix-attention-score-cells']
      ) {
      grid-column: span 3;
    }

  }

  @container course-diagram (max-width: 42rem) {
    .pipeline {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (forced-colors: active) {
    .selected-row {
      border-color: CanvasText;
    }
  }
</style>
