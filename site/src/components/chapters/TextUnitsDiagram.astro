---
import {
  assertTextUnitsDiagramLabels,
  formatByteCount,
  textUnitsDiagramId,
  textUnitsExamples,
  type TextUnitsDiagramLabels,
} from '../../lib/text-units-diagram';

interface Props {
  labels: TextUnitsDiagramLabels;
  id?: string;
}

const { labels, id = textUnitsDiagramId } = Astro.props;
assertTextUnitsDiagramLabels(labels);

const titleId = `${id}-title`;
const descriptionId = `${id}-description`;
const stageLabels = [
  labels.stages.input,
  labels.stages.bytes,
  labels.stages.scalars,
  labels.stages.tokenIds,
];
---

<figure
  class="course-diagram text-units-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={textUnitsDiagramId}
  id={id}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p class="diagram-description course-diagram__description" id={descriptionId}>{labels.description}</p>
  </figcaption>

  <div class="diagram-examples course-diagram__grid">
    {
      textUnitsExamples.map((example) => {
        const exampleTitleId = `${id}-${example.id}-title`;
        return (
          <section class="diagram-example" aria-labelledby={exampleTitleId}>
            <h3 id={exampleTitleId}>{labels.examples[example.id]}</h3>
            <ol
              class="text-units-pipeline"
              aria-label={labels.pipelineLabel}
              dir="ltr"
            >
              <li class="pipeline-stage" data-stage="input" data-diagram-card data-diagram-box>
                <span class="stage-number state-symbol" aria-hidden="true">01</span>
                <h4 dir="auto">{stageLabels[0]}</h4>
                <ol class="unit-list" aria-label={stageLabels[0]}>
                  {
                    example.units.map((unit) => (
                      <li data-diagram-card data-diagram-box><code dir="ltr">{unit.value}</code></li>
                    ))
                  }
                </ol>
              </li>

              <li class="pipeline-stage" data-stage="bytes" data-diagram-card data-diagram-box>
                <span class="stage-number state-symbol" aria-hidden="true">02</span>
                <h4 dir="auto">{stageLabels[1]}</h4>
                <ol class="unit-list" aria-label={stageLabels[1]}>
                  {
                    example.units.map((unit) => (
                      <li data-diagram-card data-diagram-box>
                        <code class="byte-group" dir="ltr">
                          <span aria-hidden="true">[</span>
                          {unit.bytes.join(' ')}
                          <span aria-hidden="true">]</span>
                        </code>
                        <small dir="auto">
                          {formatByteCount(labels.byteCount, unit.bytes.length)}
                        </small>
                      </li>
                    ))
                  }
                </ol>
              </li>

              <li class="pipeline-stage" data-stage="scalars" data-diagram-card data-diagram-box>
                <span class="stage-number state-symbol" aria-hidden="true">03</span>
                <h4 dir="auto">{stageLabels[2]}</h4>
                <ol class="unit-list" aria-label={stageLabels[2]}>
                  {
                    example.units.map((unit) => (
                      <li data-diagram-card data-diagram-box>
                        <code dir="ltr">{unit.scalar}</code>
                        <small dir="ltr">{unit.value}</small>
                      </li>
                    ))
                  }
                </ol>
              </li>

              <li class="pipeline-stage" data-stage="token-ids" data-diagram-card data-diagram-box>
                <span class="stage-number state-symbol" aria-hidden="true">04</span>
                <h4 dir="auto">{stageLabels[3]}</h4>
                <ol class="unit-list" aria-label={stageLabels[3]}>
                  {
                    example.units.map((unit) => (
                      <li data-diagram-card data-diagram-box><code dir="ltr">{unit.tokenId}</code></li>
                    ))
                  }
                </ol>
              </li>
            </ol>
          </section>
        );
      })
    }
  </div>
</figure>

<style>
  .diagram-example {
    min-width: 0;
  }

  h3,
  h4 {
    margin: 0;
  }

  .text-units-pipeline,
  .unit-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .text-units-pipeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.35rem;
    margin-top: 0.75rem;
  }

  .pipeline-stage {
    position: relative;
  }

  .pipeline-stage:not(:last-child)::after {
    position: absolute;
    z-index: 1;
    top: 50%;
    inset-inline-start: calc(100% + 0.25rem);
    width: 0.85rem;
    content: "→";
    line-height: 1;
    text-align: center;
    transform: translateY(-50%);
  }

  .stage-number {
    margin-block-end: 0.35rem;
  }

  h4 {
    margin-block: 0;
  }

  .unit-list {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.8rem;
  }

  .unit-list > li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem;
  }

  small {
    text-align: end;
  }

  @container course-diagram (max-width: 44rem) {
    .text-units-pipeline {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .pipeline-stage:not(:last-child)::after {
      top: calc(100% + 0.2rem);
      inset-inline-start: 50%;
      content: "↓";
      transform: translateX(-50%);
    }

    .unit-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .unit-list > li {
      align-items: flex-start;
      flex-direction: column;
    }

    small {
      text-align: start;
    }
  }

  @container course-diagram (max-width: 28rem) {
    .unit-list {
      grid-template-columns: 1fr;
    }
  }

</style>
