---
// @ts-ignore Node APIs are available during Astro's build-only component execution.
import { readFile } from 'node:fs/promises';
// @ts-ignore Node APIs are available during Astro's build-only component execution.
import nodePath from 'node:path';

import {
  assertCorpusPartitionsDiagramLabels,
  corpusPartitionsDiagramId,
  createCorpusPartitionsDiagramData,
  type CorpusPartitionsDiagramLabels,
} from '../../lib/corpus-partitions-diagram';
import InlineMath from '../InlineMath.astro';

declare const process: { cwd(): string };

interface Props {
  labels: CorpusPartitionsDiagramLabels;
  id?: string;
}

const { labels, id = corpusPartitionsDiagramId } = Astro.props;
assertCorpusPartitionsDiagramLabels(labels);

const workingDirectory = nodePath.resolve(process.cwd());
const repositoryRoot =
  nodePath.basename(workingDirectory) === 'site'
    ? nodePath.dirname(workingDirectory)
    : workingDirectory;
const dataDirectory = nodePath.join(repositoryRoot, 'rust', 'data');
const [corpusSource, manifestSource] = await Promise.all([
  readFile(nodePath.join(dataDirectory, 'tiny-bilingual-corpus.json'), 'utf8'),
  readFile(nodePath.join(dataDirectory, 'splits.json'), 'utf8'),
]);
const partitions = createCorpusPartitionsDiagramData(
  JSON.parse(manifestSource) as unknown,
  corpusSource,
);
const assignedCount = partitions.reduce(
  (count, partition) => count + partition.documents.length,
  0,
);
const titleId = `${id}-title`;
const descriptionId = `${id}-description`;
---

<figure
  class="course-diagram corpus-partitions-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={corpusPartitionsDiagramId}
  id={id}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption" dir="auto">
    <h3 id={titleId}>{labels.title}</h3>
    <p class="diagram-description course-diagram__description" id={descriptionId} dir="auto">
    {labels.description}
  </p>
  </figcaption>

  <ul class="partition-grid course-diagram__grid" aria-label={labels.partitionListLabel}>
    {
      partitions.map((partition) => {
        const headingId = `${id}-${partition.role}-title`;
        return (
          <li data-diagram-card data-diagram-box class="partition-card" data-partition={partition.role}>
            <section class="course-diagram__card-stack" aria-labelledby={headingId}>
              <header class="course-diagram__card-heading">
                <code class="role-badge state-symbol" dir="ltr">{partition.badge}</code>
                <h3 id={headingId} dir="auto">
                  {labels.roles[partition.role].title}
                </h3>
              </header>
              <p class="partition-purpose" dir="auto">
                {labels.roles[partition.role].purpose}
              </p>
              <p class="document-count" data-document-count={partition.documents.length}>
                <span dir="auto">{labels.fields.documents}</span>
                <strong dir="ltr">{partition.documents.length}</strong>
              </p>
              <ol
                class="document-list"
                aria-label={labels.roles[partition.role].documentListLabel}
              >
                {partition.documents.map((document) => (
                  <li data-diagram-card data-diagram-box
                    class="document-card"
                    data-document-id={document.id}
                    data-language={document.language}
                    data-provenance-group={document.provenanceGroup}
                  >
                    <strong class="whole-document" dir="auto">
                      {labels.fields.wholeDocument}
                    </strong>
                    <dl>
                      <div>
                        <dt dir="auto">{labels.fields.documentId}</dt>
                        <dd><code dir="ltr">{document.id}</code></dd>
                      </div>
                      <div>
                        <dt dir="auto">{labels.fields.language}</dt>
                        <dd><code dir="ltr">{document.language}</code></dd>
                      </div>
                      <div>
                        <dt dir="auto">{labels.fields.provenanceGroup}</dt>
                        <dd><code dir="ltr">{document.provenanceGroup}</code></dd>
                      </div>
                    </dl>
                  </li>
                ))}
              </ol>
            </section>
          </li>
        );
      })
    }
  </ul>

  <div class="partition-summary" data-diagram-card data-diagram-box aria-live="off">
    <p>
      <span dir="auto">{labels.summary.assignedDocuments}</span>
      <strong data-assigned-count={assignedCount}>
        <InlineMath latex={String.raw`\frac{${assignedCount}}{${assignedCount}}`} />
      </strong>
    </p>
    <p>
      <span dir="auto">{labels.summary.repeatedIds}</span>
      <strong dir="ltr" data-repeated-count="0">0</strong>
    </p>
  </div>

  <ul class="partition-invariants" aria-label={labels.invariantsLabel}>
    <li data-invariant="complete" dir="auto">{labels.invariants.complete}</li>
    <li data-invariant="disjoint" dir="auto">{labels.invariants.disjoint}</li>
    <li data-invariant="provenance" dir="auto">{labels.invariants.provenance}</li>
  </ul>
</figure>

<style>
  .partition-grid,
  .document-list,
  .partition-invariants {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .partition-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .role-badge {
    flex: 0 0 auto;
  }

  .partition-purpose {
    min-height: 2.6em;
  }

  .document-count {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .document-list {
    display: grid;
    gap: 0.65rem;
    margin-block-start: 0.75rem;
  }

  .whole-document {
    display: block;
  }

  dl {
    display: grid;
    gap: 0.35rem;
    margin: 0.5rem 0 0;
  }

  dl > div {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 0.4rem;
  }

  dd {
    text-align: end;
  }

  .partition-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-block-start: 1.25rem;
  }

  .partition-summary p {
    display: flex;
    gap: 0.5rem;
    margin: 0;
  }

  .partition-invariants {
    display: grid;
    gap: 0.45rem;
    margin-block-start: 1rem;
  }

  .partition-invariants li::before {
    margin-inline-end: 0.45rem;
    content: "✓";
    font-weight: 800;
  }

  @container course-diagram (max-width: 44rem) {
    .partition-grid {
      grid-template-columns: 1fr;
    }

    .partition-purpose {
      min-height: 0;
    }
  }

  .corpus-partitions-diagram:fullscreen {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
  }

  .corpus-partitions-diagram:fullscreen > figcaption {
    grid-column: 1 / -1;
  }

  .corpus-partitions-diagram:fullscreen > .partition-grid {
    grid-column: 1 / -1;
  }

  .corpus-partitions-diagram:fullscreen .partition-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .corpus-partitions-diagram:fullscreen
    .partition-card[data-partition='train'] {
    grid-column: 1 / -1;
  }

  .corpus-partitions-diagram:fullscreen
    .partition-card
    > .course-diagram__card-stack {
    grid-template-columns: 8rem minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    column-gap: var(--diagram-gap);
  }

  .corpus-partitions-diagram:fullscreen
    .partition-card
    .course-diagram__card-heading {
    grid-column: 1;
    grid-row: 1;
  }

  .corpus-partitions-diagram:fullscreen .partition-purpose {
    grid-column: 1;
    grid-row: 2;
    min-height: 0;
  }

  .corpus-partitions-diagram:fullscreen .document-count {
    grid-column: 1;
    grid-row: 3;
  }

  .corpus-partitions-diagram:fullscreen .document-list {
    grid-column: 2;
    grid-row: 1 / 4;
    margin-block-start: 0;
  }

  .corpus-partitions-diagram:fullscreen
    .partition-card[data-partition='train']
    .document-list {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .corpus-partitions-diagram:fullscreen
    .partition-card:not([data-partition='train'])
    .document-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .corpus-partitions-diagram:fullscreen > .partition-summary {
    grid-column: 1;
    align-self: start;
    margin-block-start: 0;
  }

  .corpus-partitions-diagram:fullscreen > .partition-invariants {
    grid-column: 2;
    align-self: start;
    margin-block-start: 0;
  }
</style>
