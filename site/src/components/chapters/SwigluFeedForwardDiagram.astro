---
// @ts-ignore Node filesystem access is build-time only.
import { readFileSync } from 'node:fs';

import InlineMath from '../InlineMath.astro';
import {
  parseSwigluFeedForwardTrace,
  swigluFeedForwardDiagramId,
  validateSwigluFeedForwardLabels,
  type SwigluFeedForwardDiagramLabels,
} from '../../lib/swiglu-feed-forward-diagram';

interface Props {
  labels: SwigluFeedForwardDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'default' } = Astro.props;
validateSwigluFeedForwardLabels(labels);
if (!/^[a-z][a-z0-9-]*$/.test(instanceId)) {
  throw new Error('SwiGLU diagram instanceId must be a kebab-case identifier.');
}

const fixtureUrl = new URL(
  '../../../../rust/demos/ch20-swiglu-feed-forward/diagram-trace.txt',
  import.meta.url,
);
const trace = parseSwigluFeedForwardTrace(readFileSync(fixtureUrl, 'utf8'));
const titleId = `${swigluFeedForwardDiagramId}-${instanceId}-title`;
const descriptionId = `${swigluFeedForwardDiagramId}-${instanceId}-description`;

const latexValue = (value: { lexeme: string }) => {
  const compact = Number.parseFloat(value.lexeme)
    .toFixed(6)
    .replace(/0+$/, '')
    .replace(/\.$/, '');
  return compact === '-0' ? '0' : compact;
};
const latexVector = (values: ReadonlyArray<{ lexeme: string }>) =>
  String.raw`\left[${values.map(latexValue).join(',')}\right]`;
const latexShape = (value: string) =>
  String.raw`\left[${value.replaceAll('x', ',')}\right]`;
const latexMatrix = (
  values: ReadonlyArray<{ lexeme: string }>,
  rows: number,
  columns: number,
) => {
  if (values.length !== rows * columns) {
    throw new Error(`SwiGLU matrix requires ${rows * columns} values.`);
  }
  return String.raw`\begin{bmatrix}${Array.from({ length: rows }, (_, row) =>
    values
      .slice(row * columns, (row + 1) * columns)
      .map(latexValue)
      .join('&'),
  ).join('\\\\')}\end{bmatrix}`;
};

const parameterRows = trace.parameterGradients.map((row) => {
  if (row.name === 'ffn.gate.weight') {
    return {
      ...row,
      symbol: String.raw`W_g`,
      accumulation: String.raw`\sum_p X_p^\top dA_p`,
      value: latexMatrix(row.values, 2, 3),
    };
  }
  if (row.name === 'ffn.up.weight') {
    return {
      ...row,
      symbol: String.raw`W_u`,
      accumulation: String.raw`\sum_p X_p^\top dU_p`,
      value: latexMatrix(row.values, 2, 3),
    };
  }
  return {
    ...row,
    symbol: String.raw`W_2`,
    accumulation: String.raw`\sum_p H_p^\top G_p`,
    value: latexMatrix(row.values, 3, 2),
  };
});
---

<figure
  class="course-diagram swiglu-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={swigluFeedForwardDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description course-diagram__description">{labels.description}</p>
  </figcaption>

  <dl class="shape-summary">
    <div data-diagram-box>
      <dt>{labels.summary.inputWidth}</dt>
      <dd><InlineMath latex={trace.fixture.modelWidth.lexeme} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.hiddenWidth}</dt>
      <dd><InlineMath latex={trace.fixture.hiddenWidth.lexeme} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.outputWidth}</dt>
      <dd><InlineMath latex={trace.fixture.outputWidth.lexeme} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.bias}</dt>
      <dd>{labels.symbols.biasFree}</dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.parameterCount}</dt>
      <dd><InlineMath latex={trace.fixture.parameterCount.lexeme} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.inputShape}</dt>
      <dd><InlineMath latex={latexShape(trace.fixture.inputShape)} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.branchShape}</dt>
      <dd><InlineMath latex={latexShape(trace.fixture.branchShape)} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.outputShape}</dt>
      <dd><InlineMath latex={latexShape(trace.fixture.outputShape)} /></dd>
    </div>
  </dl>

  <section class="diagram-stage positions-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-positions`}>
    <h4 id={`${titleId}-positions`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">1</span> {labels.stages.positions}</h4>
    <div
      class="forward-scroll course-diagram__scroll"
      role="region"
      tabindex="0"
      aria-label={labels.scrollers.forward}
      data-diagram-scroll
    >
      <table data-diagram-table class="forward-table">
        <caption>{labels.stages.positions}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.computation}</th>
            {trace.forward.map((row) => (
              <th scope="col" data-forward-position={row.position.lexeme}>
                {labels.fields.position} <InlineMath latex={row.position.lexeme} />
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr data-forward-stage="input">
            <th scope="row" aria-label={labels.fields.input}><InlineMath latex="X" /></th>
            {trace.forward.map((row) => (
              <td data-forward-position={row.position.lexeme}>
                <InlineMath latex={String.raw`X_{${row.position.lexeme}}=${latexVector(row.input)}`} />
              </td>
            ))}
          </tr>
          <tr data-forward-stage="gate-projection">
            <th scope="row" aria-label={labels.fields.gateProjection}><InlineMath latex="g=XW_g" /></th>
            {trace.forward.map((row) => (
              <td data-forward-position={row.position.lexeme}>
                <InlineMath latex={String.raw`g_{${row.position.lexeme}}=X_{${row.position.lexeme}}W_g`} />
              </td>
            ))}
          </tr>
          <tr data-forward-stage="gate-pre-activation">
            <th scope="row" aria-label={labels.fields.preActivation}><InlineMath latex="g" /></th>
            {trace.forward.map((row) => (
              <td data-forward-position={row.position.lexeme}>
                <InlineMath latex={String.raw`g_{${row.position.lexeme}}=${latexVector(row.gatePre)}`} />
              </td>
            ))}
          </tr>
          <tr data-forward-stage="gate-activation">
            <th scope="row" class="gate-branch" aria-label={labels.stages.gate}>
              <InlineMath latex="s=\operatorname{SiLU}(g)" />
            </th>
            {trace.forward.map((row) => (
              <td data-forward-position={row.position.lexeme}>
                <InlineMath latex={String.raw`s_{${row.position.lexeme}}=${latexVector(row.gateSilu)}`} />
              </td>
            ))}
          </tr>
          <tr data-forward-stage="up-projection">
            <th scope="row" aria-label={labels.fields.upProjection}><InlineMath latex="u=XW_u" /></th>
            {trace.forward.map((row) => (
              <td data-forward-position={row.position.lexeme}>
                <InlineMath latex={String.raw`u_{${row.position.lexeme}}=X_{${row.position.lexeme}}W_u`} />
              </td>
            ))}
          </tr>
          <tr data-forward-stage="up-values">
            <th scope="row" class="up-branch" aria-label={labels.stages.up}>
              <InlineMath latex="u" />
            </th>
            {trace.forward.map((row) => (
              <td data-forward-position={row.position.lexeme}>
                <InlineMath latex={String.raw`u_{${row.position.lexeme}}=${latexVector(row.up)}`} />
              </td>
            ))}
          </tr>
          <tr data-forward-stage="merge">
            <th scope="row" class="merge-stage" aria-label={labels.stages.merge}>
              <InlineMath latex="h=s\odot u" />
            </th>
            {trace.forward.map((row) => (
              <td data-forward-position={row.position.lexeme}>
                <InlineMath latex={String.raw`h_{${row.position.lexeme}}=${latexVector(row.gated)}`} />
              </td>
            ))}
          </tr>
          <tr data-forward-stage="down">
            <th scope="row" class="down-stage" aria-label={labels.stages.down}>
              <InlineMath latex="Y=hW_2" />
            </th>
            {trace.forward.map((row) => (
              <td data-forward-position={row.position.lexeme}>
                <InlineMath latex={String.raw`Y_{${row.position.lexeme}}=${latexVector(row.output)}`} />
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
    <div class="forward-notes course-diagram__grid">
      <p>{labels.notes.positionWise}</p>
      <p class="stage-note">{labels.notes.gate}</p>
      <p class="precision-note">{labels.notes.precision}</p>
    </div>
  </section>

  <section class="diagram-stage independence-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-independence`}>
    <h4 id={`${titleId}-independence`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">2</span> {labels.stages.independence}</h4>
    <p>{labels.notes.independence}</p>
    <dl class="independence-proof course-diagram__grid">
      <div data-diagram-card data-diagram-box class="proof-changed">
        <dt>{labels.fields.changedPosition}</dt>
        <dd><InlineMath latex={trace.independence.changedPosition.lexeme} /></dd>
      </div>
      <div data-diagram-card data-diagram-box class="proof-replacement">
        <dt>{labels.fields.replacement}</dt>
        <dd><InlineMath latex={latexVector(trace.independence.replacementInput)} /></dd>
      </div>
      <div data-diagram-card data-diagram-box class="proof-observed">
        <dt>{labels.fields.observedPosition}</dt>
        <dd><InlineMath latex={trace.independence.observedPosition.lexeme} /></dd>
      </div>
      <div data-diagram-card data-diagram-box class="proof-before">
        <dt>{labels.fields.before}</dt>
        <dd><InlineMath latex={latexVector(trace.independence.before)} /></dd>
      </div>
      <div data-diagram-card data-diagram-box class="proof-after">
        <dt>{labels.fields.after}</dt>
        <dd><InlineMath latex={latexVector(trace.independence.after)} /></dd>
      </div>
      <div data-diagram-card data-diagram-box class="proof-result" data-state="trusted">
        <dt>{labels.fields.result}</dt>
        <dd>{labels.symbols.unchanged}</dd>
      </div>
    </dl>
  </section>

  <section class="diagram-stage gradients-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-gradients`}>
    <h4 id={`${titleId}-gradients`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">3</span> {labels.stages.gradients}</h4>
    <p>{labels.notes.gradients}</p>
    <div class="position-gradient-grid course-diagram__grid">
      {trace.backward.map((row) => (
        <table data-diagram-table class="position-gradient-table" data-gradient-position={row.position.lexeme}>
          <caption>
            {labels.captions.positionGradients}: {labels.fields.position}{' '}
            <InlineMath latex={row.position.lexeme} />
          </caption>
          <tbody>
            <tr data-gradient-kind="upstream">
              <th scope="row" aria-label={labels.fields.upstream}><InlineMath latex={String.raw`G_{${row.position.lexeme}}`} /></th>
              <td><InlineMath latex={latexVector(row.upstream)} /></td>
            </tr>
            <tr data-gradient-kind="gated">
              <th scope="row" aria-label={labels.fields.gatedGradient}><InlineMath latex={String.raw`dH_{${row.position.lexeme}}`} /></th>
              <td><InlineMath latex={latexVector(row.gatedGradient)} /></td>
            </tr>
            <tr data-gradient-kind="gate">
              <th scope="row" aria-label={labels.fields.gateGradient}><InlineMath latex={String.raw`dA_{${row.position.lexeme}}`} /></th>
              <td><InlineMath latex={latexVector(row.gateGradient)} /></td>
            </tr>
            <tr data-gradient-kind="up">
              <th scope="row" aria-label={labels.fields.upGradient}><InlineMath latex={String.raw`dU_{${row.position.lexeme}}`} /></th>
              <td><InlineMath latex={latexVector(row.upGradient)} /></td>
            </tr>
            <tr data-gradient-kind="input">
              <th scope="row" aria-label={labels.fields.inputGradient}><InlineMath latex={String.raw`dX_{${row.position.lexeme}}`} /></th>
              <td><InlineMath latex={latexVector(row.inputGradient)} /></td>
            </tr>
          </tbody>
        </table>
      ))}
    </div>

    <div class="parameter-scroll course-diagram__scroll" role="region" tabindex="0" aria-label={labels.scrollers.parameters} data-diagram-scroll>
      <table data-diagram-table class="parameter-gradient-table">
        <caption>{labels.captions.parameterGradients}</caption>
        <thead>
          <tr>
            <th scope="col" aria-label={labels.fields.parameter}><InlineMath latex="\theta" /></th>
            <th scope="col" aria-label={labels.fields.accumulation}><InlineMath latex="\sum_p" /></th>
            <th scope="col" aria-label={labels.fields.shape}><InlineMath latex="\dim(\theta)" /></th>
            <th scope="col" aria-label={labels.fields.gradient}><InlineMath latex="d\theta" /></th>
          </tr>
        </thead>
        <tbody>
          {parameterRows.map((row) => (
            <tr data-parameter-gradient={row.name}>
              <th scope="row">
                <span class="parameter-name"><InlineMath latex={row.symbol} /><code><bdi dir="ltr">{row.name}</bdi></code></span>
              </th>
              <td><InlineMath latex={row.accumulation} /></td>
              <td><InlineMath latex={latexShape(row.shape)} /></td>
              <td><InlineMath latex={row.value} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</figure>

<style>
  .swiglu-diagram {
    --diagram-summary-min: 8.75rem;
  }

  .diagram-stage {
    min-inline-size: 0;
  }

  .forward-scroll {
    --diagram-scroll-inline-size: 100%;
  }

  .forward-table {
    inline-size: 100%;
    min-inline-size: 36.25rem;
    table-layout: fixed;
  }

  .forward-table th:first-child {
    inline-size: 6.875rem;
  }

  .forward-notes {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    align-items: start;
  }

  .forward-notes > p {
    margin: 0;
  }

  .equation-row,
  .parameter-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.65rem;
    min-inline-size: 0;
  }

  .parameter-name code {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .gate-branch {
    border-inline-start-style: solid !important;
    border-inline-start-width: 3px !important;
  }

  .up-branch {
    border-inline-start-style: double !important;
    border-inline-start-width: 4px !important;
  }

  .merge-stage {
    border-style: dashed !important;
    border-width: 2px !important;
  }

  .down-stage {
    border-style: double !important;
    border-width: 3px !important;
  }

  .independence-proof {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }

  .proof-result {
    align-content: center;
  }

  .position-gradient-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: start;
  }

  .position-gradient-table,
  .parameter-gradient-table {
    inline-size: 100%;
  }

  .position-gradient-table {
    table-layout: fixed;
  }

  .position-gradient-table th {
    inline-size: 4.5rem;
  }

  .parameter-scroll {
    --diagram-scroll-inline-size: 100%;
  }

  .parameter-gradient-table {
    min-inline-size: 44rem;
  }

  .parameter-gradient-table th:first-child {
    inline-size: 13rem;
  }

  .parameter-gradient-table th:nth-child(2) {
    inline-size: 12rem;
  }

  .parameter-gradient-table th:nth-child(3) {
    inline-size: 5rem;
  }

  @container course-diagram (max-width: 36rem) {
    .forward-notes,
    .position-gradient-grid,
    .independence-proof {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .swiglu-diagram:fullscreen {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr) 10rem;
    grid-template-areas:
      'caption caption actions'
      'summary summary summary'
      'positions gradients gradients'
      'independence gradients gradients';
    align-items: start;
  }

  .swiglu-diagram:fullscreen > figcaption {
    grid-area: caption;
  }

  .swiglu-diagram:fullscreen > .shape-summary {
    grid-area: summary;
  }

  .swiglu-diagram:fullscreen > :global(.diagram-full-view-actions) {
    grid-area: actions;
    align-self: start;
    justify-self: end;
  }

  .swiglu-diagram:fullscreen > .positions-stage {
    grid-area: positions;
  }

  .swiglu-diagram:fullscreen > .independence-stage {
    grid-area: independence;
  }

  .swiglu-diagram:fullscreen > .gradients-stage {
    grid-area: gradients;
  }

  .swiglu-diagram:fullscreen > .shape-summary {
    grid-template-columns: repeat(8, minmax(0, 1fr));
  }

  .swiglu-diagram:fullscreen .forward-notes {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .swiglu-diagram:fullscreen > .independence-stage {
    grid-template-columns: minmax(11rem, 0.4fr) minmax(0, 1fr);
    grid-template-areas:
      'heading proof'
      'note proof';
    align-items: start;
  }

  .swiglu-diagram:fullscreen > .independence-stage > h4 {
    grid-area: heading;
  }

  .swiglu-diagram:fullscreen > .independence-stage > p {
    grid-area: note;
    margin: 0;
  }

  .swiglu-diagram:fullscreen .independence-proof {
    grid-area: proof;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-areas:
      'changed replacement observed result'
      'before before after after';
  }

  .swiglu-diagram:fullscreen .proof-changed {
    grid-area: changed;
  }

  .swiglu-diagram:fullscreen .proof-replacement {
    grid-area: replacement;
  }

  .swiglu-diagram:fullscreen .proof-observed {
    grid-area: observed;
  }

  .swiglu-diagram:fullscreen .proof-before {
    grid-area: before;
  }

  .swiglu-diagram:fullscreen .proof-after {
    grid-area: after;
  }

  .swiglu-diagram:fullscreen .proof-result {
    grid-area: result;
  }

  .swiglu-diagram:fullscreen .position-gradient-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .swiglu-diagram:fullscreen .parameter-gradient-table {
    min-inline-size: 0;
    table-layout: fixed;
  }

  .swiglu-diagram:fullscreen .parameter-gradient-table :is(th, td) {
    inline-size: auto;
  }

  .swiglu-diagram:fullscreen .parameter-gradient-table tr > :nth-child(1) {
    inline-size: 17%;
  }

  .swiglu-diagram:fullscreen .parameter-gradient-table tr > :nth-child(2) {
    inline-size: 19%;
  }

  .swiglu-diagram:fullscreen .parameter-gradient-table tr > :nth-child(3) {
    inline-size: 12%;
  }

  .swiglu-diagram:fullscreen .parameter-gradient-table tr > :nth-child(4) {
    inline-size: 52%;
  }
</style>
