---
import traceSource from '../../../../rust/demos/ch27-self-attention/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  parseSelfAttentionTrace,
  validateSelfAttentionLabels,
  type SelfAttentionDiagramLabels,
  type SelfAttentionInputRole,
  type SelfAttentionTraceVector,
} from '../../lib/self-attention-diagram';

interface Props {
  labels: SelfAttentionDiagramLabels;
}

const { labels } = Astro.props;
validateSelfAttentionLabels(labels);
const trace = parseSelfAttentionTrace(traceSource);
const titleId = 'self-attention-diagram-title';
const descriptionId = 'self-attention-diagram-description';
const roleLabels: Record<SelfAttentionInputRole, string> = labels.roles;
const localizedErrorReasons: Record<string, string> = {
  'query-rank': labels.errorReasons.queryRank,
  'batch-mismatch': labels.errorReasons.batchMismatch,
  'token-mismatch': labels.errorReasons.tokenMismatch,
  'empty-tokens': labels.errorReasons.emptyTokens,
  'query-key-width': labels.errorReasons.queryKeyWidth,
};
const rows2 = (vector: SelfAttentionTraceVector) => [
  vector.values.slice(0, 2),
  vector.values.slice(2, 4),
];
const rejectionStatus = (value: string) => value === 'true' ? labels.cues.rejected : labels.cues.verified;
const rejectionState = (value: string) => value === 'true' ? 'rejected' : 'trusted';
---

<figure
  class="course-diagram self-attention-diagram"
  data-diagram-style="course-v1"
  data-visualization-id="self-attention"
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description course-diagram__description">{labels.description}</p>
    <ul class="cue-list" aria-label={labels.captions.calculation}>
      <li data-diagram-box class="query-cue">{labels.cues.query}</li>
      <li data-diagram-box class="key-cue">{labels.cues.key}</li>
      <li data-diagram-box class="value-cue">{labels.cues.value}</li>
      <li data-diagram-box class="score-cue">{labels.cues.score}</li>
      <li data-diagram-box class="probability-cue">{labels.cues.probability}</li>
    </ul>
  </figcaption>

  <section data-diagram-box class="diagram-section calculation-section course-diagram__card-stack" aria-labelledby="attention-calculation-title">
    <h4 id="attention-calculation-title">{labels.sections.calculation}</h4>
    <p class="section-caption course-diagram__description">{labels.captions.calculation}</p>

    <h5>{labels.stages.inputs}</h5>
    <div
      class="inputs-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.inputs}
      data-diagram-scroll>
      <ol class="input-grid course-diagram__grid">
        {trace.inputs.map((input) => (
          <li>
            <article data-diagram-card data-diagram-box class:list={['input-card', 'course-diagram__card-stack', `${input.role}-card`]} data-input-role={input.role}>
              <header class="course-diagram__card-heading">
                <strong>{roleLabels[input.role]}</strong>
              </header>
              <p class="matrix-label"><InlineMath latex={input.symbol} /></p>
              <table data-diagram-table class="matrix-table" dir="ltr" aria-label={`${roleLabels[input.role]}: ${labels.fields.tokenRowsFeatureColumns}`}>
                <thead>
                  <tr>
                    <th aria-hidden="true"></th>
                    <th scope="col"><InlineMath latex="0" /></th>
                    <th scope="col"><InlineMath latex="1" /></th>
                  </tr>
                </thead>
                <tbody>
                  {rows2(input.values).map((row, rowIndex) => (
                    <tr>
                      <th scope="row"><InlineMath latex={String.raw`${input.symbol.toLowerCase()}_${rowIndex}`} /></th>
                      {row.map((value) => <td><InlineMath latex={value} /></td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
              <p><span>{labels.fields.shape}:</span> <InlineMath latex={input.shape} /></p>
            </article>
          </li>
        ))}
      </ol>
    </div>

    <div class="stage-marker" aria-hidden="true">&darr;</div>

    <div
      class="scores-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.scores}
      data-diagram-scroll>
      <div class="score-grid course-diagram__grid">
        <article data-diagram-card data-diagram-box class="score-card raw-score-card course-diagram__card-stack" data-score-kind="dot-products">
          <h5>{labels.stages.dotProducts}</h5>
          <p class="formula-line"><InlineMath latex="QK^\top" /></p>
          <table data-diagram-table class="matrix-table score-table" dir="ltr" aria-label={`${labels.stages.dotProducts}: ${labels.fields.queryRowsKeyColumns}`}>
            <thead>
              <tr>
                <th aria-hidden="true"></th>
                <th scope="col"><InlineMath latex="k_0" /></th>
                <th scope="col"><InlineMath latex="k_1" /></th>
              </tr>
            </thead>
            <tbody>
              {rows2(trace.dotProducts.values).map((row, rowIndex) => (
                <tr>
                  <th scope="row"><InlineMath latex={String.raw`q_${rowIndex}`} /></th>
                  {row.map((value) => <td><InlineMath latex={value} /></td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </article>

        <article data-diagram-card data-diagram-box class="score-card scaled-score-card course-diagram__card-stack" data-score-kind="scaled-scores">
          <h5>{labels.stages.scaledScores}</h5>
          <p class="formula-line"><InlineMath latex="S=QK^\top/\sqrt{d_k}" /></p>
          <table data-diagram-table class="matrix-table score-table" dir="ltr" aria-label={`${labels.stages.scaledScores}: ${labels.fields.queryRowsKeyColumns}`}>
            <thead>
              <tr>
                <th aria-hidden="true"></th>
                <th scope="col"><InlineMath latex="k_0" /></th>
                <th scope="col"><InlineMath latex="k_1" /></th>
              </tr>
            </thead>
            <tbody>
              {rows2(trace.scaledScores.values).map((row, rowIndex) => (
                <tr>
                  <th scope="row"><InlineMath latex={String.raw`q_${rowIndex}`} /></th>
                  {row.map((value) => <td><InlineMath latex={value} /></td>)}
                </tr>
              ))}
            </tbody>
          </table>
          <dl class="facts-grid course-diagram__grid">
            <div>
              <dt>{labels.fields.scale}</dt>
              <dd><InlineMath latex={String.raw`1/\sqrt{d_k}=${trace.meta.scale}`} /></dd>
            </div>
            <div>
              <dt>{labels.fields.shape}</dt>
              <dd><InlineMath latex={trace.scaledScores.shape} /></dd>
            </div>
          </dl>
        </article>
      </div>
    </div>

    <div class="stage-marker" aria-hidden="true">&darr;</div>

    <h5>{labels.stages.probabilities}</h5>
    <div
      class="probabilities-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.probabilities}
      data-diagram-scroll>
      <ol class="probability-grid course-diagram__grid">
        {trace.probabilityRows.map((row) => (
          <li>
            <article data-diagram-card data-diagram-box class="probability-card course-diagram__card-stack" data-probability-row={row.query}>
              <p class="formula-line"><InlineMath latex={String.raw`q_${row.query}`} /></p>
              <p><InlineMath latex={String.raw`A_{${row.query},:}=${row.values.latex}`} /></p>
              <dl class="facts-grid course-diagram__grid">
                <div>
                  <dt>{labels.fields.rowSum}</dt>
                  <dd><InlineMath latex={String.raw`\sum_j A_{${row.query}j}=${row.sum}`} /></dd>
                </div>
                <div>
                  <dt>{labels.fields.softmaxAxis}</dt>
                  <dd><code><bdi dir="ltr">{trace.meta.softmaxAxis}</bdi></code></dd>
                </div>
              </dl>
            </article>
          </li>
        ))}
      </ol>
    </div>

    <div class="stage-marker" aria-hidden="true">&darr;</div>

    <h5>{labels.stages.mixtures}</h5>
    <div
      class="mixtures-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.mixtures}
      data-diagram-scroll>
      <ol class="mixture-grid course-diagram__grid">
        {trace.mixtureRows.map((row) => (
          <li>
            <article data-diagram-card data-diagram-box class="mixture-card course-diagram__card-stack" data-mixture-row={row.query}>
              <p class="formula-line"><InlineMath latex={String.raw`o_${row.query}`} /></p>
              <dl class="facts-grid course-diagram__grid">
                <div>
                  <dt>{labels.stages.probabilities}</dt>
                  <dd><InlineMath latex={row.probabilities.latex} /></dd>
                </div>
                <div>
                  <dt>{labels.fields.weightedTerms}</dt>
                  <dd>
                    <InlineMath latex={row.terms[0].latex} />{' '}
                    <InlineMath latex={`+${row.terms[1].latex}`} />
                  </dd>
                </div>
                <div>
                  <dt>{labels.fields.output}</dt>
                  <dd><InlineMath latex={String.raw`o_${row.query}=${row.output.latex}`} /></dd>
                </div>
              </dl>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section data-diagram-box class="diagram-section evidence-section course-diagram__card-stack" aria-labelledby="attention-evidence-title">
    <h4 id="attention-evidence-title">{labels.sections.evidence}</h4>
    <p class="section-caption course-diagram__description">{labels.captions.evidence}</p>

    <article data-diagram-card data-diagram-box class="evidence-card backward-card course-diagram__card-stack" data-evidence-kind="backward">
      <h5>{labels.fields.backward}</h5>
      <div
        class="gradients-scroller course-diagram__scroll"
        tabindex="0"
        role="region"
        aria-label={labels.scrollers.gradients}
        data-diagram-scroll>
        <table data-diagram-table class="evidence-table" dir="ltr" aria-label={labels.fields.backward}>
          <tbody>
            <tr>
              <th scope="row"><InlineMath latex="\bar O" /></th>
              <td><InlineMath latex={trace.backward.seed.latex} /></td>
            </tr>
            <tr>
              <th scope="row"><InlineMath latex="\bar Q" /></th>
              <td><InlineMath latex={trace.backward.queryGradient.latex} /></td>
            </tr>
            <tr>
              <th scope="row"><InlineMath latex="\bar K" /></th>
              <td><InlineMath latex={trace.backward.keyGradient.latex} /></td>
            </tr>
            <tr>
              <th scope="row"><InlineMath latex="\bar V" /></th>
              <td><InlineMath latex={trace.backward.valueGradient.latex} /></td>
            </tr>
          </tbody>
        </table>
      </div>
    </article>

    <div class="evidence-grid course-diagram__grid">
      <article data-diagram-card data-diagram-box class="evidence-card shape-card course-diagram__card-stack" data-evidence-kind="shapes">
        <h5>{labels.fields.batchShape}</h5>
        <dl class="facts-grid course-diagram__grid">
          <div>
            <dt><InlineMath latex="Q,K,V" /></dt>
            <dd><InlineMath latex={trace.batchShape.query} /></dd>
          </div>
          <div>
            <dt><InlineMath latex="A" /></dt>
            <dd><InlineMath latex={trace.batchShape.probabilities} /></dd>
          </div>
          <div>
            <dt><InlineMath latex="O" /></dt>
            <dd><InlineMath latex={trace.batchShape.output} /></dd>
          </div>
          <div>
            <dt>{labels.fields.batchIsolation}</dt>
            <dd>{trace.batchShape.isolated === 'true' ? labels.cues.verified : labels.cues.rejected}</dd>
          </div>
        </dl>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card single-card course-diagram__card-stack" data-evidence-kind="single-token">
        <h5>{labels.fields.singleToken}</h5>
        <p><InlineMath latex={String.raw`A=${trace.singleToken.probabilities.latex}`} /></p>
        <p><InlineMath latex={String.raw`O=${trace.singleToken.output.latex}`} /></p>
        <p><span>{labels.fields.queryGradient}:</span> <InlineMath latex="\bar Q=0" /></p>
        <p><span>{labels.fields.keyGradient}:</span> <InlineMath latex="\bar K=0" /></p>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card boundary-card course-diagram__card-stack" data-evidence-kind="boundary">
        <h5>{labels.fields.mask}</h5>
        <p>{trace.meta.masked === 'false' && trace.proof.unmasked === 'true' ? labels.cues.unmasked : labels.cues.rejected}</p>
        <p><InlineMath latex={String.raw`d_k=${trace.meta.keyWidth},\quad d_v=${trace.meta.valueWidth}`} /></p>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card errors-card course-diagram__card-stack" data-evidence-kind="errors">
        <h5>{labels.fields.errors}</h5>
        <ul class="error-list course-diagram__grid">
          {trace.errors.map((error) => (
            <li data-diagram-card data-diagram-box data-state={rejectionState(error.rejected)} class="error-case course-diagram__card-stack">
              <strong data-diagram-box class="state-symbol">{rejectionStatus(error.rejected)}</strong>
              <span>{labels.fields.errorKind}: <code><bdi dir="ltr">{error.kind}</bdi></code></span>
              <span>{localizedErrorReasons[error.case]}</span>
              <span>{labels.fields.errorEvidence}: <code><bdi dir="ltr">{error.evidence}</bdi></code></span>
            </li>
          ))}
        </ul>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card proof-card course-diagram__card-stack" data-evidence-kind="proof">
        <h5>{labels.fields.proof}</h5>
        <dl class="facts-grid course-diagram__grid">
          <div>
            <dt>{labels.fields.rowSum}</dt>
            <dd><InlineMath latex={trace.proof.rowSumTolerance} /></dd>
          </div>
          <div>
            <dt>{labels.fields.gradientCheck}</dt>
            <dd><code><bdi dir="ltr">gradcheck={trace.proof.gradcheck}</bdi></code></dd>
          </div>
          <div>
            <dt>{labels.fields.checkCount}</dt>
            <dd><InlineMath latex={`${trace.proof.queryChecks}+${trace.proof.keyChecks}+${trace.proof.valueChecks}`} /></dd>
          </div>
          <div>
            <dt>{labels.fields.gradientTolerance}</dt>
            <dd><InlineMath latex={trace.proof.gradientTolerance} /></dd>
          </div>
          <div>
            <dt>{labels.fields.replay}</dt>
            <dd><code><bdi dir="ltr">replay={trace.proof.replay}</bdi></code></dd>
          </div>
        </dl>
      </article>
    </div>
  </section>

  <section data-diagram-box class="diagram-section history-section course-diagram__card-stack" aria-labelledby="attention-history-title">
    <h4 id="attention-history-title">{labels.sections.history}</h4>
    <p class="section-caption course-diagram__description">{labels.captions.history}</p>
    <div
      class="history-scroller course-diagram__scroll"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.history}
      data-diagram-scroll>
      <ol class="history-grid course-diagram__grid">
        <li>
          <article data-diagram-card data-diagram-box class="history-card course-diagram__card-stack" data-history-kind="earlier" data-history-evidence={trace.history.earlier}>
            <h5>{labels.fields.earlier}</h5>
            <p>{labels.historyDetails.earlier}</p>
          </article>
        </li>
        <li>
          <article data-diagram-card data-diagram-box class="history-card bridge-card course-diagram__card-stack" data-history-kind="bridge" data-history-evidence={trace.history.bridge}>
            <h5>{labels.fields.bridge}</h5>
            <p>{labels.historyDetails.bridge}</p>
          </article>
        </li>
        <li>
          <article data-diagram-card data-diagram-box class="history-card transformer-card course-diagram__card-stack" data-history-kind="transformer" data-history-evidence={`${trace.history.transformer}|${trace.history.comparison}`}>
            <h5>{labels.fields.transformer}</h5>
            <p>{labels.historyDetails.transformer}</p>
            <p>{labels.historyDetails.comparison}</p>
          </article>
        </li>
      </ol>
    </div>
  </section>
</figure>

<style>
  .key-cue,
  .key-card {
    border-style: dashed;
  }

  .value-cue,
  .value-card {
    border-style: double;
    border-width: 4px;
  }

  .score-cue {
    border-style: dotted;
  }

  .probability-cue,
  .probability-card {
    border-block-style: double;
  }

  .input-grid,
  .score-grid,
  .probability-grid,
  .mixture-grid,
  .history-grid {
    align-items: start;
  }

  .input-grid,
  .history-grid {
    grid-template-columns: repeat(3, minmax(16rem, 1fr));
    min-inline-size: 52rem;
  }

  .score-grid,
  .probability-grid {
    grid-template-columns: repeat(2, minmax(18rem, 1fr));
    min-inline-size: 39rem;
  }

  .mixture-grid {
    grid-template-columns: repeat(2, minmax(24rem, 1fr));
    min-inline-size: 50rem;
  }

  .score-card {
    border-inline-start-width: 5px;
  }

  .scaled-score-card {
    border-inline-start-style: dashed;
  }

  .mixture-card {
    border-inline-end-width: 5px;
  }

  .history-card {
    border-block-start-width: 5px;
  }

  .bridge-card {
    border-block-start-style: dashed;
  }

  .transformer-card {
    border-block-start-style: double;
  }

  .stage-marker {
    display: grid;
    place-items: center;
  }

  .matrix-table,
  .evidence-table {
    inline-size: 100%;
  }

  .evidence-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: start;
  }

  .error-case .state-symbol {
    justify-self: start;
  }
</style>
