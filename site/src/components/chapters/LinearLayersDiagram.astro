---
// @ts-ignore Node filesystem access is build-time only.
import { readFileSync } from 'node:fs';

import InlineMath from '../InlineMath.astro';

import {
  linearLayersDiagramId,
  parseLinearLayersTrace,
  validateLinearLayersLabels,
  type LinearLayersDiagramLabels,
} from '../../lib/linear-layers-diagram';

interface Props {
  labels: LinearLayersDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'default' } = Astro.props;
validateLinearLayersLabels(labels);
if (!/^[a-z][a-z0-9-]*$/.test(instanceId)) {
  throw new Error('Linear-layers diagram instanceId must be a kebab-case identifier.');
}

const fixtureUrl = new URL(
  '../../../../rust/demos/ch19-linear-layers/diagram-trace.txt',
  import.meta.url,
);
const trace = parseLinearLayersTrace(readFileSync(fixtureUrl, 'utf8'));
const titleId = `${linearLayersDiagramId}-${instanceId}-title`;
const descriptionId = `${linearLayersDiagramId}-${instanceId}-description`;

const latexValue = (value: { lexeme: string }) =>
  value.lexeme.includes('.')
    ? value.lexeme.replace(/0+$/, '').replace(/\.$/, '')
    : value.lexeme;
const latexVector = (values: ReadonlyArray<{ lexeme: string }>) =>
  String.raw`\left[${values.map(latexValue).join(',')}\right]`;
const latexShape = (value: string) =>
  String.raw`\left[${value.replaceAll('x', ',')}\right]`;
const latexCoordinate = (values: ReadonlyArray<{ lexeme: string }>) =>
  String.raw`\left(${values.map((value) => value.lexeme).join(',')}\right)`;
const weightAccumulationLatex = String.raw`\sum_p X_p^\top G_p`;
const biasAccumulationLatex = String.raw`\sum_p G_p`;
const weightMatrixLatex = String.raw`\begin{bmatrix}${trace.weightRows[0]!.values
  .map(latexValue)
  .join('&')}\\${trace.weightRows[1]!.values.map(latexValue).join('&')}\end{bmatrix}`;
const biasFreeRows = [
  trace.policy.biasFreeOutput.slice(0, 3),
  trace.policy.biasFreeOutput.slice(3, 6),
];
const affineRows = [
  trace.cells.slice(0, 3).map((cell) => cell.result),
  trace.cells.slice(3, 6).map((cell) => cell.result),
];
const positionRows = trace.positionGradients.map((gradient) => {
  const cells = trace.cells.filter(
    (cell) => cell.position.lexeme === gradient.position.lexeme,
  );
  if (cells.length !== 3 || !cells[0]) {
    throw new Error(`Linear-layers position ${gradient.position.lexeme} is incomplete.`);
  }
  return {
    position: gradient.position,
    coordinate: gradient.coordinate,
    input: cells[0].input,
    output: cells.map((cell) => cell.result),
  };
});
const policyRows = affineRows.map((affine, position) => ({
  position: String.raw`\left(0,${position}\right)`,
  affine,
  biasFree: biasFreeRows[position],
}));
if (policyRows.some((row) => row.biasFree === undefined || row.biasFree.length !== 3)) {
  throw new Error('Linear-layers policy rows are incomplete.');
}
const weightGradientLatex = String.raw`\begin{bmatrix}${trace.weightGradient.values
  .slice(0, 3)
  .map(latexValue)
  .join('&')}\\${trace.weightGradient.values.slice(3, 6).map(latexValue).join('&')}\end{bmatrix}`;
const selectedCell = trace.cells[0];
const selectedProducts = selectedCell.products;
const productLatex = selectedProducts
  .map((product) => `${latexValue(product.input)}\\cdot${latexValue(product.weight)}`)
  .join('+');
const contributionLatex = String.raw`\begin{aligned}y_{${selectedCell.outputFeature.lexeme}}&=${productLatex}+${latexValue(selectedCell.bias)}\\&=${latexValue(selectedCell.weightedSum)}+${latexValue(selectedCell.bias)}=${latexValue(selectedCell.result)}\end{aligned}`;
---

<figure
  class="course-diagram linear-layers-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={linearLayersDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description course-diagram__description">{labels.description}</p>
  </figcaption>

  <dl class="shape-summary">
    <div data-diagram-box>
      <dt>{labels.summary.parameter}</dt>
      <dd><code><bdi dir="ltr">{trace.fixture.parameterPrefix}.weight</bdi></code></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.inputWidth}</dt>
      <dd><InlineMath latex={trace.fixture.inputWidth.lexeme} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.outputWidth}</dt>
      <dd><InlineMath latex={trace.fixture.outputWidth.lexeme} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.bias}</dt>
      <dd>{labels.policies.enabled}</dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.parameterCount}</dt>
      <dd><InlineMath latex={trace.fixture.parameterCount.lexeme} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.inputShape}</dt>
      <dd><InlineMath latex={latexShape(trace.fixture.inputShape)} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.outputShape}</dt>
      <dd><InlineMath latex={latexShape(trace.fixture.outputShape)} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.upstreamShape}</dt>
      <dd><InlineMath latex={latexShape(trace.fixture.upstreamShape)} /></dd>
    </div>
  </dl>

  <section class="diagram-stage axes-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-axes`}>
    <h4 id={`${titleId}-axes`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">1</span> {labels.stages.axes}</h4>
    <p>{labels.notes.axes}</p>
    <div class="axis-flow">
      <div data-diagram-card data-diagram-box>
        <strong>{labels.fields.input}</strong>
        <InlineMath latex={latexShape(trace.fixture.inputShape)} />
      </div>
      <p class="flow-rule">
        <span class="flow-arrow" aria-hidden="true">→</span>
        <span>{labels.symbols.preserved}</span>
      </p>
      <div data-diagram-card data-diagram-box>
        <strong>{labels.fields.output}</strong>
        <InlineMath latex={latexShape(trace.fixture.outputShape)} />
      </div>
    </div>
    <p class="axis-proof">
      <span>{labels.symbols.mixed}</span>
      <InlineMath latex={String.raw`${latexShape(trace.axes.inputLeading)}=${latexShape(trace.axes.outputLeading)}`} />
    </p>
  </section>

  <div class="stage-grid course-diagram__grid">
    <section class="diagram-stage weights-stage course-diagram__card-stack" data-diagram-card data-diagram-box aria-labelledby={`${titleId}-weights`}>
      <h4 id={`${titleId}-weights`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">2</span> {labels.stages.weights}</h4>
      <div class="table-scroll course-diagram__scroll" role="region" tabindex="0" aria-label={labels.scrollers.weights} data-diagram-scroll>
        <table data-diagram-table>
          <thead>
            <tr>
              <th scope="col">{labels.fields.parameter}</th>
              <th scope="col">{labels.fields.value}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row"><InlineMath latex="W" /></th>
              <td><InlineMath latex={weightMatrixLatex} /></td>
            </tr>
            <tr class="bias-row">
              <th scope="row">{labels.fields.bias}</th>
              <td><InlineMath latex={latexVector(trace.bias)} /></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="diagram-stage positions-stage course-diagram__card-stack" data-diagram-card data-diagram-box aria-labelledby={`${titleId}-positions`}>
      <h4 id={`${titleId}-positions`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">3</span> {labels.stages.positions}</h4>
      <div class="table-scroll course-diagram__scroll" role="region" tabindex="0" aria-label={labels.scrollers.positions} data-diagram-scroll>
        <table data-diagram-table>
          <thead>
            <tr>
              <th scope="col">{labels.fields.position}</th>
              <th scope="col">{labels.fields.coordinate}</th>
              <th scope="col">{labels.fields.input}</th>
              <th scope="col">{labels.fields.output}</th>
            </tr>
          </thead>
          <tbody>
            {positionRows.map((row) => (
              <tr>
                <th scope="row"><InlineMath latex={row.position.lexeme} /></th>
                <td><InlineMath latex={latexCoordinate(row.coordinate)} /></td>
                <td><InlineMath latex={latexVector(row.input)} /></td>
                <td><InlineMath latex={latexVector(row.output)} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <section class="diagram-stage contribution-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-contribution`}>
    <h4 id={`${titleId}-contribution`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">4</span> {labels.stages.contribution}</h4>
    <p>{labels.notes.contribution}</p>
    <dl class="contribution-grid course-diagram__grid">
      <div data-diagram-card data-diagram-box>
        <dt>{labels.fields.coordinate}</dt>
        <dd><InlineMath latex={String.raw`${latexCoordinate(selectedCell.coordinate)},\;y_{${selectedCell.outputFeature.lexeme}}`} /></dd>
      </div>
      <div data-diagram-card data-diagram-box class="products-card">
        <dt>{labels.fields.result}</dt>
        <dd><InlineMath latex={contributionLatex} /></dd>
      </div>
    </dl>
  </section>

  <section class="diagram-stage policy-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-policy`}>
    <h4 id={`${titleId}-policy`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">5</span> {labels.stages.policy}</h4>
    <p>{labels.notes.policy}</p>
    <table class="policy-comparison" data-diagram-table>
      <colgroup>
        <col class="policy-position-column" />
        <col />
      </colgroup>
      <thead>
        <tr>
          <th scope="col">{labels.fields.position}</th>
          <th scope="col">{labels.fields.output}</th>
        </tr>
      </thead>
      <tbody>
        {policyRows.map((row) => (
          <tr>
            <th scope="row"><InlineMath latex={row.position} /></th>
            <td>
              <div class="policy-paths">
                <div class="policy-path affine-policy">
                  <strong><span aria-hidden="true">{labels.symbols.affine}</span> {labels.policies.affine}</strong>
                  <span>{labels.fields.parameters}: <InlineMath latex={trace.policy.affineParameters.lexeme} /></span>
                  <InlineMath latex={latexVector(row.affine)} />
                </div>
                <div class="policy-path bias-free-policy">
                  <strong><span aria-hidden="true">{labels.symbols.biasFree}</span> {labels.policies.biasFree}</strong>
                  <span>{labels.fields.parameters}: <InlineMath latex={trace.policy.biasFreeParameters.lexeme} /></span>
                  <InlineMath latex={latexVector(row.biasFree!)} />
                </div>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="diagram-stage gradients-stage course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-gradients`}>
    <h4 id={`${titleId}-gradients`} class="course-diagram__card-heading"><span class="state-symbol" aria-hidden="true">6</span> {labels.stages.gradients}</h4>
    <p>{labels.notes.gradients}</p>
    <div class="table-scroll gradient-tables course-diagram__scroll" role="region" tabindex="0" aria-label={labels.scrollers.gradients} data-diagram-scroll>
      <table data-diagram-table class="position-gradient-table">
        <caption>{labels.captions.positionGradients}</caption>
        <colgroup>
          <col class="position-gradient-name" />
          <col class="position-gradient-coordinate" />
          <col class="position-gradient-upstream" />
          <col class="position-gradient-input" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col" aria-label={labels.fields.position}><InlineMath latex="p" /></th>
            <th scope="col" aria-label={labels.fields.coordinate}><InlineMath latex="(b,t)" /></th>
            <th scope="col" aria-label={labels.fields.upstream}><InlineMath latex="G_p" /></th>
            <th scope="col" aria-label={labels.fields.inputGradient}><InlineMath latex="dX_p" /></th>
          </tr>
        </thead>
        <tbody>
          {trace.positionGradients.map((row) => (
            <tr>
              <th scope="row"><InlineMath latex={String.raw`dX_{${row.position.lexeme}}`} /></th>
              <td><InlineMath latex={latexCoordinate(row.coordinate)} /></td>
              <td>
                <InlineMath latex={latexVector(row.upstream)} />
              </td>
              <td>
                <InlineMath latex={latexVector(row.inputGradient)} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <table data-diagram-table class="parameter-gradient-table">
        <caption>{labels.captions.parameterGradients}</caption>
        <colgroup>
          <col class="parameter-gradient-name" />
          <col class="parameter-gradient-accumulation" />
          <col class="parameter-gradient-value" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col" aria-label={labels.fields.parameter}><InlineMath latex="\theta" /></th>
            <th scope="col" aria-label={labels.fields.accumulation}><InlineMath latex="\sum_p" /></th>
            <th scope="col" aria-label={labels.fields.gradient}><InlineMath latex="d\theta" /></th>
          </tr>
        </thead>
        <tbody>
          <tr class="shared-gradient">
            <th scope="row"><InlineMath latex="dW" /></th>
            <td><InlineMath latex={weightAccumulationLatex} /></td>
            <td>
              <span class="gradient-value">
                <InlineMath latex={latexShape(trace.weightGradient.shape)} />
                <InlineMath latex={weightGradientLatex} />
              </span>
            </td>
          </tr>
          <tr class="shared-gradient">
            <th scope="row"><InlineMath latex="db" /></th>
            <td><InlineMath latex={biasAccumulationLatex} /></td>
            <td>
              <span class="gradient-value">
                <InlineMath latex={latexShape(trace.biasGradient.shape)} />
                <InlineMath latex={latexVector(trace.biasGradient.values)} />
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</figure>

<style>
  .linear-layers-diagram {
    --diagram-summary-min: 9.5rem;
  }

  .diagram-stage {
    min-inline-size: 0;
  }

  .stage-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    align-items: start;
  }

  .table-scroll {
    --diagram-scroll-inline-size: 100%;
  }

  table {
    inline-size: 100%;
    min-inline-size: 28rem;
  }

  .positions-stage table {
    min-inline-size: 42rem;
  }

  .position-gradient-table,
  .parameter-gradient-table {
    min-inline-size: 28rem;
  }

  .parameter-gradient-table {
    margin-block-start: 1rem;
  }

  .bias-row > * {
    border-block-start-style: dashed !important;
    border-block-start-width: 2px !important;
  }

  .shared-gradient > * {
    border-block-end-style: double !important;
    border-block-end-width: 3px !important;
  }

  .axis-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
  }

  .axis-flow > div {
    display: grid;
    gap: 0.35rem;
  }

  .flow-rule,
  .axis-proof {
    margin: 0;
    text-align: center;
  }

  .flow-rule span {
    display: block;
  }

  .flow-arrow {
    font-size: 1.35rem;
    font-weight: 800;
  }

  .linear-layers-diagram:dir(rtl) .flow-arrow {
    transform: scaleX(-1);
  }

  .axis-proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .contribution-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
  }

  .products-card {
    grid-column: 1 / -1;
  }

  .policy-comparison {
    min-inline-size: 0;
    table-layout: fixed;
  }

  .policy-comparison th,
  .policy-comparison td {
    overflow-wrap: anywhere;
  }

  .policy-position-column {
    inline-size: 24%;
  }

  .policy-paths,
  .policy-path {
    display: grid;
  }

  .policy-paths {
    gap: 0.45rem;
  }

  .policy-path {
    gap: 0.25rem;
    padding-inline-start: 0.45rem;
  }

  .policy-path strong {
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }

  .affine-policy {
    border-inline-start-style: solid !important;
    border-inline-start-width: 4px !important;
  }

  .bias-free-policy {
    border-inline-start-style: double !important;
    border-inline-start-width: 5px !important;
  }

  .gradient-value {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.5rem;
    align-items: baseline;
  }

  .position-gradient-name {
    inline-size: 15%;
  }

  .position-gradient-coordinate {
    inline-size: 20%;
  }

  .position-gradient-upstream {
    inline-size: 35%;
  }

  .position-gradient-input {
    inline-size: 30%;
  }

  .parameter-gradient-name {
    inline-size: 15%;
  }

  .parameter-gradient-accumulation {
    inline-size: 38%;
  }

  .parameter-gradient-value {
    inline-size: 47%;
  }

  @container course-diagram (max-width: 44rem) {
    .stage-grid,
    .axis-flow {
      grid-template-columns: minmax(0, 1fr);
    }

    .flow-arrow,
    .linear-layers-diagram:dir(rtl) .flow-arrow {
      transform: rotate(90deg);
    }
  }

  @media (min-width: 64rem) and (min-height: 36rem) {
    .linear-layers-diagram:fullscreen {
      grid-template-columns:
        minmax(0, 3fr)
        minmax(0, 3fr)
        minmax(0, 3.5fr)
        minmax(0, 4.5fr)
        minmax(0, 2fr);
      grid-template-areas:
        "caption caption caption caption actions"
        "summary summary summary summary summary"
        "axes axes stages stages stages"
        "contribution policy policy gradients gradients";
      align-content: start;
      align-items: start;
    }

    .linear-layers-diagram:fullscreen > figcaption {
      grid-area: caption;
    }

    .linear-layers-diagram:fullscreen > :global(.diagram-full-view-actions) {
      grid-area: actions;
      align-self: start;
    }

    .linear-layers-diagram:fullscreen > .shape-summary {
      grid-area: summary;
      grid-template-columns: repeat(9, minmax(0, 1fr));
    }

    .linear-layers-diagram:fullscreen > .shape-summary > :first-child {
      grid-column: span 2;
    }

    .linear-layers-diagram:fullscreen > .shape-summary > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) max-content;
      align-items: baseline;
      column-gap: 0.4rem;
    }

    .linear-layers-diagram:fullscreen > .shape-summary dd {
      margin-block-start: 0;
    }

    .linear-layers-diagram:fullscreen > .axes-stage {
      grid-area: axes;
    }

    .linear-layers-diagram:fullscreen > .stage-grid {
      grid-area: stages;
      grid-template-columns: minmax(15rem, 0.8fr) minmax(21rem, 1.2fr);
    }

    .linear-layers-diagram:fullscreen .weights-stage table {
      min-inline-size: 13rem;
      table-layout: fixed;
    }

    .linear-layers-diagram:fullscreen .positions-stage table {
      min-inline-size: 21rem;
      table-layout: fixed;
    }

    .linear-layers-diagram:fullscreen > .contribution-stage {
      grid-area: contribution;
    }

    .linear-layers-diagram:fullscreen > .contribution-stage > .contribution-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: dense;
    }

    .linear-layers-diagram:fullscreen > .policy-stage {
      grid-area: policy;
    }

    .linear-layers-diagram:fullscreen .policy-position-column {
      inline-size: 18%;
    }

    .linear-layers-diagram:fullscreen .policy-paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--diagram-gap);
      align-items: start;
    }

    .linear-layers-diagram:fullscreen > .gradients-stage {
      grid-area: gradients;
    }

    .linear-layers-diagram:fullscreen > .gradients-stage > .gradient-tables {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--diagram-gap);
      align-items: start;
    }

    .linear-layers-diagram:fullscreen :is(.position-gradient-table, .parameter-gradient-table) {
      inline-size: 100%;
      max-inline-size: 100%;
      min-inline-size: 0;
      table-layout: fixed;
    }

    .linear-layers-diagram:fullscreen .parameter-gradient-table {
      margin-block-start: 0;
    }
  }
</style>
