---
// @ts-ignore Node filesystem access is used only while generating static HTML.
import { readFileSync } from 'node:fs';

import {
  assertStableSoftmaxDiagramLabels,
  parseStableSoftmaxTrace,
  stableSoftmaxDiagramId,
  type StableSoftmaxDiagramLabels,
  type TraceNumber,
} from '../../lib/stable-softmax-diagram';

interface Props {
  labels: StableSoftmaxDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'stable-softmax-diagram' } = Astro.props as Props;
assertStableSoftmaxDiagramLabels(labels);
const fixtureUrl = new URL(
  '../../../../rust/demos/ch12-stable-softmax/diagram-trace.txt',
  import.meta.url,
);
const trace = parseStableSoftmaxTrace(readFileSync(fixtureUrl, 'utf8'));
const sharedDenominator = trace.rows[0]?.denominator;
if (!sharedDenominator) throw new Error('Stable softmax trace has no rows.');
const titleId = `${instanceId}-title`;
const descriptionId = `${instanceId}-description`;

function list(values: readonly TraceNumber[]): string {
  return `[${values.map(({ lexeme }) => lexeme).join(', ')}]`;
}

function naiveStatus(status: (typeof trace.naive)[number]['status']): string {
  if (status === 'finite') return labels.statuses.finite;
  if (status === 'overflow-undefined') return labels.statuses.overflowUndefined;
  return labels.statuses.underflowUndefined;
}

function naiveSymbol(status: (typeof trace.naive)[number]['status']): string {
  if (status === 'finite') return labels.symbols.finite;
  if (status === 'overflow-undefined') return labels.symbols.overflow;
  return labels.symbols.underflow;
}
---

<figure
  class="course-diagram softmax-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={stableSoftmaxDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
  </figcaption>

  <dl class="summary-grid">
    <div>
      <dt>{labels.summary.shape}</dt>
      <dd><bdi dir="ltr">{list(trace.input.shape)}</bdi></dd>
    </div>
    <div>
      <dt>{labels.summary.axis}</dt>
      <dd><bdi dir="ltr">{trace.input.axis.lexeme}</bdi></dd>
    </div>
    <div>
      <dt>{labels.summary.meanNll}</dt>
      <dd><bdi dir="ltr">{trace.meanNll.value.lexeme}</bdi></dd>
    </div>
  </dl>

  <section data-diagram-box aria-labelledby={`${instanceId}-shift`}>
    <h4 id={`${instanceId}-shift`}>{labels.sections.shift}</h4>
    <p>{labels.notes.shift}</p>
    <div
      class="trace-scroll course-diagram__scroll"
      role="region"
      tabindex="0"
      aria-label={labels.sections.shift}
      data-diagram-scroll
    >
      <table data-diagram-table class="shift-table">
        <colgroup>
          <col class="shift-stage-column" />
          {trace.rows.map(() => <col />)}
        </colgroup>
        <thead>
          <tr>
            <th scope="col">{labels.sections.shift}</th>
            {trace.rows.map((row) => (
              <th
                scope="col"
                data-softmax-row={row.row.lexeme}
                data-maximum={row.maximum.lexeme}
                data-shifted={row.shifted.map(({ lexeme }) => lexeme).join(',')}
                data-probabilities={row.probabilities.map(({ lexeme }) => lexeme).join(',')}
                data-log-probabilities={row.logProbabilities
                  .map(({ lexeme }) => lexeme)
                  .join(',')}
              >
                {labels.fields.row} <bdi dir="ltr">{row.row.lexeme}</bdi>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{labels.fields.rawLogits}</th>
            {trace.rows.map((row) => <td><bdi dir="ltr">{list(row.logits)}</bdi></td>)}
          </tr>
          <tr>
            <th scope="row">{labels.fields.maximum}</th>
            {trace.rows.map((row) => <td><bdi dir="ltr">{row.maximum.lexeme}</bdi></td>)}
          </tr>
          <tr>
            <th scope="row">{labels.fields.shifted}</th>
            {trace.rows.map((row) => <td><bdi dir="ltr">{list(row.shifted)}</bdi></td>)}
          </tr>
          <tr>
            <th scope="row">{labels.fields.exponentials}</th>
            {trace.rows.map((row) => <td><bdi dir="ltr">{list(row.exponentials)}</bdi></td>)}
          </tr>
          <tr>
            <th scope="row">{labels.fields.naivePath}</th>
            {trace.naive.map((naive) => (
              <td
                class:list={['naive-cell', `state-${naive.status}`]}
                data-naive-status={naive.status}
              >
                <span class="naive-cell-content course-diagram__card-heading">
                  <span class="state-symbol" aria-hidden="true">{naiveSymbol(naive.status)}</span>
                  <span>
                    {naiveStatus(naive.status)}
                    {naive.status === 'finite' && (
                      <>: <bdi dir="ltr">{list(naive.exponentials)}</bdi></>
                    )}
                  </span>
                </span>
              </td>
            ))}
          </tr>
          <tr data-stable-probability-row>
            <th scope="row">
              <span class="state-symbol" aria-hidden="true">{labels.symbols.stable}</span>{' '}
              {labels.fields.probabilities}
            </th>
            {trace.rows.map((row) => (
              <td><bdi dir="ltr">{list(row.probabilities)}</bdi></td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
    <p
      class="invariance-note course-diagram__card-heading"
      data-diagram-card
      data-diagram-box
      data-state="trusted"
      data-probabilities-match={trace.invariance.probabilitiesMatch}
      data-denominator={sharedDenominator.lexeme}
    >
      <span class="state-symbol" aria-hidden="true">{labels.symbols.stable}</span>
      <strong>{labels.statuses.probabilitiesMatch}</strong>
      <span class="denominator-evidence">
        <span>{labels.fields.denominator}:</span>
        <bdi dir="ltr">{sharedDenominator.lexeme}</bdi>
      </span>
    </p>
  </section>

  <section data-diagram-box aria-labelledby={`${instanceId}-targets`}>
    <h4 id={`${instanceId}-targets`}>{labels.sections.targets}</h4>
    <p>{labels.notes.targets}</p>
    <div class="target-grid course-diagram__grid">
      {trace.targetLosses.map((target) => (
        <article data-diagram-card data-diagram-box
          class="target-card course-diagram__card-stack"
          data-target-row={target.row.lexeme}
          data-target-class={target.classIndex.lexeme}
          data-target-loss={target.loss.lexeme}
        >
          <h5>{labels.fields.row} <bdi dir="ltr">{target.row.lexeme}</bdi></h5>
          <p>
            {labels.fields.targetClass}: <bdi dir="ltr">{target.classIndex.lexeme}</bdi>
          </p>
          <p>
            {labels.fields.logProbabilities}: <bdi dir="ltr">{target.logProbability.lexeme}</bdi>
          </p>
          <p>
            {labels.fields.targetLoss}: <bdi dir="ltr">{target.loss.lexeme}</bdi>
          </p>
        </article>
      ))}
    </div>
  </section>

  <section data-diagram-box aria-labelledby={`${instanceId}-errors`}>
    <h4 id={`${instanceId}-errors`}>{labels.sections.errors}</h4>
    <p>{labels.notes.errors}</p>
    <div class="error-grid course-diagram__grid">
      {trace.errors.map((error) => (
        <article data-diagram-card data-diagram-box data-state="rejected" class="error-card course-diagram__card-stack" data-error-kind={error.kind}>
          <span class="state-symbol" aria-hidden="true">{labels.symbols.rejected}</span>
          <h5><code>{error.kind}</code></h5>
          {error.kind === 'axis-out-of-bounds' && (
            <p>
              {labels.summary.axis} <bdi dir="ltr">{error.axis.lexeme}</bdi>;{' '}
              {labels.fields.rank}{' '}
              <bdi dir="ltr">{error.rank.lexeme}</bdi>
            </p>
          )}
          {error.kind === 'empty-normalization-axis' && (
            <p>{labels.summary.axis} <bdi dir="ltr">{error.axis.lexeme}</bdi></p>
          )}
          {error.kind === 'positive-infinity-logit' && (
            <p>
              {labels.fields.group} <bdi dir="ltr">{error.group.lexeme}</bdi>;{' '}
              {labels.fields.targetClass} <bdi dir="ltr">{error.classIndex.lexeme}</bdi>
            </p>
          )}
          {error.kind === 'target-out-of-bounds' && (
            <p>
              {labels.fields.group} <bdi dir="ltr">{error.group.lexeme}</bdi>;{' '}
              {labels.fields.targetClass} <bdi dir="ltr">{error.target.lexeme}</bdi>;{' '}
              {labels.fields.classes} <bdi dir="ltr">{error.classes.lexeme}</bdi>
            </p>
          )}
        </article>
      ))}
    </div>
  </section>
</figure>

<style>
  .softmax-diagram { align-content: start; }

  .summary-grid,
  .target-grid,
  .error-grid {
    align-items: start;
  }

  .target-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .error-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }

  .shift-table {
    inline-size: 100%;
    min-inline-size: 64rem;
  }

  .shift-stage-column {
    width: 11rem;
  }

  .naive-cell.state-finite { border-style: solid; }

  .naive-cell.state-overflow-undefined { border-style: dashed; }

  .naive-cell.state-underflow-undefined { border-style: dotted; }

  @container course-diagram (max-width: 760px) {
    .target-grid,
    .error-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 64rem) and (min-height: 36rem) {
    .softmax-diagram:fullscreen {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-content: start;
    }

    figure.softmax-diagram.course-diagram[data-diagram-style='course-v1']:fullscreen {
      row-gap: 0.1rem;
    }

    .softmax-diagram:fullscreen > figcaption {
      grid-column: 1 / -1;
      grid-row: 1;
      grid-template-columns: minmax(25rem, 0.62fr) minmax(0, 1.38fr);
      align-items: start;
      column-gap: 1rem;
    }

    .softmax-diagram:fullscreen > figcaption > :is(h3, p) { max-inline-size: none; }

    .softmax-diagram:fullscreen > .summary-grid {
      grid-column: 1 / 10;
      grid-row: 2;
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 0.7fr) minmax(0, 1.6fr);
    }

    .softmax-diagram:fullscreen > :global(.diagram-full-view-actions) {
      grid-column: 10 / -1;
      grid-row: 2;
      align-self: start;
      justify-self: end;
    }

    .softmax-diagram:fullscreen > section:first-of-type {
      grid-column: 1 / -1;
      grid-row: 3;
      display: grid;
      grid-template-columns: 18rem minmax(0, 1fr);
      align-items: start;
      column-gap: 1rem;
    }

    .softmax-diagram:fullscreen > section:first-of-type > :is(h4, p) {
      grid-column: 1;
    }

    .softmax-diagram:fullscreen > section:first-of-type > .trace-scroll {
      grid-column: 2;
      grid-row: 1 / span 3;
    }

    .softmax-diagram:fullscreen > section:first-of-type > .invariance-note {
      display: grid;
      grid-column: 1;
      grid-row: 3;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
    }

    .softmax-diagram:fullscreen .invariance-note > .denominator-evidence {
      display: flex;
      grid-column: 1 / -1;
      flex-wrap: wrap;
      gap: 0.2rem 0.45rem;
    }

    .softmax-diagram:fullscreen .denominator-evidence > bdi {
      white-space: nowrap;
    }

    .softmax-diagram:fullscreen .shift-table { min-inline-size: 0; }

    .softmax-diagram:fullscreen > section:nth-of-type(2) {
      grid-column: 1 / 8;
      grid-row: 4;
    }

    .softmax-diagram:fullscreen > section:nth-of-type(3) {
      grid-column: 8 / -1;
      grid-row: 4;
    }

    .softmax-diagram:fullscreen .target-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .softmax-diagram:fullscreen .error-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .softmax-diagram:fullscreen .error-card {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0.35rem 0.55rem;
    }

    .softmax-diagram:fullscreen .error-card > :is(.state-symbol, h5) {
      grid-row: 1;
    }

    .softmax-diagram:fullscreen .error-card > p {
      grid-column: 1 / -1;
    }
  }
</style>
