---
import traceSource from '../../../../rust/demos/ch29-rope/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  parseRopeTrace,
  validateRopeDiagramLabels,
  type RopeDiagramLabels,
  type RopeTraceVector,
} from '../../lib/rope-diagram';

interface Props {
  labels: RopeDiagramLabels;
}

const { labels } = Astro.props;
validateRopeDiagramLabels(labels);
const trace = parseRopeTrace(traceSource);
const titleId = 'rope-diagram-title';
const descriptionId = 'rope-diagram-description';
const pairVector = (first: string, second: string) => `[${first},${second}]`;
const pairRows = trace.positions.flatMap((position) => [
  {
    position: position.position,
    pair: trace.frequencies[0],
    cue: labels.cues.fastPair,
    angle: position.angles.values[0],
    before: pairVector(position.queryBefore.values[0], position.queryBefore.values[1]),
    after: pairVector(position.queryAfter.values[0], position.queryAfter.values[1]),
    className: 'fast-pair',
  },
  {
    position: position.position,
    pair: trace.frequencies[1],
    cue: labels.cues.slowPair,
    angle: position.angles.values[1],
    before: pairVector(position.queryBefore.values[2], position.queryBefore.values[3]),
    after: pairVector(position.queryAfter.values[2], position.queryAfter.values[3]),
    className: 'slow-pair',
  },
]);
const matrixRows = (vector: RopeTraceVector) => [
  vector.values.slice(0, 3),
  vector.values.slice(3, 6),
  vector.values.slice(6, 9),
];
const beforeGrid = matrixRows(trace.commonShift.beforeGrid);
const afterGrid = matrixRows(trace.commonShift.afterGrid);
const keyPositions = ['0', '1', '2'];
const verified = (value: string) => value === 'true' ? labels.cues.verified : labels.cues.rejected;
const errorLabels: Record<string, string> = {
  'odd-width': labels.errorCases.oddWidth,
  'input-rank': labels.errorCases.inputRank,
  'width-mismatch': labels.errorCases.widthMismatch,
  'position-range': labels.errorCases.positionRange,
  'offset-overflow': labels.errorCases.offsetOverflow,
  'released-input': labels.errorCases.releasedInput,
};
const historyRows = [
  { title: labels.fields.earlier, value: trace.history.earlier, className: 'earlier-stage' },
  { title: labels.fields.transformer, value: trace.history.transformer, className: 'transformer-stage' },
  { title: labels.fields.rotary, value: trace.history.rotary, className: 'rotary-stage' },
  { title: labels.fields.modern, value: trace.history.modern_example, className: 'modern-stage' },
];
---

<figure
  class="rope-diagram"
  data-visualization-id="rotary-position-pairs"
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption>
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description">{labels.description}</p>
    <ul class="cue-list" aria-label={labels.captions.rotations}>
      <li class="fast-cue">{labels.cues.fastPair}</li>
      <li class="slow-cue">{labels.cues.slowPair}</li>
      <li class="zero-cue">{labels.cues.zeroOffset}</li>
      <li class="positive-cue">{labels.cues.positiveOffset}</li>
      <li class="negative-cue">{labels.cues.negativeOffset}</li>
    </ul>
  </figcaption>

  <section class="diagram-section rotation-section" aria-labelledby="rope-rotation-title">
    <h4 id="rope-rotation-title">{labels.sections.rotations}</h4>
    <p class="section-caption">{labels.captions.rotations}</p>
    <p class="formula-line">
      <InlineMath latex="\left(\operatorname{RoPE}(x_m)\right)_{2k:2k+2}=R(m\theta_k)(x_m)_{2k:2k+2}" />
    </p>
    <div
      class="rotation-scroller technical"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.rotations}
    >
      <table class="evidence-table rotation-table">
        <caption>{labels.captions.rotations}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.position}</th>
            <th scope="col">{labels.fields.pair}</th>
            <th scope="col">{labels.fields.features}</th>
            <th scope="col">{labels.fields.frequency}</th>
            <th scope="col">{labels.fields.angle}</th>
            <th scope="col">{labels.fields.before}</th>
            <th scope="col">{labels.fields.after}</th>
          </tr>
        </thead>
        <tbody>
          {pairRows.map((row) => (
            <tr class={row.className} data-position={row.position} data-pair={row.pair.pair}>
              <th scope="row"><InlineMath latex={'m=' + row.position} /></th>
              <td>
                <InlineMath latex={'k=' + row.pair.pair} />
                <small>{row.cue}</small>
              </td>
              <td><InlineMath latex={pairVector(row.pair.features[0], row.pair.features[1])} /></td>
              <td><InlineMath latex={String.raw`\theta_${row.pair.pair}=${row.pair.theta}`} /></td>
              <td><InlineMath latex={row.angle} /></td>
              <td><InlineMath latex={row.before} /></td>
              <td><InlineMath latex={row.after} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="diagram-section dot-section" aria-labelledby="rope-dot-title">
    <h4 id="rope-dot-title">{labels.sections.dots}</h4>
    <p class="section-caption">{labels.captions.dots}</p>
    <p class="formula-line">
      <InlineMath latex="\left(R(m\theta_k)q\right)^\top\left(R(n\theta_k)k\right)=q^\top R((n-m)\theta_k)k" />
    </p>
    <div
      class="dot-scroller technical"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.dots}
    >
      <table class="evidence-table dot-table">
        <caption>{labels.captions.dots}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.queryPosition} / {labels.fields.keyPosition}</th>
            {keyPositions.map((key) => <th scope="col"><InlineMath latex={'n=' + key} /></th>)}
          </tr>
        </thead>
        <tbody>
          {trace.dotRows.map((row) => (
            <tr>
              <th scope="row"><InlineMath latex={'m=' + row.queryPosition} /></th>
              {row.values.values.map((value, index) => {
                const offset = row.relativeOffsets[index];
                const offsetClass = offset === '0'
                  ? 'zero-offset'
                  : offset.startsWith('-') ? 'negative-offset' : 'positive-offset';
                const cue = offset === '0'
                  ? labels.cues.zeroOffset
                  : offset.startsWith('-') ? labels.cues.negativeOffset : labels.cues.positiveOffset;
                return (
                  <td
                    class={offsetClass}
                    data-query-position={row.queryPosition}
                    data-key-position={keyPositions[index]}
                    data-relative-offset={offset}
                    data-dot={value}
                  >
                    <InlineMath latex={value} />
                    <small><InlineMath latex={'n-m=' + offset} /> · {cue}</small>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="shift-grid">
      <article class="shift-card original-shift" data-shift-grid="original">
        <h5>{labels.fields.originalGrid}</h5>
        <p>{labels.fields.originalPositions}: <InlineMath latex="[0,1,2]" /></p>
        <div class="shift-scroller technical" tabindex="0" role="region" aria-label={labels.scrollers.shift}>
          <table class="compact-matrix">
            <caption>{labels.fields.originalGrid}</caption>
            <tbody>
              {beforeGrid.map((row, index) => (
                <tr>
                  <th scope="row"><InlineMath latex={'m=' + trace.commonShift.beforePositions[index]} /></th>
                  {row.map((value) => <td><InlineMath latex={value} /></td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>
      <article class="shift-card shifted-shift" data-shift-grid="shifted">
        <h5>{labels.fields.shiftedGrid}</h5>
        <p>{labels.fields.shiftedPositions}: <InlineMath latex="[3,4,5]" /></p>
        <div class="shift-scroller technical" tabindex="0" role="region" aria-label={labels.scrollers.shift}>
          <table class="compact-matrix">
            <caption>{labels.fields.shiftedGrid}</caption>
            <tbody>
              {afterGrid.map((row, index) => (
                <tr>
                  <th scope="row"><InlineMath latex={'m=' + trace.commonShift.afterPositions[index]} /></th>
                  {row.map((value) => <td><InlineMath latex={value} /></td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>
      <article class="shift-card shift-proof" data-common-shift={trace.commonShift.preserved}>
        <h5>{labels.fields.proof}</h5>
        <p class="status-line">{verified(trace.commonShift.preserved)}</p>
        <p><InlineMath latex={String.raw`\varepsilon=${trace.commonShift.tolerance}`} /></p>
      </article>
    </div>
  </section>

  <section class="diagram-section evidence-section" aria-labelledby="rope-evidence-title">
    <h4 id="rope-evidence-title">{labels.sections.evidence}</h4>
    <p class="section-caption">{labels.captions.evidence}</p>
    <div class="evidence-grid">
      <article class="evidence-card norm-card" data-norm-preserved={trace.norm.preserved}>
        <h5>{labels.fields.norm}</h5>
        <dl class="technical">
          <div>
            <dt>{labels.fields.before}</dt>
            <dd
              class="norm-value-scroller"
              tabindex="0"
              role="region"
              aria-label={`${labels.fields.norm}: ${labels.fields.before}`}
            ><InlineMath latex={trace.norm.input.latex} /></dd>
          </div>
          <div>
            <dt>{labels.fields.after}</dt>
            <dd
              class="norm-value-scroller"
              tabindex="0"
              role="region"
              aria-label={`${labels.fields.norm}: ${labels.fields.after}`}
            ><InlineMath latex={trace.norm.rotated.latex} /></dd>
          </div>
          <div>
            <dt>{labels.fields.shiftedPositions}</dt>
            <dd
              class="norm-value-scroller"
              tabindex="0"
              role="region"
              aria-label={`${labels.fields.norm}: ${labels.fields.shiftedPositions}`}
            ><InlineMath latex={trace.norm.shifted.latex} /></dd>
          </div>
        </dl>
        <p class="status-line">{verified(trace.norm.preserved)}</p>
      </article>

      <article class="evidence-card shape-card">
        <h5>{labels.fields.shape}</h5>
        <ul class="technical">
          {trace.shapes.map((record) => (
            <li data-shape-case={record.tag}>
              <code>{record.tag}</code>
              <InlineMath latex={record.fields.output_shape} />
              <strong>{verified(record.fields.valid)}</strong>
            </li>
          ))}
        </ul>
      </article>

      <article class="evidence-card error-card">
        <h5>{labels.fields.errors}</h5>
        <ul>
          {trace.errors.map((error) => (
            <li data-error-case={error.case}>
              <span>{errorLabels[error.case]}</span>
              <code>{error.kind}</code>
              <strong>{verified(error.rejected)}</strong>
            </li>
          ))}
        </ul>
      </article>
    </div>

    <div
      class="gradient-scroller technical"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.gradients}
    >
      <table class="evidence-table gradient-table">
        <caption>{labels.fields.backward}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.pair}</th>
            <th scope="col">{labels.fields.before}</th>
            <th scope="col">{labels.fields.backward}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><InlineMath latex="Q" /></th>
            <td><InlineMath latex={trace.backward.querySeed.latex} /></td>
            <td><InlineMath latex={trace.backward.queryGradient.latex} /></td>
          </tr>
          <tr>
            <th scope="row"><InlineMath latex="K" /></th>
            <td><InlineMath latex={trace.backward.keySeed.latex} /></td>
            <td><InlineMath latex={trace.backward.keyGradient.latex} /></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="proof-line" data-rope-proof>
      {labels.fields.proof}: <InlineMath latex={`${trace.proof.query_checks}+${trace.proof.key_checks}`} /> ·
      <InlineMath latex={String.raw`\varepsilon_g=${trace.proof.gradient_tolerance}`} /> ·
      {verified(trace.proof.gradcheck)}
    </p>
  </section>

  <section class="diagram-section history-section" aria-labelledby="rope-history-title">
    <h4 id="rope-history-title">{labels.sections.history}</h4>
    <p class="section-caption">{labels.captions.history}</p>
    <div
      class="history-scroller"
      tabindex="0"
      role="region"
      aria-label={labels.scrollers.history}
    >
      <ol class="history-grid">
        {historyRows.map((row) => (
          <li>
            <article class:list={['history-card', row.className]}>
              <h5>{row.title}</h5>
              <code>{row.value}</code>
            </article>
          </li>
        ))}
      </ol>
    </div>
    <p class="boundary-note"><code>{trace.history.causal_boundary}</code></p>
  </section>
</figure>

<style>
  .rope-diagram {
    box-sizing: border-box;
    max-width: 100%;
    margin: 2rem 0;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border: 2px solid var(--border, #667085);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--surface, #fff) 94%, var(--accent, #6d5dfc) 6%);
  }

  .rope-diagram:focus-visible,
  [tabindex="0"]:focus-visible {
    outline: 3px solid var(--accent, #6d5dfc);
    outline-offset: 3px;
  }

  h3, h4, h5, p { margin-block-start: 0; }
  h4 { margin-block-end: 0.35rem; }
  h5 { margin-block-end: 0.55rem; }
  .diagram-description, .section-caption { max-width: 76ch; }

  .cue-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cue-list li {
    padding: 0.35rem 0.65rem;
    border: 2px solid currentColor;
    border-radius: 999px;
  }

  .slow-cue, .slow-pair td { border-style: dashed; }
  .zero-cue, .zero-offset { border-style: double; }
  .positive-cue, .positive-offset { border-style: solid; }
  .negative-cue, .negative-offset { border-style: dashed; }

  .diagram-section {
    min-width: 0;
    margin-block-start: 1.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--border, #667085);
  }

  .formula-line {
    box-sizing: border-box;
    max-width: 100%;
    padding: 0.75rem;
    border-inline-start: 4px solid var(--accent, #6d5dfc);
    background: var(--surface, #fff);
    overflow-x: auto;
    direction: ltr;
    unicode-bidi: isolate;
  }

  .rotation-scroller,
  .dot-scroller,
  .shift-scroller,
  .gradient-scroller,
  .history-scroller {
    box-sizing: border-box;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .technical,
  .technical table,
  .technical dl,
  .technical ul {
    direction: ltr;
    unicode-bidi: isolate;
    text-align: start;
  }

  table {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  caption {
    padding-block-end: 0.45rem;
    text-align: start;
    font-weight: 650;
  }

  th, td {
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border, #667085);
    vertical-align: top;
    white-space: nowrap;
  }

  th { background: color-mix(in srgb, var(--surface, #fff) 88%, var(--accent, #6d5dfc) 12%); }
  td small { display: block; margin-block-start: 0.25rem; white-space: normal; }
  .rotation-table { min-width: 57rem; width: 100%; }
  .dot-table { min-width: 42rem; width: 100%; }
  .gradient-table { min-width: 67rem; width: 100%; }

  .fast-pair { border-inline-start: 4px solid currentColor; }
  .slow-pair { border-inline-start: 4px dashed currentColor; }
  .zero-offset { border: 3px double currentColor; }
  .negative-offset { border: 2px dashed currentColor; }
  .positive-offset { border: 2px solid currentColor; }

  .shift-grid,
  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 0.9rem;
    margin-block-start: 1rem;
  }

  .shift-card,
  .evidence-card,
  .history-card {
    box-sizing: border-box;
    min-width: 0;
    padding: 0.9rem;
    border: 2px solid var(--border, #667085);
    border-radius: 0.75rem;
    background: var(--surface, #fff);
  }

  .shifted-shift { border-style: dashed; }
  .shift-proof { border-style: double; border-width: 4px; }
  .compact-matrix { min-width: 22rem; width: 100%; }
  .status-line { font-weight: 750; }

  dl { margin: 0; }
  dl div { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.25rem; }
  dt { font-weight: 700; }
  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .norm-value-scroller {
    box-sizing: border-box;
    max-width: 100%;
    padding-block-end: 0.2rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .shape-card ul,
  .error-card ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shape-card li,
  .error-card li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    padding-block-end: 0.4rem;
    border-block-end: 1px dotted var(--border, #667085);
  }

  .gradient-scroller { margin-block-start: 1rem; }
  .proof-line, .boundary-note {
    margin-block: 0.9rem 0;
    padding: 0.7rem;
    border: 3px double var(--border, #667085);
    background: var(--surface, #fff);
  }

  .history-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(13rem, 1fr));
    align-items: start;
    gap: 0.75rem;
    min-width: 58rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .history-card { border-inline-start-width: 5px; }
  .transformer-stage { border-style: dashed; }
  .rotary-stage { border-style: double; border-width: 4px; }
  .modern-stage { border-inline-start-style: double; }
  .history-card code {
    display: block;
    direction: ltr;
    unicode-bidi: isolate;
    overflow-wrap: anywhere;
  }
  code { overflow-wrap: anywhere; }

  @media (max-width: 760px) {
    .rope-diagram { padding: 0.85rem; }
    .shift-grid, .evidence-grid { grid-template-columns: minmax(0, 1fr); }
    .rotation-table { min-width: 52rem; }
    .gradient-table { min-width: 60rem; }
  }

  @media (forced-colors: active) {
    .rope-diagram,
    .shift-card,
    .evidence-card,
    .history-card,
    th,
    .formula-line,
    .proof-line,
    .boundary-note {
      background: Canvas;
      color: CanvasText;
      border-color: CanvasText;
    }
    .rope-diagram:focus-visible,
    [tabindex="0"]:focus-visible { outline-color: Highlight; }
  }

  :global([dir="rtl"]) .rope-diagram { text-align: start; }
  :global([dir="rtl"]) .technical,
  :global([dir="rtl"]) .formula-line,
  :global([dir="rtl"]) .history-grid {
    direction: ltr;
    unicode-bidi: isolate;
  }
  :global([dir="rtl"]) .history-card { direction: rtl; }
</style>
