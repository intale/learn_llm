---
import traceSource from '../../../../rust/demos/ch29-rope/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  parseRopeTrace,
  validateRopeDiagramLabels,
  type RopeDiagramLabels,
  type RopeTraceVector,
} from '../../lib/rope-diagram';

interface Props {
  labels: RopeDiagramLabels;
}

const { labels } = Astro.props;
validateRopeDiagramLabels(labels);
const trace = parseRopeTrace(traceSource);
const titleId = 'rope-diagram-title';
const descriptionId = 'rope-diagram-description';
const pairVector = (first: string, second: string) => `[${first},${second}]`;
const pairRows = trace.positions.flatMap((position) => [
  {
    position: position.position,
    pair: trace.frequencies[0],
    cue: labels.cues.fastPair,
    angle: position.angles.values[0],
    before: pairVector(position.queryBefore.values[0], position.queryBefore.values[1]),
    after: pairVector(position.queryAfter.values[0], position.queryAfter.values[1]),
    className: 'fast-pair',
  },
  {
    position: position.position,
    pair: trace.frequencies[1],
    cue: labels.cues.slowPair,
    angle: position.angles.values[1],
    before: pairVector(position.queryBefore.values[2], position.queryBefore.values[3]),
    after: pairVector(position.queryAfter.values[2], position.queryAfter.values[3]),
    className: 'slow-pair',
  },
]);
const matrixRows = (vector: RopeTraceVector) => [
  vector.values.slice(0, 3),
  vector.values.slice(3, 6),
  vector.values.slice(6, 9),
];
const tokenRows = (vector: RopeTraceVector) => [
  vector.values.slice(0, 4),
  vector.values.slice(4, 8),
  vector.values.slice(8, 12),
];
const tokenMatrix = (vector: RopeTraceVector) => String.raw`\begin{bmatrix}${tokenRows(vector)
  .map((row) => row.join('&'))
  .join(String.raw`\\`)}\end{bmatrix}`;
const beforeGrid = matrixRows(trace.commonShift.beforeGrid);
const afterGrid = matrixRows(trace.commonShift.afterGrid);
const keyPositions = ['0', '1', '2'];
const verified = (value: string) => value === 'true' ? labels.cues.verified : labels.cues.rejected;
const errorLabels: Record<string, string> = {
  'odd-width': labels.errorCases.oddWidth,
  'input-rank': labels.errorCases.inputRank,
  'width-mismatch': labels.errorCases.widthMismatch,
  'position-range': labels.errorCases.positionRange,
  'offset-overflow': labels.errorCases.offsetOverflow,
  'released-input': labels.errorCases.releasedInput,
};
const shapeLabels: Record<string, string> = {
  RANK3: labels.shapeCases.rank3,
  RANK4: labels.shapeCases.rank4,
  EMPTY_LEADING: labels.shapeCases.emptyLeading,
  EMPTY_TOKENS: labels.shapeCases.emptyTokens,
};
const historyRows = [
  {
    title: labels.fields.earlier,
    detail: labels.historyDetails.earlier,
    value: trace.history.earlier,
    className: 'earlier-stage',
  },
  {
    title: labels.fields.transformer,
    detail: labels.historyDetails.transformer,
    value: trace.history.transformer,
    className: 'transformer-stage',
  },
  {
    title: labels.fields.rotary,
    detail: labels.historyDetails.rotary,
    value: trace.history.rotary,
    className: 'rotary-stage',
  },
  {
    title: labels.fields.modern,
    detail: labels.historyDetails.modern,
    value: trace.history.modern_example,
    className: 'modern-stage',
  },
];
---

<figure
  class="course-diagram rope-diagram"
  data-diagram-style="course-v1"
  data-visualization-id="rotary-position-pairs"
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description course-diagram__description">{labels.description}</p>
    <ul class="cue-list" aria-label={labels.captions.legend}>
      <li data-diagram-box class="fast-cue">{labels.cues.fastPair}</li>
      <li data-diagram-box class="slow-cue">{labels.cues.slowPair}</li>
      <li data-diagram-box class="zero-cue">{labels.cues.zeroOffset}</li>
      <li data-diagram-box class="positive-cue">{labels.cues.positiveOffset}</li>
      <li data-diagram-box class="negative-cue">{labels.cues.negativeOffset}</li>
    </ul>
  </figcaption>

  <section class="diagram-section rotation-section course-diagram__card-stack" data-diagram-box aria-labelledby="rope-rotation-title">
    <h4 id="rope-rotation-title">{labels.sections.rotations}</h4>
    <p class="section-caption">{labels.captions.rotations}</p>
    <div class="formula-line course-diagram__scroll" role="region" tabindex="0" aria-labelledby="rope-rotation-title" data-diagram-scroll>
      <InlineMath latex="\left(\operatorname{RoPE}(x_m)\right)_{2k:2k+2}=R(m\theta_k)(x_m)_{2k:2k+2}" />
    </div>
    <div class="rotation-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={labels.scrollers.rotations} data-diagram-scroll>
      <table data-diagram-table class="rotation-table">
        <caption>{labels.captions.rotations}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.position}</th>
            <th scope="col">{labels.fields.pair}</th>
            <th scope="col">{labels.fields.featureCoordinates}</th>
            <th scope="col">{labels.fields.frequency}</th>
            <th scope="col">{labels.fields.angle}</th>
            <th scope="col">{labels.fields.beforeRotation}</th>
            <th scope="col">{labels.fields.afterRotation}</th>
          </tr>
        </thead>
        <tbody>
          {pairRows.map((row) => (
            <tr class={row.className} data-position={row.position} data-pair={row.pair.pair}>
              <th scope="row"><InlineMath latex={'m=' + row.position} /></th>
              <td><InlineMath latex={'k=' + row.pair.pair} /><small>{row.cue}</small></td>
              <td><InlineMath latex={pairVector(row.pair.features[0], row.pair.features[1])} /></td>
              <td><InlineMath latex={String.raw`\theta_${row.pair.pair}=${row.pair.theta}`} /></td>
              <td><InlineMath latex={row.angle} /></td>
              <td><InlineMath latex={row.before} /></td>
              <td><InlineMath latex={row.after} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="diagram-section dot-section course-diagram__card-stack" data-diagram-box aria-labelledby="rope-dot-title">
    <h4 id="rope-dot-title">{labels.sections.dots}</h4>
    <p class="section-caption">{labels.captions.dots}</p>
    <div class="formula-line course-diagram__scroll" role="region" tabindex="0" aria-labelledby="rope-dot-title" data-diagram-scroll>
      <InlineMath latex="\left(R(m\theta_k)q\right)^\top\left(R(n\theta_k)k\right)=q^\top R((n-m)\theta_k)k" />
    </div>
    <div class="dot-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={labels.scrollers.dots} data-diagram-scroll>
      <table data-diagram-table class="dot-table">
        <caption><strong>{labels.fields.dot}</strong> — {labels.fields.relativeOffset}. {labels.captions.dots}</caption>
        <thead>
          <tr>
            <th scope="col">{labels.fields.queryPosition} / {labels.fields.keyPosition}</th>
            {keyPositions.map((key) => <th scope="col"><InlineMath latex={'n=' + key} /></th>)}
          </tr>
        </thead>
        <tbody>
          {trace.dotRows.map((row) => (
            <tr>
              <th scope="row"><InlineMath latex={'m=' + row.queryPosition} /></th>
              {row.values.values.map((value, index) => {
                const offset = row.relativeOffsets[index];
                const offsetClass = offset === '0' ? 'zero-offset' : offset.startsWith('-') ? 'negative-offset' : 'positive-offset';
                const cue = offset === '0' ? labels.cues.zeroOffset : offset.startsWith('-') ? labels.cues.negativeOffset : labels.cues.positiveOffset;
                return (
                  <td class={offsetClass} data-query-position={row.queryPosition} data-key-position={keyPositions[index]} data-relative-offset={offset} data-dot={value}>
                    <InlineMath latex={value} />
                    <small><InlineMath latex={'n-m=' + offset} /> · {cue}</small>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="shift-grid course-diagram__grid">
      <article data-diagram-card data-diagram-box class="shift-card original-shift course-diagram__card-stack" data-shift-grid="original">
        <h5>{labels.fields.originalGrid}</h5>
        <p>{labels.fields.originalPositions}: <InlineMath latex="[0,1,2]" /></p>
        <div class="shift-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={labels.scrollers.originalShift} data-diagram-scroll>
          <table data-diagram-table class="compact-matrix">
            <caption>{labels.fields.originalGrid}</caption>
            <thead><tr><th scope="col">{labels.fields.queryPosition} / {labels.fields.keyPosition}</th>{keyPositions.map((key) => <th scope="col"><InlineMath latex={'n=' + key} /></th>)}</tr></thead>
            <tbody>{beforeGrid.map((row, index) => <tr><th scope="row"><InlineMath latex={'m=' + trace.commonShift.beforePositions[index]} /></th>{row.map((value) => <td><InlineMath latex={value} /></td>)}</tr>)}</tbody>
          </table>
        </div>
      </article>
      <article data-diagram-card data-diagram-box class="shift-card shifted-shift course-diagram__card-stack" data-shift-grid="shifted">
        <h5>{labels.fields.shiftedGrid}</h5>
        <p>{labels.fields.shiftedPositions}: <InlineMath latex="[3,4,5]" /></p>
        <div class="shift-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={labels.scrollers.shiftedShift} data-diagram-scroll>
          <table data-diagram-table class="compact-matrix">
            <caption>{labels.fields.shiftedGrid}</caption>
            <thead><tr><th scope="col">{labels.fields.queryPosition} / {labels.fields.keyPosition}</th>{trace.commonShift.afterPositions.map((key) => <th scope="col"><InlineMath latex={'n=' + key} /></th>)}</tr></thead>
            <tbody>{afterGrid.map((row, index) => <tr><th scope="row"><InlineMath latex={'m=' + trace.commonShift.afterPositions[index]} /></th>{row.map((value) => <td><InlineMath latex={value} /></td>)}</tr>)}</tbody>
          </table>
        </div>
      </article>
      <article data-diagram-card data-diagram-box data-status={trace.commonShift.preserved === 'true' ? 'pass' : 'fail'} class="shift-card shift-check course-diagram__card-stack" data-common-shift={trace.commonShift.preserved}>
        <h5>{labels.fields.commonShiftCheck}</h5>
        <p class="status-line">{verified(trace.commonShift.preserved)}</p>
        <p><InlineMath latex={String.raw`\varepsilon=${trace.commonShift.tolerance}`} /></p>
      </article>
    </div>
  </section>

  <section class="diagram-section evidence-section course-diagram__card-stack" data-diagram-box aria-labelledby="rope-evidence-title">
    <h4 id="rope-evidence-title">{labels.sections.evidence}</h4>
    <p class="section-caption">{labels.captions.evidence}</p>
    <div class="evidence-grid course-diagram__grid">
      <article data-diagram-card data-diagram-box data-status={trace.norm.preserved === 'true' ? 'pass' : 'fail'} class="evidence-card norm-card course-diagram__card-stack" data-norm-preserved={trace.norm.preserved}>
        <h5>{labels.fields.norm}</h5>
        <dl>
          <div><dt>{labels.fields.beforeRotation}</dt><dd class="norm-value-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={`${labels.fields.norm}: ${labels.fields.beforeRotation}`} data-diagram-scroll><InlineMath latex={trace.norm.input.latex} /></dd></div>
          <div><dt>{labels.fields.afterRotation}</dt><dd class="norm-value-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={`${labels.fields.norm}: ${labels.fields.afterRotation}`} data-diagram-scroll><InlineMath latex={trace.norm.rotated.latex} /></dd></div>
          <div><dt>{labels.fields.shiftedPositions}</dt><dd class="norm-value-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={`${labels.fields.norm}: ${labels.fields.shiftedPositions}`} data-diagram-scroll><InlineMath latex={trace.norm.shifted.latex} /></dd></div>
        </dl>
        <p class="status-line">{verified(trace.norm.preserved)}</p>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card shape-card course-diagram__card-stack">
        <h5>{labels.fields.shape}</h5>
        <ul class="course-diagram__grid">
          {trace.shapes.map((record) => (
            <li data-diagram-card data-diagram-box data-status="pass" data-shape-case={record.tag}>
              <span>{shapeLabels[record.tag]}</span>
              <span><InlineMath latex={String.raw`${record.fields.input_shape}\to${record.fields.output_shape}`} /></span>
              <strong>{verified(record.fields.valid)}</strong>
            </li>
          ))}
        </ul>
      </article>

      <article data-diagram-card data-diagram-box class="evidence-card error-card course-diagram__card-stack">
        <h5>{labels.fields.errors}</h5>
        <ul class="course-diagram__grid">
          {trace.errors.map((error) => (
            <li data-diagram-card data-diagram-box data-state="rejected" data-error-case={error.case}>
              <span>{errorLabels[error.case]}</span>
              <code><bdi dir="ltr">{error.kind}</bdi></code>
              <strong>{verified(error.rejected)}</strong>
            </li>
          ))}
        </ul>
      </article>
    </div>

    <div class="gradient-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={labels.scrollers.gradients} data-diagram-scroll>
      <table data-diagram-table class="gradient-table">
        <caption>{labels.fields.reverseMode}</caption>
        <thead><tr><th scope="col">{labels.fields.tensor}</th><th scope="col">{labels.fields.outputAdjoint}</th><th scope="col">{labels.fields.inputAdjoint}</th></tr></thead>
        <tbody>
          <tr><th scope="row"><InlineMath latex="Q" /></th><td><InlineMath latex={tokenMatrix(trace.backward.querySeed)} /></td><td><InlineMath latex={tokenMatrix(trace.backward.queryGradient)} /></td></tr>
          <tr><th scope="row"><InlineMath latex="K" /></th><td><InlineMath latex={tokenMatrix(trace.backward.keySeed)} /></td><td><InlineMath latex={tokenMatrix(trace.backward.keyGradient)} /></td></tr>
        </tbody>
      </table>
    </div>
    <div data-diagram-card data-diagram-box data-status={trace.proof.gradcheck === 'true' ? 'pass' : 'fail'} class="proof-line" data-rope-proof>
      <strong>{labels.fields.gradientCheck}:</strong>
      <InlineMath latex={`${trace.proof.query_checks}+${trace.proof.key_checks}`} /> ·
      <InlineMath latex={String.raw`\varepsilon_g=${trace.proof.gradient_tolerance}`} /> ·
      {verified(trace.proof.gradcheck)}
    </div>
  </section>

  <section class="diagram-section history-section course-diagram__card-stack" data-diagram-box aria-labelledby="rope-history-title">
    <h4 id="rope-history-title">{labels.sections.history}</h4>
    <p class="section-caption">{labels.captions.history}</p>
    <div class="history-scroller course-diagram__scroll" tabindex="0" role="region" aria-label={labels.scrollers.history} data-diagram-scroll>
      <ol class="history-grid course-diagram__grid">
        {historyRows.map((row) => (
          <li>
            <article data-diagram-card data-diagram-box class:list={['history-card', 'course-diagram__card-stack', row.className]} data-history-kind={row.value}>
              <h5>{row.title}</h5>
              <p>{row.detail}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
    <div data-diagram-card data-diagram-box class="boundary-note course-diagram__card-stack" data-causal-boundary={trace.history.causal_boundary}>
      <strong>{labels.fields.causalBoundary}</strong>
      <p>{labels.historyDetails.causalBoundary}</p>
    </div>
  </section>
</figure>

<style>
  .diagram-description,
  .section-caption {
    max-inline-size: 76ch;
  }

  .formula-line,
  .rotation-table,
  .dot-table,
  .compact-matrix,
  .gradient-table,
  .norm-value-scroller {
    direction: ltr;
    unicode-bidi: isolate;
  }

  .rotation-table { inline-size: 100%; min-inline-size: 57rem; }
  .dot-table { inline-size: 100%; min-inline-size: 42rem; }
  .compact-matrix { inline-size: 100%; min-inline-size: 25rem; }
  .gradient-table { inline-size: 100%; min-inline-size: 67rem; }

  .rotation-table td small,
  .dot-table td small {
    display: block;
    margin-block-start: 0.25rem;
  }

  .slow-cue,
  .slow-pair :is(th, td),
  .negative-cue,
  .negative-offset,
  .shifted-shift,
  .earlier-stage,
  .transformer-stage {
    border-style: dashed;
  }

  .zero-cue,
  .zero-offset,
  .rotary-stage,
  .modern-stage {
    border-style: double;
    border-width: 3px;
  }

  .fast-pair :is(th, td),
  .positive-cue,
  .positive-offset {
    border-style: solid;
  }

  .shift-grid,
  .evidence-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    align-items: start;
  }

  .shift-card,
  .evidence-card,
  .history-card {
    align-self: start;
  }

  .shape-card ul,
  .error-card ul {
    gap: 0.5rem;
  }

  .shape-card li,
  .error-card li {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(10rem, 1.4fr) auto;
    align-items: start;
    gap: 0.5rem;
  }

  .history-grid {
    grid-template-columns: repeat(4, minmax(15rem, 1fr));
    min-inline-size: 64rem;
    align-items: start;
  }

  .status-line {
    font-weight: 750;
  }

  .rope-diagram:dir(rtl) :is(.rotation-table, .dot-table, .compact-matrix, .gradient-table) :is(caption, th, small) {
    direction: rtl;
    unicode-bidi: plaintext;
  }

  @container course-diagram (max-width: 40rem) {
    .shape-card li,
    .error-card li {
      grid-template-columns: 1fr;
    }
  }

  .rope-diagram:fullscreen {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .rope-diagram:fullscreen :is(figcaption, .rotation-section, .dot-section, .evidence-section, .history-section) {
    grid-column: 1 / -1;
  }
</style>
