---
import traceSource from '../../../../rust/demos/ch22-adamw/diagram-trace.txt?raw';
import InlineMath from '../InlineMath.astro';
import {
  adamwDiagramId,
  assertAdamwDiagramLabels,
  formatAdamwVectorLatex as vectorLatex,
  parseAdamwTrace,
  type AdamwDiagramLabels,
} from '../../lib/adamw-diagram';

interface Props {
  labels: AdamwDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'default' } = Astro.props;
assertAdamwDiagramLabels(labels);
if (!/^[a-z][a-z0-9-]*$/.test(instanceId)) {
  throw new Error('AdamW diagram instanceId must be a kebab-case identifier.');
}
const trace = parseAdamwTrace(traceSource);
const parameter = trace.parameters[0];
const titleId = `${adamwDiagramId}-${instanceId}-title`;
const descriptionId = `${adamwDiagramId}-${instanceId}-description`;
---

<figure
  class="course-diagram adamw-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={adamwDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description course-diagram__description">{labels.description}</p>
  </figcaption>

  <dl class="config-summary" aria-label={labels.stages.inputs}>
    <div data-diagram-box>
      <dt>{labels.summary.step}</dt>
      <dd><InlineMath latex={String.raw`t=${trace.meta.step}`} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.learningRate}</dt>
      <dd><InlineMath latex={String.raw`\eta=${trace.meta.learningRate}`} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.momentRates}</dt>
      <dd>
        <InlineMath latex={String.raw`\beta_1=${trace.meta.beta1}`} />
        <span aria-hidden="true"> · </span>
        <InlineMath latex={String.raw`\beta_2=${trace.meta.beta2}`} />
      </dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.stabilizer}</dt>
      <dd><InlineMath latex={String.raw`\varepsilon=${trace.meta.epsilon}`} /></dd>
    </div>
    <div data-diagram-box>
      <dt>{labels.summary.decay}</dt>
      <dd><InlineMath latex={String.raw`\lambda=${trace.meta.weightDecay}`} /></dd>
    </div>
  </dl>

  <section class="stage-intro course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-moments`}>
    <h4 id={`${titleId}-moments`} class="course-diagram__card-heading">
      <span class="state-symbol" aria-hidden="true">1</span>
      {labels.stages.moments}
    </h4>
    <p>{labels.notes.moments}</p>
    <p class="corrections">
      <InlineMath
        latex={String.raw`1-\beta_1^t=${trace.meta.firstCorrection}`}
      />
      <span aria-hidden="true"> · </span>
      <InlineMath
        latex={String.raw`1-\beta_2^t=${trace.meta.secondCorrection}`}
      />
    </p>
  </section>

  <div class="parameter-list course-diagram__grid">
    <article data-diagram-card data-diagram-box class="parameter-card course-diagram__card-stack" data-parameter-index={parameter.index}>
        <header data-diagram-card data-diagram-box>
          <div class="course-diagram__card-stack">
            <span class="parameter-label">{labels.fields.parameter}</span>
            <h5><bdi dir="ltr"><code>{parameter.name}</code></bdi></h5>
          </div>
          <dl>
            <div>
              <dt>{labels.fields.parameterGroup}</dt>
              <dd>
                <span
                  class:list={['group-badge', { 'no-decay': parameter.group === 'no_decay' }]}
                  data-parameter-group={parameter.group}
                  data-diagram-box
                >
                  {parameter.group === 'decay' ? labels.symbols.applyDecay : labels.symbols.skipDecay}
                </span>
                <bdi dir="ltr"><code>{parameter.group}</code></bdi>
              </dd>
            </div>
            <div>
              <dt>{labels.fields.shape}</dt>
              <dd><bdi dir="ltr"><code>{parameter.shape.lexeme}</code></bdi></dd>
            </div>
          </dl>
        </header>

        <div
          class="parameter-scroll course-diagram__scroll"
          role="region"
          tabindex="0"
          aria-label={`${labels.scrollers.parameterFlow} ${parameter.name}`}
         data-diagram-scroll>
          <div class="flow course-diagram__grid" aria-label={labels.captions.parameterFlow}>
            <section data-diagram-card data-diagram-box class="input-node" aria-label={labels.stages.inputs}>
              <dl>
                <div>
                  <dt>{labels.fields.before} <InlineMath latex={String.raw`\theta_{t-1}`} /></dt>
                  <dd><InlineMath latex={vectorLatex(parameter.before)} /></dd>
                </div>
                <div>
                  <dt>{labels.fields.gradient} <InlineMath latex={String.raw`g_t`} /></dt>
                  <dd><InlineMath latex={vectorLatex(parameter.gradient)} /></dd>
                </div>
              </dl>
            </section>

            <span class="flow-arrow adaptive-arrow input-to-moments" aria-hidden="true">→</span>

            <section data-diagram-card data-diagram-box class="moment-node" aria-label={labels.stages.moments}>
              <span class="lane-label">{labels.symbols.adaptive}</span>
              <dl>
                <div>
                  <dt>{labels.fields.firstMoment} <InlineMath latex={String.raw`m_t`} /></dt>
                  <dd><InlineMath latex={vectorLatex(parameter.first)} /></dd>
                </div>
                <div>
                  <dt>{labels.fields.secondMoment} <InlineMath latex={String.raw`v_t`} /></dt>
                  <dd><InlineMath latex={vectorLatex(parameter.second)} /></dd>
                </div>
                <div>
                  <dt>{labels.fields.correctedFirst} <InlineMath latex={String.raw`\hat m_t`} /></dt>
                  <dd><InlineMath latex={vectorLatex(parameter.correctedFirst)} /></dd>
                </div>
                <div>
                  <dt>{labels.fields.correctedSecond} <InlineMath latex={String.raw`\hat v_t`} /></dt>
                  <dd><InlineMath latex={vectorLatex(parameter.correctedSecond)} /></dd>
                </div>
              </dl>
            </section>

            <span class="flow-arrow adaptive-arrow moments-to-adaptive" aria-hidden="true">→</span>

            <section data-diagram-card data-diagram-box class="adaptive-delta" aria-label={labels.symbols.adaptive}>
              <span class="lane-label">{labels.symbols.adaptive}</span>
              <p>{labels.fields.adaptiveDelta}</p>
              <strong><InlineMath latex={vectorLatex(parameter.adaptive)} /></strong>
            </section>

            <section
              class="decay-bypass"
              data-decay-bypass="direct-from-parameter"
              aria-label={`${labels.symbols.decay}: ${parameter.group === 'decay' ? labels.symbols.applyDecay : labels.symbols.skipDecay}`}
            >
              <div data-diagram-card data-diagram-box class="bypass-origin">
                <span class="lane-label">
                  {labels.fields.before} <InlineMath latex={String.raw`\theta_{t-1}`} />
                </span>
                <InlineMath latex={vectorLatex(parameter.before)} />
              </div>
              <span class="bypass-arrow" aria-hidden="true">
                {parameter.group === 'decay' ? '┄┄┄→' : '┄┄┄×'}
              </span>
              <div
                class:list={[
                  'decay-delta',
                  'course-diagram__card-stack',
                  { skipped: parameter.group === 'no_decay' },
                ]}
                data-decay-action={parameter.group === 'decay' ? 'apply' : 'skip'}
                data-diagram-card
                data-diagram-box
              >
                <span class="lane-label">
                  {labels.symbols.decay} · {parameter.group === 'decay' ? labels.symbols.applyDecay : labels.symbols.skipDecay}
                </span>
                <p>{labels.fields.decayDelta}</p>
                <strong><InlineMath latex={vectorLatex(parameter.decay)} /></strong>
              </div>
            </section>

            <span class="flow-arrow merge-arrow" aria-label={labels.symbols.subtract}>−</span>

            <section data-diagram-card data-diagram-box class="output-node" aria-label={labels.stages.replacement}>
              <span class="lane-label">{labels.symbols.subtract}</span>
              <p>{labels.fields.after} <InlineMath latex={String.raw`\theta_t`} /></p>
              <strong><InlineMath latex={vectorLatex(parameter.after)} /></strong>
            </section>
          </div>
        </div>
    </article>
  </div>

  <section class="decay-note course-diagram__card-stack" data-diagram-box aria-labelledby={`${titleId}-decay`}>
    <h4 id={`${titleId}-decay`} class="course-diagram__card-heading">
      <span class="state-symbol" aria-hidden="true">2</span>
      {labels.stages.deltas}
    </h4>
    <p>{labels.notes.deltas}</p>
    <div class="bypass-formula" data-diagram-card data-diagram-box>
      <span>{labels.symbols.adaptive}</span>
      <InlineMath latex={String.raw`\eta\hat m_t/(\sqrt{\hat v_t}+\varepsilon)`} />
      <span class="plus" aria-label={labels.symbols.subtract}>−</span>
      <span>{labels.symbols.decay}</span>
      <InlineMath latex={String.raw`\eta\lambda\theta_{t-1}`} />
    </div>
  </section>

</figure>

<style>
  .config-summary {
    --diagram-summary-min: 8.5rem;
  }

  .corrections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 0.5rem;
  }

  .parameter-list {
    align-items: start;
  }

  .parameter-card {
    min-width: 0;
  }

  .parameter-card > header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .parameter-card > header dl {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 0.7rem 1rem;
  }

  .group-badge {
    display: inline-block;
    margin-inline-end: 0.35rem;
    padding: 0.12rem 0.4rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-weight: 800;
  }

  .group-badge.no-decay {
    border-style: dashed;
  }

  .parameter-scroll {
    --diagram-scroll-inline-size: 100%;
  }

  .flow {
    display: grid;
    grid-template-columns: minmax(13rem, 0.85fr) auto minmax(27rem, 1.35fr) auto minmax(16rem, 0.95fr) auto minmax(15rem, 0.85fr);
    align-items: center;
    inline-size: 78rem;
    min-inline-size: 78rem;
  }

  .input-node,
  .moment-node,
  .adaptive-delta,
  .output-node {
    align-self: start;
    min-width: 0;
  }

  .input-node {
    grid-column: 1;
    grid-row: 1;
  }

  .input-to-moments {
    grid-column: 2;
    grid-row: 1;
  }

  .moment-node {
    grid-column: 3;
    grid-row: 1;
  }

  .moments-to-adaptive {
    grid-column: 4;
    grid-row: 1;
  }

  .input-node dl,
  .moment-node dl {
    display: grid;
    gap: 0.65rem;
  }

  .moment-node dl {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .adaptive-delta {
    grid-column: 5;
    grid-row: 1;
  }

  .decay-bypass {
    grid-column: 1 / 6;
    grid-row: 2;
    display: grid;
    grid-template-columns: 13rem minmax(6rem, 1fr) 16rem;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    border-block-start: 2px dashed currentColor;
  }

  .bypass-origin,
  .decay-delta {
    border-style: dashed !important;
    border-width: 2px !important;
  }

  .bypass-origin {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .bypass-arrow {
    text-align: center;
  }

  .decay-delta.skipped {
    opacity: 0.78;
  }

  .flow-arrow {
    justify-self: center;
  }

  .merge-arrow {
    grid-column: 6;
    grid-row: 1 / 3;
    align-self: center;
  }

  .output-node {
    grid-column: 7;
    grid-row: 1 / 3;
    align-self: center;
  }

  .decay-note {
    border-style: dashed !important;
    border-width: 2px !important;
  }

  .bypass-formula {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
    margin-block-start: 0.75rem;
    border-style: dashed !important;
    border-width: 2px !important;
  }

  @container course-diagram (max-width: 52rem) {
    .config-summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container course-diagram (max-width: 32rem) {
    .config-summary {
      grid-template-columns: 1fr;
    }

    .parameter-card > header {
      display: grid;
    }

    .parameter-card > header dl {
      justify-content: start;
    }

    .flow {
      min-width: 78rem;
    }
  }

  @media (min-width: 64rem) and (min-height: 36rem) {
    .adamw-diagram:fullscreen {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
      grid-template-areas:
        'caption caption actions'
        'summary summary summary'
        'moments decay decay'
        'parameters parameters parameters';
      align-items: start;
    }

    .adamw-diagram:fullscreen > figcaption {
      grid-area: caption;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) auto;
      align-items: start;
      gap: var(--diagram-gap);
    }

    .adamw-diagram:fullscreen > :global(.diagram-full-view-actions) {
      grid-area: actions;
      align-self: start;
      justify-self: end;
    }

    .adamw-diagram:fullscreen > .config-summary {
      grid-area: summary;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .adamw-diagram:fullscreen > .stage-intro {
      grid-area: moments;
    }

    .adamw-diagram:fullscreen > .decay-note {
      grid-area: decay;
    }

    .adamw-diagram:fullscreen > .parameter-list {
      grid-area: parameters;
      grid-template-columns: minmax(0, 1fr);
    }

    .adamw-diagram:fullscreen .parameter-card > header > div,
    .adamw-diagram:fullscreen .parameter-card > header dl > div {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.5rem;
    }

    .adamw-diagram:fullscreen .flow {
      grid-template-columns:
        minmax(12.25rem, 0.8fr)
        auto
        minmax(23rem, 1.55fr)
        auto
        minmax(9.75rem, 0.9fr)
        auto
        minmax(9.25rem, 0.85fr);
      inline-size: 100%;
      min-inline-size: 0;
    }

    .adamw-diagram:fullscreen .decay-bypass {
      grid-template-columns: minmax(14rem, 0.9fr) minmax(5rem, 1fr) minmax(20rem, 1.25fr);
    }

  }

  :global([dir='rtl']) .flow-arrow {
    transform: scaleX(-1);
  }

  :global([dir='rtl']) .bypass-arrow {
    transform: scaleX(-1);
  }

</style>
