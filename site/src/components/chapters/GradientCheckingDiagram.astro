---
// @ts-ignore Node filesystem access is build-time only.
import { readFileSync } from 'node:fs';

import {
  assertGradientCheckingDiagramLabels,
  gradientCheckingDiagramId,
  parseGradientCheckingTrace,
  type GradientCheckingDiagramLabels,
} from '../../lib/gradient-checking-diagram';
import InlineMath from '../InlineMath.astro';

interface Props {
  labels: GradientCheckingDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'default' } = Astro.props;
assertGradientCheckingDiagramLabels(labels);
if (!/^[a-z][a-z0-9-]*$/.test(instanceId)) {
  throw new Error('Gradient-checking diagram instanceId must be a kebab-case identifier.');
}

const fixtureUrl = new URL(
  '../../../../rust/demos/ch13-gradient-checking/diagram-trace.txt',
  import.meta.url,
);
const trace = parseGradientCheckingTrace(readFileSync(fixtureUrl, 'utf8'));
const scanDisplay = [
  { step: '1', numerical: '5.75', scaledError: String.raw`1.74\times10^{-1}` },
  { step: String.raw`10^{-1}`, numerical: '4.76', scaledError: String.raw`2.10\times10^{-3}` },
  { step: String.raw`10^{-3}`, numerical: '4.750001', scaledError: String.raw`2.11\times10^{-7}` },
  { step: String.raw`10^{-5}`, numerical: '4.7500000001', scaledError: String.raw`2.10\times10^{-11}` },
  { step: String.raw`10^{-13}`, numerical: '4.751111', scaledError: String.raw`2.34\times10^{-4}` },
  { step: String.raw`10^{-15}`, numerical: '4.8', scaledError: String.raw`1.04\times10^{-2}` },
] as const;
const comparisonDisplay = [
  { analytic: '6', scaledError: '0' },
  { analytic: '5.5', scaledError: String.raw`8.33\times10^{-2}` },
] as const;
const coordinateDisplay = [
  String.raw`8.75\times10^{-12}`,
  String.raw`6.43\times10^{-12}`,
  String.raw`1.21\times10^{-11}`,
  String.raw`1.75\times10^{-11}`,
] as const;
const displayedScan = trace.stepScan.map((record, index) => ({ record, display: scanDisplay[index]! }));
const displayedComparisons = trace.comparisons.map((record, index) => ({ record, display: comparisonDisplay[index]! }));
const displayedCoordinates = trace.coordinates.map((record, index) => ({ record, display: coordinateDisplay[index]! }));
const titleId = `${gradientCheckingDiagramId}-${instanceId}-title`;
const descriptionId = `${gradientCheckingDiagramId}-${instanceId}-description`;
---

<figure
  class="course-diagram gradient-checking-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={gradientCheckingDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="diagram-description course-diagram__description">{labels.description}</p>
  </figcaption>

  <dl class="summary-grid">
    <div>
      <dt>
        <span
          data-diagram-display-label="summary-quadratic"
          data-diagram-accessible-label="summary-quadratic"
          role="group"
          aria-label={labels.summary.quadratic}
        >
          {labels.display.summaryQuadratic}
        </span>
      </dt>
      <dd><bdi dir="ltr">{trace.central.numerical.lexeme}</bdi></dd>
    </div>
    <div>
      <dt>{labels.summary.scanPoint}</dt>
      <dd><InlineMath latex={String.raw`\theta=${trace.config.point.lexeme}`} /></dd>
    </div>
    <div>
      <dt>{labels.summary.tensorLoss}</dt>
      <dd><bdi dir="ltr">{trace.tensor.loss.lexeme}</bdi></dd>
    </div>
  </dl>

  <section data-diagram-box class="quadratic-section" aria-labelledby={`${titleId}-quadratic`}>
    <h4 id={`${titleId}-quadratic`}>{labels.sections.quadratic}</h4>
    <dl
      data-diagram-card
      data-diagram-box
      data-state="trusted"
      data-requested-step={trace.central.requestedStep.lexeme}
      data-minus-point={trace.central.minusPoint.lexeme}
      data-center-point={trace.central.centerPoint.lexeme}
      data-plus-point={trace.central.plusPoint.lexeme}
      data-minus-spacing={trace.central.minusSpacing.lexeme}
      data-plus-spacing={trace.central.plusSpacing.lexeme}
      data-minus-value={trace.central.minusValue.lexeme}
      data-center-value={trace.central.centerValue.lexeme}
      data-plus-value={trace.central.plusValue.lexeme}
      data-left-slope={trace.central.leftSlope.lexeme}
      data-right-slope={trace.central.rightSlope.lexeme}
      data-left-weight={trace.central.leftWeight.lexeme}
      data-right-weight={trace.central.rightWeight.lexeme}
      data-stencil={trace.central.stencil}
      data-numerical={trace.central.numerical.lexeme}
      class="probe-card course-diagram__card-stack"
    >
      <div>
        <dt>{labels.fields.minusProbe}</dt>
        <dd><InlineMath latex="\theta_-=2.9" /></dd>
        <dd><InlineMath latex="q(\theta_-)=8.41" /></dd>
        <dt>{labels.fields.minusSpacing}</dt>
        <dd><bdi dir="ltr">{trace.central.minusSpacing.lexeme}</bdi></dd>
        <dt>{labels.fields.leftSlope}</dt>
        <dd><bdi dir="ltr">{trace.central.leftSlope.lexeme}</bdi></dd>
      </div>
      <div>
        <dt>{labels.fields.center}</dt>
        <dd><InlineMath latex="\theta=3,\;q(\theta)=9" /></dd>
        <dt>{labels.fields.requestedStep}</dt>
        <dd><bdi dir="ltr">{trace.central.requestedStep.lexeme}</bdi></dd>
        <dt>{labels.fields.stencil}</dt>
        <dd><code>{trace.central.stencil}</code></dd>
        <dd class="weight-pair">
          <InlineMath latex="w_-" /> <bdi dir="ltr">{trace.central.leftWeight.lexeme}</bdi>
          <InlineMath latex="w_+" /> <bdi dir="ltr">{trace.central.rightWeight.lexeme}</bdi>
        </dd>
        <dt>{labels.fields.numerical}</dt>
        <dd><bdi dir="ltr">{trace.central.numerical.lexeme}</bdi></dd>
      </div>
      <div>
        <dt>{labels.fields.plusProbe}</dt>
        <dd><InlineMath latex="\theta_+=3.1" /></dd>
        <dd><InlineMath latex="q(\theta_+)=9.61" /></dd>
        <dt>{labels.fields.plusSpacing}</dt>
        <dd><bdi dir="ltr">{trace.central.plusSpacing.lexeme}</bdi></dd>
        <dt>{labels.fields.rightSlope}</dt>
        <dd><bdi dir="ltr">{trace.central.rightSlope.lexeme}</bdi></dd>
      </div>
    </dl>
  </section>

  <section data-diagram-box class="scan-section" aria-labelledby={`${titleId}-scan`}>
    <h4 id={`${titleId}-scan`}>{labels.sections.scan}</h4>
    <ol class="scan-records evidence-list course-diagram__grid">
      {displayedScan.map(({ record, display }) => (
        <li
          data-diagram-card
          data-diagram-box
          data-step-index={record.index.lexeme}
          data-phase={record.phase}
          data-step={record.requestedStep.lexeme}
          data-status={record.status}
          data-minus-point={record.minusPoint.lexeme}
          data-center-point={record.centerPoint.lexeme}
          data-plus-point={record.plusPoint.lexeme}
          data-minus-spacing={record.minusSpacing.lexeme}
          data-plus-spacing={record.plusSpacing.lexeme}
          data-left-weight={record.leftWeight.lexeme}
          data-right-weight={record.rightWeight.lexeme}
          data-stencil={record.stencil}
          data-numerical={record.numerical.lexeme}
          data-scaled-error={record.scaledError.lexeme}
          class={`step-record course-diagram__card-stack phase-${record.phase} status-${record.status}`}
        >
          <div class="record-heading">
            <strong><InlineMath latex={String.raw`h=${display.step}`} /></strong>
            <span class="status-cue">
              <span class={`state-symbol status-${record.status}`} aria-hidden="true">{labels.symbols[record.status]}</span>
              <span>{labels.statuses[record.status]}</span>
            </span>
          </div>
          <dl class="record-values">
            <div>
              <dt>
                <span
                  data-diagram-display-label="numerical"
                  data-diagram-accessible-label="numerical"
                  role="group"
                  aria-label={labels.fields.numerical}
                >
                  {labels.display.numerical}
                </span>
              </dt>
              <dd><InlineMath latex={display.numerical} /></dd>
            </div>
            <div>
              <dt>
                <span
                  data-diagram-display-label="scaled-error"
                  data-diagram-accessible-label="scaled-error"
                  role="group"
                  aria-label={labels.fields.scaledError}
                >
                  {labels.display.scaledError}
                </span>
              </dt>
              <dd><InlineMath latex={display.scaledError} /></dd>
            </div>
            <div class="spacing-row">
              <dt>{labels.fields.minusSpacing} / {labels.fields.plusSpacing}</dt>
              <dd>
                <bdi dir="ltr">{record.minusSpacing.lexeme}</bdi>
                <bdi dir="ltr">{record.plusSpacing.lexeme}</bdi>
              </dd>
            </div>
            <div>
              <dt>{labels.fields.phase}</dt>
              <dd class="phase-cue">
                <span class={`state-symbol phase-${record.phase}`} aria-hidden="true">{labels.symbols[record.phase]}</span>
                <span>{labels.phases[record.phase]}</span>
              </dd>
            </div>
          </dl>
        </li>
      ))}
    </ol>
  </section>

  <section data-diagram-box class="candidate-section" aria-labelledby={`${titleId}-candidates`}>
    <h4 id={`${titleId}-candidates`}>{labels.sections.candidates}</h4>
    <p class="candidate-reference">
      <span>{labels.fields.numerical} <InlineMath latex="6" /></span>
      <span>{labels.fields.tolerance} <InlineMath latex="10^{-6}" /></span>
    </p>
    <ol class="candidate-records evidence-list course-diagram__grid">
      {displayedComparisons.map(({ record, display }) => (
        <li
          data-diagram-card
          data-diagram-box
          data-comparison-name={record.name}
          data-status={record.status}
          data-analytic={record.analytic.lexeme}
          data-numerical={record.numerical.lexeme}
          data-scaled-error={record.scaledError.lexeme}
          data-tolerance={record.tolerance.lexeme}
          class="course-diagram__card-stack"
        >
          <div class="record-heading">
            <span>
              <strong>
                <span
                  data-diagram-display-label="analytic"
                  data-diagram-accessible-label="analytic"
                  role="group"
                  aria-label={labels.fields.analytic}
                >
                  {labels.display.analytic}
                </span>
              </strong>
              <InlineMath latex={display.analytic} />
            </span>
            <span class="status-cue">
              <span class={`state-symbol status-${record.status}`} aria-hidden="true">{labels.symbols[record.status]}</span>
              <span>{labels.statuses[record.status]}</span>
            </span>
          </div>
          <dl class="record-values candidate-values">
            <div>
              <dt>
                <span
                  data-diagram-display-label="scaled-error"
                  data-diagram-accessible-label="scaled-error"
                  role="group"
                  aria-label={labels.fields.scaledError}
                >
                  {labels.display.scaledError}
                </span>
              </dt>
              <dd><InlineMath latex={display.scaledError} /></dd>
            </div>
          </dl>
        </li>
      ))}
    </ol>
  </section>

  <section data-diagram-box class="tensor-section" aria-labelledby={`${titleId}-tensor`}>
    <h4 id={`${titleId}-tensor`}>{labels.sections.tensor}</h4>
    <p>{labels.notes.tensor}</p>
    <p data-diagram-card data-diagram-box data-state="trusted" class="tensor-summary course-diagram__card-heading">
      <span>{labels.fields.restored}</span>
      <strong data-restored-exactly={trace.restoration.exactBits}>
        <span aria-hidden="true">{labels.symbols.pass}</span> {labels.statuses.restored}
      </strong>
    </p>
    <ol class="coordinate-records evidence-list course-diagram__grid">
      {displayedCoordinates.map(({ record, display }) => (
        <li
          data-diagram-card
          data-diagram-box
          data-sample-flat={record.flatIndex.lexeme}
          data-coordinate={record.coordinate.lexeme}
          data-status={record.status}
          data-requested-step={record.requestedStep.lexeme}
          data-minus-spacing={record.minusSpacing.lexeme}
          data-plus-spacing={record.plusSpacing.lexeme}
          data-stencil={record.stencil}
          data-analytic={record.analytic.lexeme}
          data-numerical={record.numerical.lexeme}
          data-scaled-error={record.scaledError.lexeme}
          class="course-diagram__card-stack"
        >
          <div class="record-heading">
            <strong>
              <InlineMath latex={String.raw`${record.flatIndex.lexeme}\to[${record.coordinate.indices.map(({ lexeme }) => lexeme).join(',')}]`} />
            </strong>
            <span class="state-symbol status-pass" aria-label={labels.statuses.pass}>{labels.symbols.pass}</span>
          </div>
          <dl class="record-values coordinate-values">
            <div>
              <dt>{labels.fields.analytic}</dt>
              <dd><bdi dir="ltr">{record.analytic.lexeme}</bdi></dd>
            </div>
            <div>
              <dt>{labels.fields.numerical}</dt>
              <dd><bdi dir="ltr">{record.numerical.lexeme}</bdi></dd>
            </div>
            <div>
              <dt>{labels.fields.scaledError}</dt>
              <dd><InlineMath latex={display} /></dd>
            </div>
          </dl>
        </li>
      ))}
    </ol>
  </section>

  <section data-diagram-box class="boundary-section" aria-labelledby={`${titleId}-boundaries`}>
    <h4 id={`${titleId}-boundaries`}>{labels.sections.boundaries}</h4>
    <p>{labels.notes.boundaries}</p>
    <div class="boundary-records evidence-list course-diagram__grid">
      <article
        data-diagram-card
        data-diagram-box
        data-boundary-case="rounded-linear"
        data-status={trace.roundedLinear.status}
        data-requested-step={trace.roundedLinear.requestedStep.lexeme}
        data-minus-spacing={trace.roundedLinear.minusSpacing.lexeme}
        data-plus-spacing={trace.roundedLinear.plusSpacing.lexeme}
        data-left-weight={trace.roundedLinear.leftWeight.lexeme}
        data-right-weight={trace.roundedLinear.rightWeight.lexeme}
        data-stencil={trace.roundedLinear.stencil}
        data-numerical={trace.roundedLinear.numerical.lexeme}
        class="boundary-card course-diagram__card-stack"
      >
        <div class="record-heading">
          <strong><InlineMath latex="f(x)=x,\;x=1" /></strong>
          <span class="status-cue">
            <span class="state-symbol status-pass" aria-hidden="true">{labels.symbols.pass}</span>
            <span>{labels.statuses.pass}</span>
          </span>
        </div>
        <dl class="record-values">
          <div><dt>{labels.fields.requestedStep}</dt><dd><bdi dir="ltr">{trace.roundedLinear.requestedStep.lexeme}</bdi></dd></div>
          <div><dt>{labels.fields.minusSpacing}</dt><dd><bdi dir="ltr">{trace.roundedLinear.minusSpacing.lexeme}</bdi></dd></div>
          <div><dt>{labels.fields.plusSpacing}</dt><dd><bdi dir="ltr">{trace.roundedLinear.plusSpacing.lexeme}</bdi></dd></div>
          <div><dt>{labels.fields.stencil}</dt><dd><code>{trace.roundedLinear.stencil}</code></dd></div>
          <div><dt>{labels.fields.numerical}</dt><dd><bdi dir="ltr">{trace.roundedLinear.numerical.lexeme}</bdi></dd></div>
        </dl>
      </article>

      <article
        data-diagram-card
        data-diagram-box
        data-boundary-case="absolute-kink"
        data-status="rejected"
        data-known-nondifferentiable={trace.kink.knownNondifferentiable}
        data-consistency={trace.kink.consistency}
        data-one-sided-scaled-gap={trace.kink.oneSidedScaledGap.lexeme}
        data-tolerance={trace.kink.tolerance.lexeme}
        data-requested-step={trace.kink.requestedStep.lexeme}
        data-left-slope={trace.kink.leftSlope.lexeme}
        data-right-slope={trace.kink.rightSlope.lexeme}
        data-numerical={trace.kink.numerical.lexeme}
        class="boundary-card course-diagram__card-stack"
      >
        <div class="record-heading">
          <strong><InlineMath latex="f(x)=|x|,\;x=0" /></strong>
          <span class="state-symbol status-rejected" aria-hidden="true">{labels.symbols.rejected}</span>
        </div>
        <dl class="record-values">
          <div><dt>{labels.fields.leftSlope}</dt><dd><bdi dir="ltr">{trace.kink.leftSlope.lexeme}</bdi></dd></div>
          <div><dt>{labels.fields.rightSlope}</dt><dd><bdi dir="ltr">{trace.kink.rightSlope.lexeme}</bdi></dd></div>
          <div><dt>{labels.fields.numerical}</dt><dd><bdi dir="ltr">{trace.kink.numerical.lexeme}</bdi></dd></div>
          <div><dt>{labels.fields.tolerance}</dt><dd><bdi dir="ltr">{trace.kink.tolerance.lexeme}</bdi></dd></div>
        </dl>
      </article>

      <article
        data-diagram-card
        data-diagram-box
        data-boundary-case="oracle-paths"
        data-analytic-path={trace.oracle.analyticPath}
        data-objective-path={trace.oracle.objectivePath}
        data-shared-primitives={trace.oracle.sharedPrimitives}
        data-material-course-path={trace.oracle.materialCoursePath}
        class="boundary-card oracle-card course-diagram__card-stack"
      >
        <p>{labels.notes.oracle}</p>
        <dl class="oracle-paths">
          <div data-oracle-route="analytic">
            <dt>{labels.fields.analytic}</dt>
            <dd><code>{trace.oracle.analyticPath}</code></dd>
          </div>
          <div data-oracle-route="objective">
            <dt><code>objective-path</code></dt>
            <dd><code>{trace.oracle.objectivePath}</code></dd>
          </div>
          <div data-oracle-route="shared">
            <dt><code>shared-primitives</code></dt>
            <dd><code>{trace.oracle.sharedPrimitives}</code></dd>
          </div>
        </dl>
      </article>
    </div>
  </section>

  <section data-diagram-box class="errors-section" aria-labelledby={`${titleId}-errors`}>
    <h4 id={`${titleId}-errors`}>{labels.sections.errors}</h4>
    <p>{labels.notes.errors}</p>
    <ol class="error-records evidence-list course-diagram__grid">
      {trace.errors.map((error) => (
        <li
          data-diagram-card
          data-diagram-box
          data-error-kind={error.kind}
          data-status="rejected"
          class="course-diagram__card-stack"
        >
          <div class="record-heading status-cue">
            <span class="state-symbol status-rejected" aria-hidden="true">{labels.symbols.rejected}</span>
            <strong>{labels.errors[error.kind]}</strong>
          </div>
          {error.kind === 'invalid-step' && (
            <p class="error-evidence" data-exact-step={error.step.lexeme}><InlineMath latex="h=0" /></p>
          )}
          {error.kind === 'collapsed-perturbation' && (
            <p
              class="error-evidence"
              data-exact-point={error.point.lexeme}
              data-exact-step={error.step.lexeme}
            >
              <span>{labels.sides.minus}</span>
              <InlineMath latex="\theta=1" />
              <InlineMath latex="h=10^{-20}" />
            </p>
          )}
          {error.kind === 'non-finite-evaluation' && (
            <p class="error-evidence" data-exact-value={error.value}>
              <span>{labels.sides.minus}</span>
              <InlineMath latex="f=\mathrm{NaN}" />
            </p>
          )}
          {error.kind === 'shape-mismatch' && (
            <p
              class="error-evidence"
              data-exact-parameter-shape={error.parameters.map(({ lexeme }) => lexeme).join(',')}
              data-exact-candidate-shape={error.analytic.map(({ lexeme }) => lexeme).join(',')}
            >
              <InlineMath latex="[2]\ne[1,2]" />
            </p>
          )}
        </li>
      ))}
    </ol>
  </section>
</figure>

<style>
  .gradient-checking-diagram { align-content: start; }

  .summary-grid,
  .probe-card,
  .oracle-paths {
    display: grid;
    align-items: start;
    gap: 0.7rem;
  }

  .summary-grid,
  .probe-card { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .probe-card > div,
  .oracle-paths > div { min-inline-size: 0; }

  .probe-card dt:not(:first-child) { margin-block-start: 0.55rem; }

  .evidence-list { align-items: stretch; }
  .scan-records { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .candidate-records,
  .error-records { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .coordinate-records { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .boundary-records { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .oracle-card { grid-column: 1 / -1; }

  .record-heading {
    display: flex;
    min-inline-size: 0;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
  }

  .record-values {
    display: grid;
    gap: 0.25rem;
    margin: 0;
  }

  .record-values > div {
    display: flex;
    min-inline-size: 0;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.15rem 0.45rem;
  }

  .record-values dd,
  .record-values dt,
  .oracle-paths dd,
  .oracle-paths dt { min-inline-size: 0; }

  .spacing-row dd,
  .weight-pair {
    display: flex;
    min-inline-size: 0;
    flex-wrap: wrap;
    gap: 0.2rem 0.55rem;
  }

  .candidate-reference {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .phase-cue,
  .status-cue {
    display: inline-flex;
    min-inline-size: 0;
    max-inline-size: 100%;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .phase-cue > span:last-child,
  .status-cue > span:last-child { min-inline-size: 0; }

  .step-record[data-phase='truncation'] .state-symbol.phase-truncation { --diagram-state-symbol-border-style: solid; }
  .step-record[data-phase='converging'] .state-symbol.phase-converging { --diagram-state-symbol-border-style: dashed; }
  .step-record[data-phase='trusted'] .state-symbol.phase-trusted { --diagram-state-symbol-border-style: double; }
  .step-record[data-phase='rounding'] .state-symbol.phase-rounding { --diagram-state-symbol-border-style: dotted; }
  [data-status='pass'] .state-symbol.status-pass { --diagram-state-symbol-border-style: double; }
  [data-status='fail'] .state-symbol.status-fail { --diagram-state-symbol-border-style: dashed; }
  [data-status='rejected'] .state-symbol.status-rejected { --diagram-state-symbol-border-style: dashed; }

  .tensor-summary {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
  }

  .error-evidence {
    display: flex;
    min-inline-size: 0;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
  }

  .oracle-paths { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .oracle-paths code,
  .boundary-card bdi,
  .probe-card bdi,
  .spacing-row bdi {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  @container course-diagram (max-width: 60rem) {
    .scan-records,
    .coordinate-records { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @container course-diagram (max-width: 47.5rem) {
    .summary-grid,
    .probe-card,
    .scan-records,
    .candidate-records,
    .coordinate-records,
    .boundary-records,
