---
// @ts-ignore Node filesystem access is used only while generating static HTML.
import { readFileSync } from 'node:fs';

import {
  assertTensorViewsDiagramLabels,
  parseTensorViewsTrace,
  tensorViewsDiagramId,
  type TensorViewTraceNumber,
  type TensorViewTraceRecord,
  type TensorViewsDiagramLabels,
} from '../../lib/tensor-views-diagram';

interface Props {
  labels: TensorViewsDiagramLabels;
  instanceId?: string;
}

const { labels, instanceId = 'tensor-views-diagram' } = Astro.props as Props;
assertTensorViewsDiagramLabels(labels);
const fixtureUrl = new URL(
  '../../../../rust/demos/ch09-tensor-views/diagram-trace.txt',
  import.meta.url,
);
const trace = parseTensorViewsTrace(readFileSync(fixtureUrl, 'utf8'));
const titleId = `${instanceId}-title`;
const descriptionId = `${instanceId}-description`;
const tuple = (values: readonly TensorViewTraceNumber[]) =>
  `[${values.map(({ lexeme }) => lexeme).join(',')}]`;
const operationLabel = (view: TensorViewTraceRecord) => {
  switch (view.id) {
    case 'base': return labels.operations.identity;
    case 'reshape': return labels.operations.reshape;
    case 'transpose': return labels.operations.transpose;
    case 'slice': return labels.operations.slice;
    case 'materialized': return labels.operations.materialized;
  }
};
const requestLabel = (view: TensorViewTraceRecord) => {
  if (view.id === 'reshape') return tuple(view.shape);
  if (view.axes) return tuple(view.axes);
  if (view.slice) {
    return `${view.slice.axis.lexeme}: ${view.slice.start.lexeme}..${view.slice.end.lexeme}`;
  }
  return null;
};
const stateLabel = (view: TensorViewTraceRecord) =>
  view.storage === 'base' ? labels.states.shared : labels.states.materialized;
const stateSymbol = (view: TensorViewTraceRecord) =>
  view.storage === 'base' ? '◇' : '◆';
const contiguousLabel = (view: TensorViewTraceRecord) =>
  view.contiguous ? labels.states.yes : labels.states.no;
const views = [
  trace.views.base,
  trace.views.reshape,
  trace.views.transpose,
  trace.views.slice,
  trace.views.materialized,
] as const;
const materializedProvenance = trace.views.materialized.sourceOffsets?.map(
  (sourceOffset, index) => ({
    sourceOffset,
    value: trace.views.materialized.values[index]!,
    copiedOffset: trace.views.materialized.offsets[index]!,
  }),
);
---

<figure
  class="course-diagram tensor-views-diagram"
  data-diagram-style="course-v1"
  data-visualization-id={tensorViewsDiagramId}
  tabindex="0"
  aria-labelledby={titleId}
  aria-describedby={descriptionId}
>
  <figcaption class="course-diagram__caption">
    <h3 id={titleId}>{labels.title}</h3>
    <p id={descriptionId} class="course-diagram__description">{labels.description}</p>
  </figcaption>

  <section class="views-panel" data-diagram-box aria-labelledby={`${instanceId}-views-title`}>
    <h4 id={`${instanceId}-views-title`}>{labels.sections.views}</h4>
    <p>{labels.notes.legend}</p>
    <div
      class="views-scroll course-diagram__scroll"
      role="region"
      tabindex="0"
      aria-label={labels.sections.views}
      data-diagram-scroll
    >
      <table class="views-table" data-diagram-table>
        <colgroup>
          <col class="operation-column" />
          <col class="storage-column" />
          <col class="shape-column" />
          <col class="strides-column" />
          <col class="base-column" />
          <col class="contiguous-column" />
          <col class="offsets-column" />
          <col class="values-column" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">{labels.fields.operation}</th>
            <th scope="col">{labels.fields.storage}</th>
            <th scope="col">{labels.fields.shape}</th>
            <th scope="col">{labels.fields.strides}</th>
            <th scope="col">{labels.fields.base}</th>
            <th scope="col">{labels.fields.contiguous}</th>
            <th scope="col">{labels.fields.offsets}</th>
            <th scope="col">{labels.fields.values}</th>
          </tr>
        </thead>
        <tbody>
          {views.map((view) => (
            <tr
              data-view-id={view.id}
              data-storage-id={view.storage}
              data-contiguous={view.contiguousLexeme}
            >
              <th scope="row">
                <span class="operation-content">
                  <span>{operationLabel(view)}</span>
                  {requestLabel(view) && <code dir="ltr">{requestLabel(view)}</code>}
                </span>
              </th>
              <td>
                <span class="storage-state">
                  <span class="state-symbol" aria-hidden="true">{stateSymbol(view)}</span>
                  <span class="visually-hidden">{stateLabel(view)}: </span>
                  <code dir="ltr">{view.storage}</code>
                </span>
              </td>
              <td><code dir="ltr">{tuple(view.shape)}</code></td>
              <td><code dir="ltr">{tuple(view.strides)}</code></td>
              <td><bdi dir="ltr">{view.baseOffset.lexeme}</bdi></td>
              <td>{contiguousLabel(view)}</td>
              <td><code class="trace-value" dir="ltr">{tuple(view.offsets)}</code></td>
              <td><code class="trace-value" dir="ltr">{tuple(view.values)}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="copy-panel" data-diagram-box aria-labelledby={`${instanceId}-copy-title`}>
    <h4 id={`${instanceId}-copy-title`}>{labels.sections.copy}</h4>
    <p>{labels.notes.copy}</p>
    <table class="copy-table" data-diagram-table>
      <thead>
        <tr>
          <th scope="col">{labels.fields.sourceOffsets}</th>
          <th scope="col">{labels.fields.values}</th>
          <th scope="col">{labels.fields.copiedOffset}</th>
        </tr>
      </thead>
      <tbody>
        {materializedProvenance?.map(({ sourceOffset, value, copiedOffset }) => (
          <tr data-source-offset={sourceOffset.lexeme} data-copied-offset={copiedOffset.lexeme}>
            <td><code dir="ltr">{sourceOffset.lexeme}</code></td>
            <td><code dir="ltr">{value.lexeme}</code></td>
            <td><code dir="ltr">{copiedOffset.lexeme}</code></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="errors-panel" data-diagram-box aria-labelledby={`${instanceId}-errors-title`}>
    <h4 id={`${instanceId}-errors-title`}>{labels.sections.errors}</h4>
    <p>{labels.notes.errors}</p>
    <div
      class="errors-scroll course-diagram__scroll"
      role="region"
      tabindex="0"
      aria-label={labels.sections.errors}
      data-diagram-scroll
    >
      <table class="errors-table" data-diagram-table>
        <colgroup>
          <col class="error-operation-column" />
          <col class="error-request-column" />
          <col class="error-evidence-column" />
          <col class="error-reason-column" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">{labels.fields.operation}</th>
            <th scope="col">{labels.fields.request}</th>
            <th scope="col">{labels.fields.evidence}</th>
            <th scope="col">{labels.fields.reason}</th>
          </tr>
        </thead>
        <tbody>
          <tr data-error-kind={trace.errors[0].kind}>
            <th scope="row"><span aria-hidden="true">× </span><span class="visually-hidden">{labels.states.rejected}: </span>{labels.operations.reshape}</th>
            <td><code dir="ltr">{tuple(trace.errors[0].requestedShape)}</code></td>
            <td>
              <span>{labels.fields.sourceElements}: <bdi dir="ltr">{trace.errors[0].sourceElements.lexeme}</bdi></span><br />
              <span>{labels.fields.requestedElements}: <bdi dir="ltr">{trace.errors[0].requestedElements.lexeme}</bdi></span>
            </td>
            <td>{labels.reasons.count}</td>
          </tr>
          <tr data-error-kind={trace.errors[1].kind}>
            <th scope="row"><span aria-hidden="true">× </span><span class="visually-hidden">{labels.states.rejected}: </span>{labels.operations.reshape}</th>
            <td><code dir="ltr">{tuple(trace.errors[1].requestedShape)}</code></td>
            <td>{labels.fields.contiguous}: {labels.states.no}</td>
            <td>{labels.reasons.contiguity}</td>
          </tr>
          <tr data-error-kind={trace.errors[2].kind}>
            <th scope="row"><span aria-hidden="true">× </span><span class="visually-hidden">{labels.states.rejected}: </span>{labels.operations.slice}</th>
            <td><code dir="ltr">{trace.errors[2].axis.lexeme}: {trace.errors[2].start.lexeme}..{trace.errors[2].end.lexeme}</code></td>
            <td>{labels.fields.axisSize}: <bdi dir="ltr">{trace.errors[2].size.lexeme}</bdi></td>
            <td>{labels.reasons.bounds}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</figure>

<style>
  .tensor-views-diagram { align-content: start; }

  .views-table {
    inline-size: 100%;
    min-inline-size: 78rem;
    table-layout: fixed;
  }

  .operation-column { inline-size: 16rem; }
  .storage-column { inline-size: 8rem; }
  .shape-column { inline-size: 5rem; }
  .strides-column { inline-size: 6rem; }
  .base-column { inline-size: 4rem; }
  .contiguous-column { inline-size: 8rem; }
  .offsets-column { inline-size: 12rem; }
  .values-column { inline-size: 19rem; }

  .views-table .operation-content {
    display: grid;
    min-inline-size: 0;
    gap: 0.25rem;
  }

  .storage-state {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .trace-value { white-space: nowrap; }

  .copy-table {
    inline-size: 100%;
    table-layout: fixed;
  }

  .errors-table {
    inline-size: 100%;
    min-inline-size: 46rem;
    table-layout: fixed;
  }

  .error-operation-column { inline-size: 8rem; }
  .error-request-column { inline-size: 7rem; }
  .error-evidence-column { inline-size: 14rem; }
  .error-reason-column { inline-size: 17rem; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 64rem) and (min-height: 36rem) {
    .tensor-views-diagram:fullscreen {
      --diagram-cell-padding-block: 0.35rem !important;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      align-content: start;
    }

    .tensor-views-diagram:fullscreen > figcaption,
    .tensor-views-diagram:fullscreen > .views-panel {
      grid-column: 1 / -1;
    }

    .tensor-views-diagram:fullscreen > .copy-panel { grid-column: 1 / 3; }
    .tensor-views-diagram:fullscreen > .errors-panel { grid-column: 3 / -1; }

    .tensor-views-diagram:fullscreen > :is(.views-panel, .errors-panel) {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      row-gap: 0.25rem;
    }

    .tensor-views-diagram:fullscreen
      > :is(.views-panel, .errors-panel)
      > :is(h4, p:first-of-type) {
      margin-block: 0;
    }

    .tensor-views-diagram:fullscreen .views-table .operation-content {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      column-gap: 0.4rem;
      row-gap: 0.25rem;
    }
  }
</style>
